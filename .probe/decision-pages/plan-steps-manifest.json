{
  "page": "plan-steps",
  "cards": [
    {
      "question": "How should a plan show its steps?",
      "why": "Crew first is the stack you asked for: who is working on which step shows first, without reading down the list, and it draws a line only to a step still waiting on another, where Lanes draws every one.",
      "options": [
        {
          "id": "one-list",
          "text": "1 One list Every step in order; click a step to open its description, and a step that waits says what it waits for. Cost: With several delegates at work it is the longest list, and you read who works on what row by row.",
          "recommended": false
        },
        {
          "id": "lanes",
          "text": "2 Lanes Steps that run at the same time sit side by side, with a line to each step that waits for them; the line to a working delegate pulses. Cost: On a phone two columns squeeze the words while most plans need one, and a step opens on a page of its own.",
          "recommended": false
        },
        {
          "id": "crew-first",
          "text": "Recommended 3 Crew first Who needs you and who is working come first, each with a progress line that pulses while it moves; the to-dos below show who is on each. Cost: A working delegate shows twice, at the top and on its to-do, and you change its step from the to-do, not from the top.",
          "recommended": true
        }
      ]
    }
  ],
