+    return false;
+  try {
+    return new URL(src, iframe.ownerDocument.baseURI).origin !== new URL(iframe.ownerDocument.URL).origin;
+  } catch {
+    return false;
+  }
+}
 function cloneIframe(iframe, context) {
+  // A frame of another origin is never reached into: WebKit reports the
