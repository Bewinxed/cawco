root = Decisions("The top bar's icon group", [gone, problem, newfiles, jump])
gone = Text("The numbers beside Files and the machines are gone, and so is the tinted machines symbol: Apple's toolbars put neither in a group of icons.", "body")
problem = Decision("problem", "How does a machine problem show on the machines symbol?", [badge, tint], "Recommended: A badge, because that's how Apple marks a thing with a problem in its own apps, like a drive with an exclamation mark, and all four symbols keep one colour. The phone doesn't change under either: its bar shows only Caw, and the sidebar's rows already say which machine is down.", [phoneviews])
phoneviews = Column([phonecaw, phonemachines])
badge = Option("badge", "A badge", "A small exclamation mark on the symbol's corner, red when a machine is down and amber when one needs you; the symbol stays grey.", true, [badgedown, badgesignin], "It's a small mark, so at a glance it's easier to miss than a whole coloured symbol.")
tint = Option("tint", "The symbol tinted, as today", "The whole machines symbol turns red when a machine is down and amber when one needs you.", false, [tintdown, tintsignin], "One symbol in the group changes colour, which Apple's toolbars avoid, and nothing but its colour says there's a problem.")
badgedown = Preview("70726f62-6c65-6d2d-6261-6467652d2d2d", "A badge · Desk, the Mac down", ["Down"])
badgesignin = Preview("70726f62-6c65-6d2d-6261-6467652d2d2d", "A badge · Desk, the Mac needing a sign-in", ["SignIn"])
tintdown = Preview("70726f62-6c65-6d2d-7469-6e742d2d2d2d", "The symbol tinted · Desk, the Mac down", ["Down"])
tintsignin = Preview("70726f62-6c65-6d2d-7469-6e742d2d2d2d", "The symbol tinted · Desk, the Mac needing a sign-in", ["SignIn"])
phonecaw = Preview("70726f62-6c65-6d2d-7068-6f6e652d2d2d", "The same under either · Phone, Caw alone on his tab", ["Caw"])
phonemachines = Preview("70726f62-6c65-6d2d-7068-6f6e652d2d2d", "The same under either · Phone, the sidebar's machines with the Mac down", ["Machines"])
newfiles = Decision("newfiles", "Does Files mark new files?", [nomark, dot], "Recommended: No mark, because the new files are already in the conversation in front of you, and a new file isn't something you have to act on.")
nomark = Option("none", "No mark", "The folder looks the same whether or not anything new has landed.", true, [nomarkview], "Nothing on the bar tells you a file arrived while you were looking elsewhere.")
dot = Option("dot", "A dot", "A small coral dot on the folder's corner until you open Files.", false, [dotview], "A mark that asks for a click when nothing needs doing, and one more thing lit in the group.")
nomarkview = Preview("66696c65-732d-6e6f-6e65-2d2d2d2d2d2d", "No mark · Desk, new files landed", ["NewFiles"])
dotview = Preview("66696c65-732d-646f-742d-2d2d2d2d2d2d", "A dot · Desk, new files landed", ["NewFiles"])
jump = Decision("jump", "How big is Jump's magnifying glass?", [same, small], "Recommended: The same size as the others, because an Apple toolbar draws every symbol in a group at one size, and today the magnifying glass is the one smaller symbol.")
same = Option("same", "The same size as the others", "The magnifying glass as large as the folder, the server and Caw.", true, [sameview], "Its lighter half covers more ground; if it reads heavy, the drawing changes, not the size.")
small = Option("small", "Smaller, as today", "The magnifying glass a step smaller than the symbols beside it.", false, [smallview], "One symbol in four at another size, so the group looks uneven.")
sameview = Preview("6a756d70-2d67-726f-7570-2d2d2d2d2d2d", "The same size · Desk", ["Desk"])
smallview = Preview("6a756d70-2d74-6f64-6179-2d2d2d2d2d2d", "Smaller, as today · Desk", ["Desk"])
