root = Decisions("The top bar's icon group", [counts, problem, newfiles, jump])
counts = Column([gone, cost, todayview])
gone = Text("The numbers beside Files and the machines go: Apple's toolbars show symbols without text beside them (\"Prefer simple, recognizable symbols for items instead of text\", HIG Toolbars).", "body")
cost = Text("You no longer see how many files or machines at a glance; each item's tooltip still says it.", "body")
todayview = Preview("6261722d-746f-6461-792d-2d2d2d2d2d2d", "Today · Desk, the bar as it stands, the Mac down", ["Desk"])
problem = Decision("problem", "How does a machine problem show on the machines symbol?", [badge, tint], "Recommended: A badge, because that's how Apple marks a thing with a problem in its own apps, like a drive with a cross or an exclamation mark, and no symbol changes colour for a problem: the badge's shape says what's wrong, its colour backs it up.", [phone])
phone = Text("On a phone the bar holds Caw alone; a machine's trouble shows in the sidebar's machine rows, the same under either option.", "body")
badge = Option("badge", "A badge", "A small badge on the symbol's corner: a red cross when a machine is down, an amber exclamation mark when one needs you; the symbol stays grey.", true, [badgedown, badgesignin], "It's a small mark, so at a glance it's easier to miss than a whole coloured symbol.")
tint = Option("tint", "The symbol tinted", "The whole machines symbol turns red when a machine is down and amber when one needs you.", false, [tintdown, tintsignin], "One symbol in the group changes colour, which Apple's toolbars avoid, and only its colour tells down from needing you.")
badgedown = Preview("70726f62-6c65-6d2d-6261-6467652d2d2d", "A badge · Desk, the Mac down", ["Down"])
badgesignin = Preview("70726f62-6c65-6d2d-6261-6467652d2d2d", "A badge · Desk, the Mac needing a sign-in", ["SignIn"])
tintdown = Preview("70726f62-6c65-6d2d-7469-6e742d2d2d2d", "The symbol tinted · Desk, the Mac down", ["Down"])
tintsignin = Preview("70726f62-6c65-6d2d-7469-6e742d2d2d2d", "The symbol tinted · Desk, the Mac needing a sign-in", ["SignIn"])
newfiles = Decision("newfiles", "Does Files mark new files?", [nomark, dot], "Recommended: No mark, because the new files are already in the conversation in front of you, and a new file isn't something you have to act on.")
nomark = Option("none", "No mark", "The folder looks the same whether or not anything new has landed.", true, [nomarkview], "Nothing on the bar tells you a file arrived while you were looking elsewhere.")
dot = Option("dot", "A dot", "A small coral dot on the folder's corner until you open Files.", false, [dotview], "A mark that asks for a click when nothing needs doing, and one more thing lit in the group.")
nomarkview = Preview("66696c65-732d-6e6f-6e65-2d2d2d2d2d2d", "No mark · Desk, new files landed", ["NewFiles"])
dotview = Preview("66696c65-732d-646f-742d-2d2d2d2d2d2d", "A dot · Desk, new files landed", ["NewFiles"])
jump = Decision("jump", "How big is the search glyph?", [same, small], "Recommended: The same size as the others, because an Apple toolbar draws every symbol in a group at one size, and today the search glyph is the one smaller symbol.")
same = Option("same", "The same size as the others", "The search glyph as large as the folder, the server and Caw, drawn in their style: a light lens with a bright glint and handle, as the server carries its marks.", true, [sameview], "The lens is redrawn with a full-ink glint so it holds its weight at 20px; it becomes the search glyph everywhere in the app.")
small = Option("small", "16px, the size today", "The search glyph a step smaller than the symbols beside it.", false, [smallview], "One symbol in four at another size, so the group looks uneven.")
sameview = Preview("6a756d70-2d67-726f-7570-2d2d2d2d2d2d", "The same size · Desk", ["Desk"])
smallview = Preview("6a756d70-2d74-6f64-6179-2d2d2d2d2d2d", "16px, the size today · Desk", ["Desk"])
