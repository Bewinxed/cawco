root = Decisions("Pick how transcript chips show what they link to", [chip])
chip = Decision("chip-kind", "How should a chip show what it links to?", [glyph, word], "Read at a glance across every kind, the word tells 14 of the 17 kinds apart and the glyph only 5; it decides how every link to a task, to-do, plan, session, pin, card, artifact or workflow reads in a transcript.")
glyph = Option("glyph", "A glyph and a status dot", "A small mark and a coloured dot before each name; at a glance it tells 5 of 17 kinds apart (pin, machine, session, project, run), and a five-chip sentence still reads as prose in four lines on a phone.", false, [glyphPreview], "The other kinds are small grey marks that blur together, the task and routine marks almost vanish in the dark, and the dot shows state by colour alone.")
word = Option("word", "The kind as a word", "The kind written before each name; at a glance it tells 14 of 17 kinds apart, and a five-chip sentence takes five lines on a phone.", true, [wordPreview], "Idle, pending and online chips have no fill, so state is invisible at rest for most kinds, and to-do, card and routine share one colour.")
glyphPreview = Preview("d1be4f3b-abbf-47ac-a871-8ea75ad48f1b", null, ["EveryKind", "SentenceDesk", "SentencePhone"], 1440)
wordPreview = Preview("6dda81a6-1542-4793-8c9d-34ea771572bb", null, ["EveryKind", "SentenceDesk", "SentencePhone"], 1440)
