root = Decisions("Caw's panel", [fixed, panel, trouble, empty])
fixed = Text("Already fixed from your pins, nothing to pick: Open the board is gone, since each task opens itself, and the line beside Caw's name shows only when something waits on you.", "body")
panel = Section("The panel", [head, resize])
trouble = Section("When Caw can't", [blocked, notwoken])
empty = Section("What Caw shows you", [suggest, filed])
head = Decision("head", "What does the top of Caw's panel show?", [headwho, headname], "A thread's name is your first message, so the top names the thread only once that message is out of view. Back in a thread a few messages on, as here, that line is the only thing that says which thread you're in.", [headwhoviews, headnameviews])
headwhoviews = Column([headwhodesk, headwhophone])
headwhodesk = Preview("33e17d68-3296-47d1-8c1c-3e0d282054d8", "Caw over his thread · Desk", ["DeskHead"])
headwhophone = Preview("33e17d68-3296-47d1-8c1c-3e0d282054d8", "Caw over his thread · Phone", ["PhoneHead"])
headnameviews = Column([headnamedesk, headnamephone])
headnamedesk = Preview("3f08b50a-76b4-4979-9390-42e0aacc1ecf", "Caw alone · Desk", ["DeskHead"])
headnamephone = Preview("3f08b50a-76b4-4979-9390-42e0aacc1ecf", "Caw alone · Phone", ["PhoneHead"])
headwho = Option("who", "Caw over his thread", "Caw's name, and under it the thread's name once your first message is out of view; press it to switch threads.", true, [], "The line under his name comes and goes as you scroll to the top and back.")
headname = Option("name", "Caw alone", "Only Caw's name; to know the thread, scroll up to your first message.", false, [], "A few messages in, nothing on screen says which thread you're in.")
resize = Decision("resize", "How do you make Caw's panel bigger on a desk?", [resizeedges, resizecorner, resizemenu], "The sidebar already gets wider when you drag its edge, so the panel works the same way as the page around it. Whichever you pick, the panel reopens at the size you left it.", [resizeedgesview, resizecornerview, resizemenuview, resizewideview], ["head"])
resizeedgesview = Preview("61aff839-ed5e-4cdf-8447-a399b9b8edc8", "Drag its edges · Desk, the pointer on the left edge", ["Pointing"])
resizecornerview = Preview("56cd56c4-34ab-4fe4-9ead-f561a947d2c5", "A corner grip · Desk", ["Grip"])
resizemenuview = Preview("870d9878-9675-4e77-8af4-e74e0ff48b06", "Wide panel in More · Desk, More open", ["MenuOpen"])
resizewideview = Preview("870d9878-9675-4e77-8af4-e74e0ff48b06", "Wide panel in More · Desk, after Wide panel: 560 wide, the size it reopens at; scrolls sideways on a phone", ["Wide"])
resizeedges = Option("edges", "Drag its edges", "Drag the left edge, the bottom edge or the corner between them; the edge lights up under your pointer.", true, [], "Nothing shows that it resizes until your pointer finds the edge.")
resizecorner = Option("corner", "A corner grip", "A small L outside the panel's bottom-left corner, always there, that you drag.", false, [], "A mark beside the panel all the time.")
resizemenu = Option("menu", "Wide panel in More", "A Wide panel switch in the More menu: normal or wide.", false, [], "Two widths only, and the height never changes.")
blocked = Decision("blocked", "When Caw can't do what you asked, how do the words sit under him?", [blockededge, blockedstack], "Both keep Caw front and centre, as you asked. Everywhere else in the app a line starts on its left edge, and a centred reason of two or three lines reads ragged on both sides.", [blockededgeview, blockedstackview])
blockededgeview = Preview("52e4e7e5-846a-4729-84e7-85637a738128", "Words on one edge · Phone, Show details open", ["PhoneDetails"])
blockedstackview = Preview("6750896d-df5a-4846-bb8d-a75c5f42a8b1", "Everything centred · Phone, Show details open", ["PhoneDetails"])
blockededge = Option("edge", "Words on one edge", "Caw centred, the words and buttons starting on one edge under him.", true, [], "Caw and the words don't share a centre line, so a short title leaves space after it.")
blockedstack = Option("stack", "Everything centred", "Caw, every line and both buttons centred under him.", false, [], "A long reason reads ragged on both sides.")
notwoken = Decision("notwoken", "When your message didn't wake Caw, where does the thread say so?", [notwokenunder, notwokencaw], "Everywhere else in the app, a row that failed says so on that row, so the note sits on the message it's about.", [notwokenunderview, notwokencawview], ["blocked"])
notwokenunderview = Preview("d3b984b8-4781-44ba-8946-aecb574adec8", "Under your message · Desk", ["DeskTop"])
notwokencawview = Preview("cacf6b1b-9f55-4dc5-b1b3-881b8a4eeb46", "A row from Caw · Desk", ["DeskTop"])
notwokenunder = Option("under", "Under your message", "A line under your message saying why Caw didn't read it, with Try again and Show details.", true, [], "It reads as being about your message, not about Caw.")
notwokencaw = Option("caw", "A row from Caw", "The same line and buttons as a row of their own, under Caw's name.", false, [], "It looks as if Caw said it, though he never woke.")
suggest = Decision("suggest", "How do the things you can ask Caw sit on an empty thread?", [suggestrows, suggestchips], "Each suggestion comes as a full sentence with the reason it's offered. Rows show both; short labels show neither, and Caw would have to start writing the labels.", [suggestrowsview, suggestchipsview])
suggestrowsview = Preview("8c5a2f65-6841-4b4c-9528-01f0d28efc30", "Rows as wide as words · Phone", ["PhoneNarrow"])
suggestchipsview = Preview("a52dce62-26be-4ec3-9a01-f487e36d2b66", "Short labels · Phone", ["PhoneNarrow"])
suggestrows = Option("rows", "Rows as wide as words", "Each suggestion a row only as wide as its words, its reason under it.", true, [], "Four rows take more height than labels, and a long sentence wraps.")
suggestchips = Option("chips", "Short labels", "Each suggestion cut to a few words, side by side; the full sentence shows on hover.", false, [], "The reason behind each one isn't shown.")
filed = Decision("filed", "How do the tasks Caw filed show under his reply?", [filedrows, filedcards], "Each task shows its title, what it holds and why Caw filed it. As one list the tasks read as part of his reply; as cards, the same three run about a quarter taller and stand apart from it.", [filedrowsview, filedcardsview])
filedrowsview = Preview("52327db9-598b-4f8d-8aac-e0e934bb33b1", "One list · Phone", ["PhoneNarrow"])
filedcardsview = Preview("7c9085ce-4c22-4280-a5ea-bbbdd8801e54", "Cards · Phone", ["PhoneNarrow"])
filedrows = Option("rows", "One list", "One list under his reply, a line between tasks, appearing one after another.", true, [], "The tasks are less set apart than cards.")
filedcards = Option("cards", "Cards", "Each task on its own raised card, appearing one after another.", false, [], "Three tasks run about a quarter taller than as a list.")
