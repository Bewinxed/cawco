root = Decisions("Caw's panel", [panel, trouble, empty, pins])
panel = Section("The panel", [head, resize])
trouble = Section("When Caw can't", [blocked, notwoken])
empty = Section("What Caw shows you", [suggest, filed])
head = Decision("head", "What does the top of Caw's panel show?", [headwho, headname], "You asked twice what the top of the panel was for. This one says whose panel it is and which thread you're in, and you switch threads where the thread's name already is.", [headwhoview, headnameview])
headwho = Option("who", "Caw over his thread", "Caw's name, and under it the thread you're in; press the thread's name to switch threads.", true, [], "A long thread name is cut to one line here; it shows whole in the switcher.")
headwhoview = Preview("33e17d68-3296-47d1-8c1c-3e0d282054d8", "Caw over his thread", ["Desk", "DeskWaiting", "Phone"])
headname = Option("name", "Caw alone", "Only Caw's name at the top of the panel; the thread's name is the conversation's first row, shown whole.", false, [], "Switching threads moves into More, and the thread's name scrolls away with the conversation.")
headnameview = Preview("3f08b50a-76b4-4979-9390-42e0aacc1ecf", "Caw alone", ["Desk", "DeskWaiting", "Phone"])
resize = Decision("resize", "How do you make Caw's panel bigger on a desk?", [resizeedges, resizecorner, resizemenu], "The sidebar already gets wider when you drag its edge, so the panel works the same way as the page around it.", [resizeedgesview, resizecornerview, resizemenuview], ["head"])
resizeedges = Option("edges", "Drag its edges", "Drag the panel's left edge, its bottom edge or the corner where they meet, the way you drag the sidebar wider. Nothing shows until your pointer is on it.", true, [], "Nothing tells you it resizes until your pointer finds the edge.")
resizeedgesview = Preview("61aff839-ed5e-4cdf-8447-a399b9b8edc8", "Drag its edges", ["Desk"])
resizecorner = Option("corner", "A corner grip", "A small L at the panel's bottom-left corner, always shown, that you drag.", false, [], "It's a mark on the page beside the panel, there all the time.")
resizecornerview = Preview("56cd56c4-34ab-4fe4-9ead-f561a947d2c5", "A corner grip", ["Desk"])
resizemenu = Option("menu", "Wide panel, in More", "A Wide panel switch in the More menu at the top of the panel: normal or wide.", false, [], "Only two widths, and the height never changes.")
resizemenuview = Preview("870d9878-9675-4e77-8af4-e74e0ff48b06", "Wide panel, in More", ["Desk"])
blocked = Decision("blocked", "When Caw can't do what you asked, how does he stand in the middle of the panel?", [blockedstack, blockededge, blockedbeside], "You asked for Caw front and centre, and earlier pins asked to stop centring the words. This is the only option that does both.", [blockedstackview, blockededgeview, blockedbesideview])
blockedstack = Option("stack", "Everything centred", "Caw above the words, with every line and both buttons centred under him.", false, [], "Every line is centred, and a long reason reads ragged on both sides.")
blockedstackview = Preview("6750896d-df5a-4846-bb8d-a75c5f42a8b1", "Everything centred", ["CantRead", "CantStart", "PhoneCantRead"])
blockededge = Option("edge", "Caw centred, words on one edge", "Caw centred in the panel, with the words and buttons lined up on one edge under him.", true, [], "Caw and the words' edge don't line up, so a short title leaves space after it.")
blockededgeview = Preview("52e4e7e5-846a-4729-84e7-85637a738128", "Caw centred, words on one edge", ["CantRead", "CantStart", "PhoneCantRead"])
blockedbeside = Option("beside", "Caw beside the words", "Caw on the left with his words beside him, everything on one edge.", false, [], "Caw is no longer front and centre, and on a phone the words get about two-thirds of the width.")
blockedbesideview = Preview("e72b79f0-8685-4592-bc4c-ce4a0854f75d", "Caw beside the words", ["CantRead", "CantStart", "PhoneCantRead"])
notwoken = Decision("notwoken", "When your message didn't wake Caw, where does the thread say so?", [notwokenunder, notwokencaw], "Everywhere else in the app, a row that failed says what went wrong on that row, so the note sits on the message it's about.", [notwokenunderview, notwokencawview], ["blocked"])
notwokenunder = Option("under", "Under your message", "A line under your message saying why Caw didn't read it, with Try again and Show details.", true, [], "It reads as being about your message, not about Caw.")
notwokenunderview = Preview("d3b984b8-4781-44ba-8946-aecb574adec8", "Under your message", ["Desk", "Phone"])
notwokencaw = Option("caw", "As a row from Caw", "The same line and buttons as a row of their own under Caw's name, after your message.", false, [], "It looks as if Caw said it, though he never woke.")
notwokencawview = Preview("cacf6b1b-9f55-4dc5-b1b3-881b8a4eeb46", "As a row from Caw", ["Desk", "Phone"])
suggest = Decision("suggest", "How do the things you can ask Caw sit on an empty thread?", [suggestrows, suggestchips], "The hub already writes each suggestion's full sentence and why it's offered. It writes no short label, which the other option needs before it can be built.", [suggestrowsview, suggestchipsview])
suggestrows = Option("rows", "Rows as wide as their words", "Each suggestion is a row only as wide as its words, with its reason under it, one under another.", true, [], "A list of four takes more height than short labels, and a long sentence wraps to two lines.")
suggestrowsview = Preview("8c5a2f65-6841-4b4c-9528-01f0d28efc30", "Rows as wide as their words", ["Desk", "Phone"])
suggestchips = Option("chips", "Short labels side by side", "Each suggestion cut to a few words, side by side, wrapping like words; the full sentence shows on hover.", false, [], "The hub doesn't write short labels yet, and the reason behind each suggestion isn't shown.")
suggestchipsview = Preview("a52dce62-26be-4ec3-9a01-f487e36d2b66", "Short labels side by side", ["Desk", "Phone"])
filed = Decision("filed", "How do the tasks Caw filed show under his reply?", [filedrows, filedcards], "Five long tasks fit as one list in the 380px panel; as cards they stack into a column taller than his reply. The line under each title is the task's own description. Why Caw filed each one isn't stored anywhere yet, so building this adds a reason Caw writes for each task as he files it.", [filedrowsview, filedcardsview])
filedrows = Option("rows", "One list", "One list under his reply: each task's title, what it holds and why he filed it. They appear one after another.", true, [], "The tasks are less separated than cards, so they read as part of his reply.")
filedrowsview = Preview("52327db9-598b-4f8d-8aac-e0e934bb33b1", "One list", ["Desk", "Phone"])
filedcards = Option("cards", "Cards", "Each task on its own raised card with the same three lines, appearing one after another.", false, [], "In a 380px panel the cards stack into a tall column that outweighs his reply.")
filedcardsview = Preview("7c9085ce-4c22-4280-a5ea-bbbdd8801e54", "Cards", ["Desk", "Phone"])
pins = Decision("pins", "Fixed from your pins: does it look right now?", [pinsright, pinsnot], "\"this button seems misplaced and out of context?\" Open the board is gone: each task opens itself. \"/useless-copy\" on \"Awake · resting\": the head shows nothing next to Caw's name when nothing waits on you, and the fact when something does.", [pinsview])
pinsview = Preview("1340cb12-10ef-4b4b-ad3a-01799d179f0f", "Desk", ["Desk", "DeskBudget"])
pinsright = Option("looks-right", "Looks right", "Under his tasks there's no Open the board, and next to his name a line shows only when something waits on you.", true, [], "These two stay as drawn.")
pinsnot = Option("not-yet", "Not yet", "Pin what still reads wrong on the panel.", false, [], "These two aren't built until your pins are answered.")
