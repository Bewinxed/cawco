root = Decisions("Caw's panel", [panel, trouble, empty, pins])
panel = Section("The panel", [head, resize])
trouble = Section("When Caw can't", [blocked, notwoken])
empty = Section("What Caw shows you", [suggest, filed])
head = Decision("head", "What does the top of Caw's panel show?", [headwho, headname], "It says whose panel and which thread in one glance, and the thread switcher sits where the thread's name already is.")
headwho = Option("who", "Caw over his thread", "Caw's name, and under it the thread you're in; press the thread's name to switch threads.", true, [headwhoview], "A long thread name is cut to one line here; it shows whole in the switcher.")
headwhoview = Preview("33e17d68-3296-47d1-8c1c-3e0d282054d8", "Desk and phone")
headname = Option("name", "Caw alone", "Only Caw's name in the head; the thread's name is the conversation's first row, shown whole.", false, [headnameview], "Switching threads moves into More, and the thread's name scrolls away with the conversation.")
headnameview = Preview("3f08b50a-76b4-4979-9390-42e0aacc1ecf", "Desk and phone")
resize = Decision("resize", "How do you make Caw's panel bigger on a desk?", [resizeedges, resizecorner, resizemenu], "The rail already resizes by dragging its edge, so the panel works the same way as the page around it.", [], ["head"])
resizeedges = Option("edges", "Drag its edges", "Drag the panel's free edge, its foot or the corner where they meet, with the same grip as the rail. Nothing shows until your pointer is on it.", true, [resizeedgesview], "Nothing tells you it resizes until your pointer finds the edge.")
resizeedgesview = Preview("61aff839-ed5e-4cdf-8447-a399b9b8edc8", "Desk")
resizecorner = Option("corner", "A corner grip", "A small L at the panel's free corner, always shown, that you drag.", false, [resizecornerview], "It's a mark on the page beside the panel, there all the time.")
resizecornerview = Preview("56cd56c4-34ab-4fe4-9ead-f561a947d2c5", "Desk")
resizemenu = Option("menu", "Wide panel, in More", "A Wide panel switch in the head's More menu: normal or wide.", false, [resizemenuview], "Only two widths, and the height never changes.")
resizemenuview = Preview("870d9878-9675-4e77-8af4-e74e0ff48b06", "Desk")
blocked = Decision("blocked", "When Caw can't do what you asked, how does he stand in the middle of the panel?", [blockedstack, blockededge, blockedbeside], "Caw stays front and centre without centring the words, and the thread that won't open and the Caw who can't start both use it.")
blockedstack = Option("stack", "Everything centred", "Caw above the words, with every line and both buttons centred under him.", false, [blockedstackview], "Every line is centred, and a long reason reads ragged on both sides.")
blockedstackview = Preview("6750896d-df5a-4846-bb8d-a75c5f42a8b1", "Desk and phone")
blockededge = Option("edge", "Caw centred, words on one edge", "Caw centred in the panel, with the words and buttons lined up on one edge under him.", true, [blockededgeview], "Caw and the words' edge don't line up, so a short title leaves space after it.")
blockededgeview = Preview("52e4e7e5-846a-4729-84e7-85637a738128", "Desk and phone")
blockedbeside = Option("beside", "Caw beside the words", "Caw on the left with his words beside him, everything on one edge.", false, [blockedbesideview], "Caw is no longer front and centre, and on a phone the words get about two-thirds of the width.")
blockedbesideview = Preview("e72b79f0-8685-4592-bc4c-ce4a0854f75d", "Desk and phone")
notwoken = Decision("notwoken", "When your message didn't wake Caw, where does the thread say so?", [notwokenunder, notwokencaw], "The note sits on the message it's about, the same way every other failed row in the app shows its error.", [], ["blocked"])
notwokenunder = Option("under", "Under your message", "A line under your message saying why Caw didn't read it, with Try again and Show details.", true, [notwokenunderview], "It reads as being about your message, not about Caw.")
notwokenunderview = Preview("d3b984b8-4781-44ba-8946-aecb574adec8", "Desk and phone")
notwokencaw = Option("caw", "As a row from Caw", "The same line and buttons as a row of their own under Caw's name, after your message.", false, [notwokencawview], "It looks as if Caw said it, though he never woke.")
notwokencawview = Preview("cacf6b1b-9f55-4dc5-b1b3-881b8a4eeb46", "Desk and phone")
suggest = Decision("suggest", "How do the things you can ask Caw sit on an empty thread?", [suggestrows, suggestchips], "Rows use the hub's own sentence and its reason, and need nothing new from the hub.")
suggestrows = Option("rows", "Rows as wide as their words", "Each suggestion is a row only as wide as its words, with its reason under it, one under another.", true, [suggestrowsview], "A list of four takes more height than chips, and a long sentence wraps to two lines.")
suggestrowsview = Preview("8c5a2f65-6841-4b4c-9528-01f0d28efc30", "Desk and phone")
suggestchips = Option("chips", "Chips that wrap", "Short labels side by side that wrap like words; the full sentence shows on hover.", false, [suggestchipsview], "The hub doesn't write short labels yet, and the reason behind each suggestion isn't shown.")
suggestchipsview = Preview("a52dce62-26be-4ec3-9a01-f487e36d2b66", "Desk and phone")
filed = Decision("filed", "How do the tasks Caw filed show under his reply?", [filedrows, filedcards], "The tasks read as part of his reply, and five long tasks fit without a tall stack of cards. The line under each title is the task's own description, from its task file. Why Caw filed each one isn't stored anywhere yet, so building this adds a reason Caw writes for each task as he files it.")
filedrows = Option("rows", "One list", "One list under his reply: each task's title, what it holds and why he filed it. They appear one after another.", true, [filedrowsview], "The tasks are less separated than cards, so they read as part of his reply.")
filedrowsview = Preview("52327db9-598b-4f8d-8aac-e0e934bb33b1", "Desk and phone")
filedcards = Option("cards", "Cards", "Each task on its own raised card with the same three lines, appearing one after another.", false, [filedcardsview], "In a 380px panel the cards stack into a tall column that outweighs his reply.")
filedcardsview = Preview("7c9085ce-4c22-4280-a5ea-bbbdd8801e54", "Desk and phone")
pins = Decision("pins", "Fixed from your pins: does it look right now?", [pinsright, pinsnot], "\"this button seems misplaced and out of context?\" Open the board is gone: each task opens itself. \"/useless-copy\" on \"Awake · resting\": the head shows nothing next to Caw's name when nothing waits on you, and the fact when something does.", [pinsview])
pinsview = Preview("1340cb12-10ef-4b4b-ad3a-01799d179f0f", "Desk")
pinsright = Option("looks-right", "Looks right", "These fixes go into the build as they are.", true, [], "Nothing more changes here.")
pinsnot = Option("not-yet", "Not yet", "Pin what's still wrong on the panel.", false, [], "Building these parts waits for your pins.")
