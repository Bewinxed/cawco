root = Decisions("Caw's panel", [purpose, shape, states])
purpose = Column([purposewhat, purposeholds, purposefor])
purposewhat = Text("Caw's panel is where you deal with Caw without leaving the page you're on.", "body")
purposeholds = Text("It's your conversation with him, with whatever waits on you at its top.", "body")
purposefor = Text("You open it to answer him, to catch up and steer, to start new work, or to get him unstuck.", "body")
shape = Section("The panel", [one, composer, title])
one = Decision("one", "Is Caw's panel one panel, or three?", [onepanel, onethree], "Today you press a different Caw for each job, and the thread, where you talk to him, is the one surface that never shows what waits on you.")
onepanel = Option("panel", "One panel", "What waits in other projects, then this project's thread, then the message box, from his head on the bar.", true, [onepanelviews], "When several asks wait in other projects, they push the thread down.")
onepanelviews = Row([onepaneldesk, onepanelphone])
onepaneldesk = Preview("dda87ce1-9038-440b-9e85-2d93e8f973f3", "One panel · Desk", ["Desk"])
onepanelphone = Preview("dda87ce1-9038-440b-9e85-2d93e8f973f3", "One panel · Phone", ["Phone"])
onethree = Option("three", "Today's three", "His head on the bar lists what waits on you, Ask Caw floats the thread, and ⋯ holds his switch.", false, [onethreeview], "You have to know which Caw to press for which job.")
onethreeview = Preview("30cb56ef-1fd3-4f80-9aad-d36f63774198", "Today's three · Desk", ["BarHead", "Thread", "Switch"])
composer = Decision("composer", "While Caw can't start, does the message box stay?", [composerstays, composergoes], "What you write while no machine is online is already kept, and he reads it once one is back. Taking the box away is the only thing that leaves you stuck.", [composerdesks, composerphones], ["one"])
composerdesks = Row([composerstaysdesk, composergoesdesk])
composerphones = Row([composerstaysphone, composergoesphone])
composerstays = Option("stays", "It stays", "You can still write; he reads it when he can start.", true, [], "A box you can type in sits under a block saying he can't start.")
composerstaysdesk = Preview("d71cf33b-e77c-4885-b559-abfe4f9fc81b", "It stays · Desk", ["Desk"])
composerstaysphone = Preview("d71cf33b-e77c-4885-b559-abfe4f9fc81b", "It stays · Phone", ["Phone"])
composergoes = Option("goes", "It goes", "The block's button is the only thing to press.", false, [], "Whatever you meant to tell him waits until a machine is back.")
composergoesdesk = Preview("9d40f1b8-b066-464b-8792-f8217058efa8", "It goes · Desk", ["Desk"])
composergoesphone = Preview("9d40f1b8-b066-464b-8792-f8217058efa8", "It goes · Phone", ["Phone"])
title = Decision("title", "What does the top of the panel call the thread?", [titlenamed, titleoffscreen], "Today a thread is named by its first message's first line, so any top that shows that name repeats the message under it. Chat apps name a conversation in a few words once it's answered.", [titlestarts, titlelaters, titlephonestarts, titlephonelaters], ["one"])
titlestarts = Row([titlenameddesk, titleoffscreenstart])
titlelaters = Row([titlenameddesklater, titleoffscreenlater])
titlephonestarts = Row([titlenamedphone, titleoffscreenphone])
titlephonelaters = Row([titlenamedphonelater, titleoffscreenphonelater])
titlenamed = Option("named", "Caw names it", "When he first answers, Caw names the thread in a few words, and the top always shows that name.", true, [], "Caw has to learn to set a thread's title: today he can't.")
titlenameddesk = Preview("71f13514-f17e-4d8d-9dc1-44dbfa8bb0ee", "Caw names it · Desk, at the thread's start", ["DeskStart"])
titlenameddesklater = Preview("71f13514-f17e-4d8d-9dc1-44dbfa8bb0ee", "Caw names it · Desk, a few messages on", ["DeskLater"])
titlenamedphone = Preview("71f13514-f17e-4d8d-9dc1-44dbfa8bb0ee", "Caw names it · Phone, at the thread's start", ["PhoneStart"])
titlenamedphonelater = Preview("71f13514-f17e-4d8d-9dc1-44dbfa8bb0ee", "Caw names it · Phone, a few messages on", ["PhoneLater"])
titleoffscreen = Option("offscreen", "Your first line, once it's off screen", "The top shows your first message's line only once you've scrolled past that message.", false, [], "At a thread's start the top names nothing, and the name comes and goes as you scroll.")
titleoffscreenstart = Preview("88d46a90-ac87-4d49-a75a-d85bdf9ac738", "Your first line · Desk, at the thread's start: the top is empty on purpose, as your first message is in view", ["DeskStart"])
titleoffscreenlater = Preview("88d46a90-ac87-4d49-a75a-d85bdf9ac738", "Your first line · Desk, a few messages on", ["DeskLater"])
titleoffscreenphone = Preview("88d46a90-ac87-4d49-a75a-d85bdf9ac738", "Your first line · Phone, at the thread's start: the top is empty on purpose, as your first message is in view", ["PhoneStart"])
titleoffscreenphonelater = Preview("88d46a90-ac87-4d49-a75a-d85bdf9ac738", "Your first line · Phone, a few messages on", ["PhoneLater"])
states = Section("What the panel does in each state", [statesnote, stateidle, stateworking, stateneeds, statenomachine, statebudget, stateoff, statecantread, statenotwoken, stateempty])
statesnote = Text("Settled, nothing to pick. When Caw can't do what the thread is for, one block takes its centre with the way out and Show details. Anything else is a row in the thread.", "body")
stateidle = Row([stateidledesk, stateidlephone])
stateidledesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "At rest · Desk", ["DeskIdle"])
stateidlephone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "At rest · Phone", ["PhoneIdle"])
stateworking = Row([stateworkingdesk, stateworkingphone])
stateworkingdesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Working · Desk", ["DeskWorking"])
stateworkingphone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Working · Phone", ["PhoneWorking"])
stateneeds = Row([stateneedsdesk, stateneedsphone])
stateneedsdesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Needs you · Desk", ["DeskNeedsYou"])
stateneedsphone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Needs you · Phone", ["PhoneNeedsYou"])
statenomachine = Row([statenomachinedesk, statenomachinephone])
statenomachinedesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "No machine online · Desk", ["DeskNoMachine"])
statenomachinephone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "No machine online · Phone", ["PhoneNoMachine"])
statebudget = Row([statebudgetdesk, statebudgetphone])
statebudgetdesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Budget reached · Desk", ["DeskBudget"])
statebudgetphone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Budget reached · Phone", ["PhoneBudget"])
stateoff = Row([stateoffdesk, stateoffphone])
stateoffdesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Off · Desk", ["DeskOff"])
stateoffphone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Off · Phone", ["PhoneOff"])
statecantread = Row([statecantreaddesk, statecantreadphone])
statecantreaddesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Thread won't read · Desk", ["DeskCantRead"])
statecantreadphone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Thread won't read · Phone", ["PhoneCantRead"])
statenotwoken = Row([statenotwokendesk, statenotwokenphone])
statenotwokendesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Not read: no machine was online · Desk", ["DeskNotWoken"])
statenotwokenphone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "Not read: no machine was online · Phone", ["PhoneNotWoken"])
stateempty = Row([stateemptydesk, stateemptyphone])
stateemptydesk = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "New thread · Desk", ["DeskEmpty"])
stateemptyphone = Preview("280e3aa4-1924-4424-a8e9-51b2e5b10bbd", "New thread · Phone", ["PhoneEmpty"])
