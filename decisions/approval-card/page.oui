root = Decisions("The approval card", [card, gate, keep], "Three picks before the card is built for the phone too.")
card = Decision("card", "Which approval card should an agent's ask use?", [newcard, todaycard], "The new card says who asks, why and what changes in three lines, links what it names, and keeps Approve and Deny exactly as they are.")
newcard = Option("new", "The new card", "Caw's face with the asker and project as links, the reason under the grant line, each setting before and after, and what approving covers.", true, [newcanvas], "A removal or a nine-setting change makes a taller card, and the phone app needs the same rebuild.")
todaycard = Option("today", "Today's card", "The card as it is: one summary line, then every field in one monospaced well.", false, [todaycanvas], "The reason stays a row labelled why, nothing links, and before and after read at one strength.")
newcanvas = Preview("approval-card-new")
todaycanvas = Preview("approval-card-today")
gate = Decision("gate", "When you remove something, should Approve wait until you've ticked each consequence?", [nogate, tick], "Approve and Deny stay at one strength (The Peer Rule): a gate on one makes the grant harder than the refusal, and a removal can be undone for a minute after anyway.", [], ["card"])
nogate = Option("no-gate", "No gate", "What the removal does is listed above the answer; Approve works at once.", true, [removalcanvas], "Nothing makes you read the list before approving.")
tick = Option("tick", "Tick each first", "A box beside each consequence; Approve stays off until every one is ticked.", false, [gatedcanvas], "Every removal takes a tick per line, and Approve and Deny are no longer peers.")
removalcanvas = Preview("approval-card-removal")
gatedcanvas = Preview("approval-card-gated")
keep = Decision("keep", "Keep the answered card in the chat?", [yes, no], "The answered card is the record of what you allowed and why, and it is where Undo for a removal lives.", [], ["card"])
yes = Option("yes", "Keep it", "The card stays where you answered it: Approved, Denied or withdrawn with the time, and Undo on a removal for the minute the hub keeps it.", true, [answeredcanvas], "The conversation grows by one card per answer.")
no = Option("no", "Today's tool row", "The card goes once answered; the conversation keeps one tool row for the call.", false, [toolrowcanvas], "No record of the reason, and no Undo after a removal.")
answeredcanvas = Preview("approval-card-answered")
toolrowcanvas = Preview("approval-card-answered-today")
