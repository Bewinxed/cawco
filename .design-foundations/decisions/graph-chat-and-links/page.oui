root = Decisions("Chat decisions and links on the decision graph", [chat, links])
chat = Decision("chat-picks", "Should a decision you make in chat show up on the project's decision graph?", [chatyes, chatno], "The advisor's rule is that a decision worth tracking is a page, and a one-decision page is three or four lines; without this, the only way a chat pick reaches the graph is asking you again.")
chatyes = Option("on-graph", "On the graph", "It arrives as a one-question page already picked and folded, marked as picked in chat with where you said it, and later decisions can link to it.", true, [chatyesd], "The hub needs one new input it lacks today: an agent setting a pick for you when it makes or updates the page.")
chatno = Option("log-only", "Decision log only", "Chat decisions go into the decision log the pages already write, and nothing new is built.", false, [chatnod], "They never appear on the graph, so no later decision can link to them; putting one there means asking you again.")
chatyesd = Diagram("flowchart LR\nA[You pick in chat] --> B[Page, already picked]\nB --> C[Card on the graph]\nC --> D[Later decisions link to it]")
chatnod = Diagram("flowchart LR\nA[You pick in chat] --> B[Decision log]\nC[Graph] -.- E[No card, nothing links to it]")
links = Decision("draw-links", "Should you be able to draw a link between two decisions on the graph yourself?", [linkno, linkyes], "The advisor calls this a known limit, not a change, and the PRD doesn't ask for it; a link you draw would sit in an agent's page, where that agent's next rewrite of the card can silently drop it.")
linkno = Option("agents-link", "Agents add links", "A link exists only because a decision names what it follows; to add one you ask an agent, which changes one line of that page.", true, [linknod], "You can't link on the graph directly; every new link is a request to an agent.")
linkyes = Option("i-draw", "I draw them", "You drag from one card to another and the hub writes the link into the later decision's page for you.", false, [linkyesd], "The hub edits pages it didn't write, and an agent that later rewrites that card without your link drops it.")
linknod = Diagram("flowchart LR\nA[You ask an agent] --> B[Agent changes one line of the page]\nB --> C[Link on the graph]")
linkyesd = Diagram("flowchart LR\nA[You drag a line on the graph] --> B[Hub writes it into the page]\nB --> C[Link on the graph]\nD[Agent rewrites that card later] -.-> C")
