root = Decisions("Tasks, plans and to-dos: the open questions", [listhome, stepedges, delegatedepth, wake, ended, settled], "One model: a task's to-dos are its checklist, a session's plan is its steps, and on an attempt the plan is the task's to-dos with the session's steps under them, drawn once. These five are what no file settles, the most upstream first. The last card lists what the sources did settle; overturn any in its note.")

listhome = Decision("list-home", "Where does every session keep its plan?", [lhcawco, lhswitch, lhread], "Your rule: an edit you make to a plan reaches the session and changes its work. That holds only where CawCo holds the list. Claude Code sessions keep their own list unless “CawCo's to-dos” is on; OpenCode and pi already use CawCo's (plans.ts:108). CawCo reads Claude Code's list from disk and cannot write it. Recommended: CawCo's list, always, because it is the one list your edits can land in; the PRD already proposes it but never approved it (§9, “CawCo's list only as a default for any harness beyond pi”).")
lhcawco = Option("cawco", "CawCo's list, always", "Every session writes its plan with todo_write; the onboarding choice and the Settings switch go.", true, [Text("Costs: Claude Code's own list tools are off for everyone; a plan moves only when the session calls todo_write.", "meta")])
lhswitch = Option("switch", "Keep the switch", "On Claude Code's own list, your edits go as messages and its next list write shows whether it took them.", false, [Text("Costs: two behaviours for one plan; a change you make can drop off the row until the session writes its list again.", "meta")])
lhread = Option("read-only", "Keep the switch, its lists read-only", "On Claude Code's own list you comment on steps but cannot tick, add or reword.", false, [Text("Costs: whether you can steer depends on a choice made once in onboarding.", "meta")])

stepedges = Decision("step-edges", "Can a step or a to-do wait on another one, or do only tasks wait on tasks?", [seafter, sepromote, seorder], "You pinned “dependent / graph steps” on the plan view. The PRD says edges stay on tasks and a step that needs one becomes a task (§5.2, “Every session's plan, in a panel”). Lanes on the plan-view page only make sense with the first answer. Recommended: steps and to-dos get “after”, for order and drawing only, because the PRD's rule exists for the dispatcher (§5.2, “Triage, edges and the dispatcher only ever see tasks”) and this leaves dispatch untouched.")
seafter = Option("after", "Steps and to-dos get “after”", "A step shows “after Date picker” and an hourglass until that one is done; the plan draws the line.", true, [seafterpic, Text("Costs: overturns “edges stay on tasks” for the plan; a second, lighter kind of edge.", "meta")])
seafterpic = Diagram("flowchart TB\n  A[Class picker ✓] --> B[Date picker]\n  A --> C[Take the deposit]\n  B --> C", "Inside one plan")
sepromote = Option("promote", "Only tasks wait", "As the PRD has it: a step that waits on another becomes a task with an edge, and its line becomes the task's chip.", false, [sepromotepic, Text("Costs: a new task (file, stage, attempt) for every ordering.", "meta")])
sepromotepic = Diagram("flowchart LR\n  S[Take the deposit] -- promoted --> T[tsk-152]\n  T -- after --> U[tsk-150]", "Waits only between tasks")
seorder = Option("order", "Order only", "The list's order is the only sequence; a step shows waiting only on you, a slot or a delegate.", false, [Text("Costs: your pin goes unmet; the plan can't say why a step hasn't started.", "meta")])

delegatedepth = Decision("delegate-depth", "How far down does a delegate's work show in your plan?", [ddone, ddall, ddflat], "A step a delegate carries shows that delegate. You called the delegates “too messy” when their steps, report and session link all stood open under the to-do. The hub already sends each delegate's own delegates with their progress (delegation-tree.ts:21-42, children and plan done of total). Recommended: one level behind a fold, because a grandchild's progress line needs nothing the hub doesn't already send, and deeper is one Open away.")
ddone = Option("one", "One level, behind a fold", "Folded open, a delegate shows its own steps; its own delegates are one row each with a progress line; Open goes deeper.", true, [ddonepic, Text("Costs: a grandchild's steps take opening its session.", "meta")])
ddonepic = Diagram("flowchart LR\n  D[Delegate 3 of 5] -.-> a[step]\n  D -.-> b[step]\n  D -.-> G[delegate 1 of 4]", "Your step's delegate, folded open")
ddall = Option("all", "The whole tree", "Every level folds open in place, down to the last delegate.", false, [ddallpic, Text("Costs: a deep tree runs past the phone's sheet; rails four levels in leave little room for words.", "meta")])
ddallpic = Diagram("flowchart TB\n  S[Your step] --> D[Delegate]\n  D --> a[its step]\n  D --> G[its delegate]\n  G --> b[its step]\n  G --> H[its delegate]", "Every level")
ddflat = Option("flat", "One row, no fold", "A delegate is a row with its progress line; its plan lives on its own session's page.", false, [Text("Costs: what it is doing is a tap away; the plan can't show why it is slow.", "meta")])

wake = Decision("wake", "When a session is idle, which of your changes wake it?", [wkwork, wkevery, wksend], "Your words: “when i edit the plan or amend or comment on it the agents should be notified or whoever is conducting the plan etc and relay appropraitely to steer the work”. While a session works, a change reaches it at once, as artifact changes do (PRD §5.10, “Delivery to the agent”). Waking an idle one costs a turn. Recommended: changes to the work wake it and records ride along, because a tick or a reorder asks nothing of it now.", [], ["list-home"])
wkwork = Option("work", "Changes to the work wake it", "Adding, rewording, removing or reopening a step, or a comment, wakes it after 3 s of quiet; a tick or a reorder waits for its next turn.", true, [Text("Costs: a reorder meant as “do this first” waits until something else wakes it.", "meta")])
wkevery = Option("every", "Every change wakes it", "Any edit, batched after 3 s of quiet, starts a turn.", false, [Text("Costs: ticking three things from the phone pays for a turn that only says “noted”.", "meta")])
wksend = Option("send", "Nothing wakes it until you press Send", "Changes gather on the plan as “3 unsent” and go when you send, as artifact pins do.", false, [Text("Costs: one more press; changes are easy to leave unsent.", "meta")])

ended = Decision("ended", "A change or a comment on a step whose session has finished: who gets it?", [enconductor, enreopen, ennote], "A finished delegate's step, or a task's to-do with no attempt running. Reopening a finished session spends a turn and may start work in a stale workspace; the conductor (the delegate's parent, or Caw for a task) holds the wider plan. Your words wake Caw whether he is on or off (WORDS.md line 174, “Either way you can always talk to him”). Recommended: the conductor decides, because it alone knows whether the step still matters.", [enpic], ["wake"])
enpic = Diagram("flowchart TB\n  A[A finished delegate's step] --> P[Its parent session]\n  B[A to-do, no attempt] --> C[Caw]", "Who hears your comment")
enconductor = Option("conductor", "The conductor decides", "A delegate's step goes to its parent session; a task's to-do goes to Caw, who re-plans, files it or starts an attempt.", true, [Text("Costs: one more hop; a plain session with no parent is simply reopened.", "meta")])
enreopen = Option("reopen", "Reopen that session", "The finished delegate, or the task's last attempt, continues on your words (the attach-or-continue rule, PRD §5.3).", false, [Text("Costs: any comment can start paid work, in a workspace that may be stale.", "meta")])
ennote = Option("note", "Keep it for the next one", "It stays on the step and goes in the brief of whoever next works the task (PRD §5.3, “batched comments”).", false, [Text("Costs: nothing happens until someone starts the task; a finished delegate never hears it.", "meta")])

settled = Decision("settled", "Settled from the sources: keep them, or overturn some?", [stkeep, stchange], "Answered from the PRD, WORDS.md, the code and your own words. Say which to overturn in the note.", [stlines])
stlines = Column([st1, st2, st3, st4, st5, st6, st7, st8, st9, st10, st11])
st1 = Text("To-do and step: two records joined by id, drawn as one row. The to-do lives in the task file, the step in the session's plan; a step carrying td-3 is that to-do. PRD §5.2 “Plan ↔ to-dos, no drift”.", "body")
st2 = Text("Who edits: you, anywhere in a plan. An agent writes only its own plan, and a task's to-dos for its own attempt or as Caw (WORDS.md line 162). A parent steers its delegate by message, not by editing its plan. Your words: “the agents should be notified or whoever is conducting the plan”.", "body")
st3 = Text("Your edit shows at once. The session's next whole write is applied, and any step you changed since it last read is flagged to it, as an artifact write is (PRD §5.10, “The document”).", "body")
st4 = Text("Ask Fable: a delegate whose result is a report, drawn as any delegate's step with the report folded under it; no name of its own. Delegate types are presets (PRD §5.1); one word per concept (PRD §2).", "body")
st5 = Text("A delegate is tied to its step by the step's id, named when it is delegated; one named with none becomes a step of its own. Code coordinates (PRD §2); today nothing ties them.", "body")
st6 = Text("Step states: the session writes to do, doing and done (ACP's three, plan.ts:26); waiting and failed come from the session behind the step (delegation-tree.ts:38-40).", "body")
st7 = Text("A step opens to its description: the to-do's body, a delegate's brief and report, a run step's result. Your pin “can't expand a step”.", "body")
st8 = Text("The ring counts the task's to-dos on an attempt, the board card's figure; on a plain session, its top-level steps. PRD §5.2, “Progress is derived”.", "body")
st9 = Text("The task pane's to-dos and the plan are one list on one row; with no attempt running it is the to-dos alone. One code path, no second list.", "body")
st10 = Text("Open items stays agent plumbing with no name you see (open-items.ts:94); “work item” leaves copy for delegate, attempt and step.", "body")
st11 = Text("A workflow run's steps are its session's plan on the same rows; a change to one goes to the run's steering (workflow_steer).", "body")
stkeep = Option("keep", "Keep them all", "Build on these as written.", true)
stchange = Option("overturn", "Overturn some", "Name which, and what instead, in the note.")
