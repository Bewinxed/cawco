root = Decisions("How your changes reach an agent's plan", [settled, listhome, wake])

settled = Text("Already settled, nothing to pick: a step can wait on another step, a helper agent's work shows as one line under the step it works on, and a change still reaches the work after its agent has finished.", "meta")

listhome = Decision("list-home", "Where does every agent keep its plan?", [lhcawco, lhown], "Recommended: CawCo's list, because it is the only list you can tick, add to or reword. OpenCode and pi already keep their plans there; Claude Code keeps its own unless it is switched over, and CawCo can read that list but not change it.")
lhcawco = Option("cawco", "CawCo's list, always", "Every change you make lands in the plan itself, and the agent reads it the next time it works.", true, [], "Claude Code's own list is switched off for everyone, so the setup question that asks whether to keep each agent's own list goes away.")
lhown = Option("own", "Claude Code may keep its own", "Where it does, you can comment on its steps, and a change you make reaches it as a message it may or may not act on.", false, [], "One plan works two ways, and your change can vanish from the plan until the agent next updates its list.")

wake = Decision("wake", "When an agent is waiting, which of your changes start it working again?", [wkwork, wkevery, wksend], "Recommended: changes to the work, because an agent that is working sees your change at once, but starting a waiting one costs a reply, and every reply uses your usage.", [wkpic], ["list-home"])
wkpic = Diagram("flowchart TB\n  subgraph work [Changes to the work · recommended]\n    direction LR\n    w1[Starts it at once: a step you reword, add or remove, or a comment] ~~~ w2[Waits until it next works: a step you tick or move]\n  end\n  subgraph every [Every change]\n    direction LR\n    e1[Starts it at once: any change you make to the plan] ~~~ e2[Waits until it next works: nothing, since every change starts it]\n  end\n  subgraph send [Only when you press Send]\n    direction LR\n    s1[Starts it at once: nothing, until you press Send] ~~~ s2[Waits until you press Send: every change, sent together]\n  end\n  work ~~~ every ~~~ send")
wkwork = Option("work", "Changes to the work", "A step you reword, add or remove, or a comment, starts it 3 seconds after your last edit; a tick or a reorder waits until it next works.", true, [], "A reorder you meant as “do this first” waits until something else starts it.")
wkevery = Option("every", "Every change", "Any change starts it, 3 seconds after your last edit.", false, [], "Ticking three steps from your phone costs a reply that only says “noted”.")
wksend = Option("send", "Only when you press Send", "Changes gather on the plan as “3 unsent” and go together when you press Send.", false, [], "One more press, and changes are easy to leave unsent.")
