root = Decisions("How you steer a session's plan", [listhome, wake, settled])

listhome = Decision("list-home", "Where does every session keep its plan?", [lhcawco, lhown, lhread], "You can tick, add or reword a step only on a list CawCo holds. OpenCode and pi already keep their plans there. Claude Code keeps its own list unless you switch it over, and CawCo can read that list but can't change it.")
lhcawco = Option("cawco", "CawCo's list, always", "Every edit you make lands in the plan itself, and the session reads it on its next turn.", true, [], "Claude Code's own step list is off for everyone, and the setup question about it goes.")
lhown = Option("own", "Claude Code may keep its own", "Where it does, your edit goes to the session as a message, and its next list update shows whether it took it.", false, [], "One plan works two ways, and your change can vanish from the row until the session updates its list.")
lhread = Option("read-only", "Its own, but read-only", "Where Claude Code keeps its own list, you comment on steps but can't tick, add or reword them.", false, [], "Whether you can steer a plan depends on one choice made at setup.")

wake = Decision("wake", "When a session is idle, which of your changes wake it?", [wkwork, wkevery, wksend], "A working session sees your change at once. Waking an idle one starts a turn, and every turn is spent usage.", [wkpic], ["list-home"])
wkpic = Diagram("flowchart TB\n  subgraph work [Changes to the work]\n    direction LR\n    w1[Step reworded, added or removed, or a comment] --> w2[Wakes it]\n    w3[Step ticked or moved] --> w4[Waits for its next turn]\n  end\n  subgraph every [Every change]\n    direction LR\n    e1[Any change] --> e2[Wakes it]\n  end\n  subgraph send [Only when you press Send]\n    direction LR\n    s1[Any change] --> s2[Waits for Send]\n  end\n  work ~~~ every ~~~ send")
wkwork = Option("work", "Changes to the work", "Only changes it has to act on wake it, 3 seconds after your last edit; a tick or a reorder waits for its next turn.", true, [], "A reorder you meant as “do this first” waits until something else wakes it.")
wkevery = Option("every", "Every change", "Any change wakes it, 3 seconds after your last edit.", false, [], "Ticking three steps from your phone spends a turn that only says “noted”.")
wksend = Option("send", "Only when you press Send", "Changes collect on the plan as “3 unsent” and go together when you press Send.", false, [], "One more press, and changes are easy to leave unsent.")

settled = Decision("settled", "These three are settled. Keep them?", [stkeep, stchange], "The plan view's latest drawings already work this way.", [stlines])
stlines = Column([st1, st2, st3])
st1 = Text("A step can wait on another step, and the plan draws the link between them.", "body")
st2 = Text("A delegate is one row under the step it works on. Its steps, its report and its session open from that row.", "body")
st3 = Text("When the session on a step has ended, your change still lands: a delegate's step goes to the session running the plan, a task's to-do to its last attempt.", "body")
stkeep = Option("keep", "Keep all", "These are what the plan view is built on, so nothing waits.", true, [], "Changing one later means redoing what was built on it.")
stchange = Option("overturn", "Change some", "Name them in the note, and what you want instead.", false, [], "Building waits on each one you name.")
