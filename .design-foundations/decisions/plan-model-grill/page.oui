root = Decisions("Tasks, plans and to-dos: two questions left", [listhome, wake, settled])

listhome = Decision("list-home", "Where does every session keep its plan?", [lhcawco, lhswitch, lhread], "An edit you make reaches a session's work only where CawCo holds the list. OpenCode and pi already use CawCo's. Claude Code keeps its own unless “CawCo's to-dos” is on, and CawCo can read that list but never write it. The PRD proposes CawCo's list as the default and never approved it (§9). Recommended: CawCo's list, always, because it is the one list your edits can land in.", [lhpic])
lhpic = Diagram("flowchart LR\n  You[You reword a step] --> C{Whose list?}\n  C -->|CawCo's| L[The list changes; the session reads it next turn]\n  C -->|Claude Code's own| M[CawCo can't write it: your change goes as a message]", "What happens to your edit")
lhcawco = Option("cawco", "CawCo's list, always", "Every session writes its plan with todo_write; the onboarding choice and the Settings switch go.", true, [], "Claude Code's own list tools are off for everyone, and a plan moves only when the session calls todo_write.")
lhswitch = Option("switch", "Keep the switch", "On Claude Code's own list, your edits go as messages, and its next list write shows whether it took them.", false, [], "Two behaviours for one plan; a change you make can drop off the row until the session writes its list again.")
lhread = Option("read-only", "Keep the switch, those lists read-only", "On Claude Code's own list you comment on steps but can't tick, add or reword them.", false, [], "Whether you can steer a plan depends on a choice made once, in onboarding.")

wake = Decision("wake", "When a session is idle, which of your changes wake it?", [wkwork, wkevery, wksend], "Your words: “when i edit the plan or amend or comment on it the agents should be notified or whoever is conducting the plan etc and relay appropraitely to steer the work”. A working session gets a change at once, as with artifacts (PRD §5.10, “Delivery to the agent”); waking an idle one costs a turn. Recommended: changes to the work wake it and the rest wait, because a tick or a reorder asks nothing of the session now.", [], ["list-home"])
wkwork = Option("work", "Changes to the work wake it", "Adding, rewording, removing or reopening a step, or a comment, wakes it after 3 s of quiet; a tick or a reorder waits for its next turn.", true, [wkworkpic], "A reorder meant as “do this first” waits until something else wakes it.")
wkworkpic = Diagram("sequenceDiagram\n  participant You\n  participant S as The session, idle\n  You->>S: Reword a step\n  Note over S: wakes after 3 s of quiet\n  S-->>You: Seen by this session\n  You->>S: Tick a step\n  Note over S: stays asleep\n  S-->>You: Tick sent to this session, seen on its next turn", "Under the recommended answer")
wkevery = Option("every", "Every change wakes it", "Any edit, batched after 3 s of quiet, starts a turn.", false, [], "Ticking three things from the phone pays for a turn that only says “noted”.")
wksend = Option("send", "Nothing wakes it until you press Send", "Changes gather on the plan as “3 unsent” and go when you send, as artifact pins do.", false, [], "One more press, and changes are easy to leave unsent.")

settled = Decision("settled", "Settled from the sources: keep them, or overturn some?", [stkeep, stchange], "Each line names where it was settled. Name any you want changed in the note.", [stlines])
stlines = Column([st1, st2, st3, st4, st5, st6, st7])
st1 = Text("Who hears a change: whoever conducts the step. A working delegate's step goes to that delegate, and this session hears it too; any other step goes to the plan's own session. The line under the step says where it stands (“Comment sent to Fable”, “Seen by Fable and this session”, “Answered on the thread”). Plan view, round 4.", "body")
st2 = Text("A finished delegate's step goes to the plan's own session, its parent (round 4). A task's to-do with no attempt running follows attach or spawn: the last attempt continues on your words (PRD §5.3, D3); a task never started carries it into its first brief (PRD §5.2).", "body")
st3 = Text("Steps wait on steps: all three ways of the plan view draw “after Date picker”, from your pin “dependent / graph steps”. This overturns PRD §5.2's “Edges stay on tasks” for the plan only; the dispatcher still sees only tasks.", "body")
st4 = Text("A delegate is one row under the step it carries, its steps, report and Open its session behind its fold; deeper is its session's page. Round 4, after your “too messy”.", "body")
st5 = Text("Make a note goes to the project's one standing notes thread. Decided with you today.", "body")
st6 = Text("A to-do and the step carrying it are one row, joined by its id (“[td-3]”); finishing the step ticks the to-do. PRD §5.2, “Plan ↔ to-dos, no drift”.", "body")
st7 = Text("You edit any step of any plan; an agent writes only its own plan, and a task's to-dos for its own attempt or as Caw (WORDS.md). A parent steers its delegate by message, never by editing its plan.", "body")
stkeep = Option("keep", "Keep them all", "Build on these as written.", true, [], "Overturning one later means rework in what was built on it.")
stchange = Option("overturn", "Overturn some", "Name which, and what instead, in the note.", false, [], "The build waits on the answer for each one you name.")
