root = Decisions("The project page", [fixed, pipeline])

fixed = Section("Fixed from your pins", [panefix, cardfix, emptyfix, headfix])

panefix = Column([panepin, panechange, panereview, panesession])
panepin = Text("Your pins: “completely rethought as a single unit”, “only yes/no?”, “why are you mentioning working twice?”", "meta")
panechange = Text("A task is one panel that says its stage once. The agent's question sits right above Approve and Send back, and the Session tab shows the session itself.", "body")
panereview = Preview("@pane", "In Review, its agent asking you", ["PhoneReviewAsks"])
panesession = Preview("@pane", "Working, on its Session tab", ["PhoneWorking"])

cardfix = Column([cardpin, cardchange, cardview])
cardpin = Text("Your pins: “the x inside the circle is unreadable”, “a better way to indicate status without overwhelming the layout”", "meta")
cardchange = Text("Each card says its status in one line under its title; a card in Review or Done says nothing more, since its column says it.", "body")
cardview = Preview("@card", null, ["Phone"])

emptyfix = Column([emptypin, emptychange, emptyboard, emptyroutines])
emptypin = Text("Your pins: “why is caw and the cards left aligned?”, “why are these not having the consistent size?”, “why is the composer even there?”", "meta")
emptychange = Text("An empty page sits in the middle, its suggestions all one size, and Routines has no box to type in.", "body")
emptyboard = Preview("@empty", "The board, empty", ["BoardPhone"])
emptyroutines = Preview("@empty", "Routines, empty", ["RoutinesPhone"])

headfix = Column([headpin, headchange, headview])
headpin = Text("Your pin: “what the fuck is this button supposed to be?”", "meta")
headchange = Text("Spin off is gone. On a phone, New session is in the ⋯ menu, drawn open here over the top of the project, and opens the New Session form; Ask Caw is the coral + on the bar of views.", "body")
headview = Preview("@head", null, ["PhoneTop"])

pipeline = Decision("pipeline", "What is the Pipeline tab for?", [runorder, removed], "Recommended: Show what runs next, because nothing else on the project page says the order the work will happen in; the board only shows where each task is now. Your words: “this isn't a pipeline, and it's useless the way it is now”.", [runorderview])
runorderview = Preview("@run-order", "What the Pipeline tab would show", ["Phone"])
runorder = Option("run-order", "Show what runs next", "Pipeline lists what's being worked on, what waits on you, what's stuck and what's next; a task that waits on another sits under it.", true, [], "One more list to keep true as tasks start and stop waiting on each other.")
removed = Option("remove", "Remove the tab", "The tabs become Board, Table, Routines and Decisions; the board already counts the tasks at each stage.", false, [], "Nothing shows the order the work will run in, or what holds a task up.")
