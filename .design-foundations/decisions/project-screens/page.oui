root = Decisions("The project page, fixed from your pins", [pins, pipeline])

pins = Decision("pins", "Fixed from your pins: do these four look right now?", [pinsok, pinsnot], "Recommended: Looks right, because each fix was checked on the drawing itself: a task says its status once, no mark on a card is smaller than 16 pixels, an empty page sits centred to the pixel, and every suggestion on it is the same size.", [pinpane, pincard, pinempty, pinhead])
pinpane = Column([pinpanetext, pinpaneview])
pinpanetext = Text("“completely rethought as a single unit”, “ICONS IN SECTIONS”, “only yes/no?”, “why are you mentioning working twice?” A task opens as one panel: its title, its stage said once, then Review, Session, Details and Activity as tabs, each with its icon. Here the agent asks what to do with the old tide times, and its three answers sit above Approve and Send back.", "body")
pinpaneview = Preview("@pane", null, ["ReviewAsks"])
pincard = Column([pincardtext, pincardview])
pincardtext = Text("“the x inside the circle is unreadable”, “a better way to indicate status without overwhelming the layout”. Each card says its status in one line under its title. A failure is a solid circle with an exclamation mark and a task that can't start a solid circle with a line through it, here and everywhere else in the app. A card in Review or Done says nothing more: its column already says it.", "body")
pincardview = Preview("@card", null, ["Phone"])
pinempty = Column([pinemptytext, pinemptyview])
pinemptytext = Text("“why is caw and the cards left aligned?”, “why are these not having the consistent size?”, “why is the composer even there?” An empty page sits centred, its lines start on one edge, and every suggestion is the same size. Routines names itself once, has no composer of its own, and ends with Ask Caw for a routine, which opens Caw with it.", "body")
pinemptyview = Preview("@empty", null, ["BoardPhone", "RoutinesPhone"])
pinhead = Column([pinheadtext, pinheadview])
pinheadtext = Text("“what the fuck is this button supposed to be?” Spin off is gone from the top of the project. New session opens the full new-session window, where branching off from another session is one of its choices.", "body")
pinheadview = Preview("@head", null, ["Desk"])
pinsok = Option("looks-right", "Looks right", "All four get built as drawn.", true, [], "A change after the build means opening it again.")
pinsnot = Option("not-yet", "One isn't right yet", "Say which one and what's off in the note; the other three still get built.", false, [], "That part waits a round for its fix.")

pipeline = Decision("pipeline", "What is the Pipeline tab for?", [runorder, removed], "Your words: “this isn't a pipeline, and it's useless the way it is now”. Recommended: show what runs next, because nothing on the project page says the order the work will happen in: the board only shows where each task is now.", [runorderview])
runorderview = Preview("@run-order", "What the Pipeline tab would show", ["Phone"])
runorder = Option("run-order", "Show what runs next", "Pipeline lists what's being worked on, what waits on you, what's stuck and what's next; a task that waits on another sits under it.", true, [], "One more list to keep true as tasks start and stop waiting on each other.")
removed = Option("remove", "Remove the tab", "The tabs become Board, Table, Routines and Decisions; the board already counts the tasks at each stage.", false, [], "Nothing shows the order the work will run in, or what holds a task up.")
