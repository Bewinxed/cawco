root = Decisions("The project page, redrawn from your pins", [pins, pipeline], "One question is still yours: what Pipeline is for. First, check the fixes for your 19 pins on the old preview; each surface is live, with its states, phone and dark inside it. New session's look isn't asked: DESIGN.md has coral mark “the one place you act”, so it stays outlined beside Ask Caw.")

pins = Decision("pins", "Fixed from your pins: does it look right now?", [pinsok, pinsnot], "Each surface below leads with your words, then what changed. Recommended: Looks right, because each fix is measured on the live states: the stage said once, no card glyph under 16px, the empty column centred within 1px, every starter card one size.", [pinpane, pincard, pinempty, pinhead])
pinpane = Column([pinpanetext, pinpaneview])
pinpanetext = Text("“completely rethought as a single unit”, “the session needs to be a tab directly vieweable”, “only yes/no?”: the task pane is the title, one row of chips and one session row, then Review, Session, Details and Activity as tabs. The stage is said once, each Details heading has its glyph, and the decision stands at the foot with More for whatever else the agent offers.", "body")
pinpaneview = Preview("@pane")
pincard = Column([pincardtext, pincardview])
pincardtext = Text("“a better way to indicate status without overwhelming the layout”, “the x inside the circle is unreadable”: a board card leads with its title, then one line led by the session's mark or one glyph, then the facts. No badges, no x in a circle; a card in Review or Done has no line, since its column says it.", "body")
pincardview = Preview("@card")
pinempty = Column([pinemptytext, pinemptyview])
pinemptytext = Text("“why is caw and the cards left aligned?”, “why are these not having the consistent size?”: empty views stand on the composer's column, centred in the page, every line on one start edge and every starter card one size. Routines says its name once and has no composer of its own.", "body")
pinemptyview = Preview("@empty")
pinhead = Column([pinheadtext, pinheadview])
pinheadtext = Text("“what the fuck is this button supposed to be?”, “plain and useless new session command”: Spin off is gone. New session opens the kit's New-session dialog, where a spin-off is its lifetime chip.", "body")
pinheadview = Preview("@head")
pinsok = Option("looks-right", "Looks right", "Build these four as drawn.", true, [], "What's drawn becomes the build's spec; a later change reopens it.")
pinsnot = Option("not-yet", "Not yet", "Say what's still wrong in the note, by surface.", false, [], "The build of that surface waits for the next round.")

pipeline = Decision("pipeline", "What is the Pipeline tab for?", [runorder, removed], "Your words: “this isn't a pipeline, and it's useless the way it is now”. The PRD keeps a pipeline among a project's views (§5.2: “board, table, calendar, pipeline, canvas”) without saying what it shows. Its rows use the card's state line from the card above. Recommended: the run order, because the board shows a task's wait as one name on its card, and nothing shows the order work will run in.", [], ["pins"])
runorder = Option("run-order", "The run order", "What runs now, what waits on you, what's stuck and what comes next; a task that waits stands under the one it waits on, and done tasks fold away.", true, [runorderview], "One more view to keep true as tasks gain and lose their waits.")
runorderview = Preview("@run-order")
removed = Option("remove", "Remove the tab", "Board, Table, Routines and Decisions; the board's column heads already count each stage.", false, [removedview], "Nowhere shows the order tasks will run in or what holds each one, and the PRD's list of views loses one.")
removedview = Preview("@removed")
