/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Vite names everything in assets/ after its contents, so a name never changes
# what it holds. Without this the browser asks again on every visit, and Chrome
# then reports the preloaded font as unused.
/assets/*
  Cache-Control: public, max-age=31556952, immutable

# The sign-in hand-back. The document is what a provider fetches to learn what CawCo is, so it
# may be cached briefly; the two pages carry a one-time code in their address and are never kept.
/oauth/client.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

/oauth/start
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/oauth/callback
  Cache-Control: no-store
  Referrer-Policy: no-referrer
