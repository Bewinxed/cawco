{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/svelte"],
  // Law A: a read with a deadline goes through packages/core/src/bounded.ts.
  // A system program is found by the OS's own lookup, through
  // packages/core/src/workspace-needs.ts, never by a path of our own.
  // Stored data is read back through its schema: a JSON column is
  // storedJson(schema), a record readRecord(file, schema), never a cast.
  "plugins": [
    "./scripts/lint/no-raw-deadline.grit",
    "./scripts/lint/no-time-constants.grit",
    // A wait is said through secondsOf (packages/core/src/time.ts).
    "./scripts/lint/no-whole-seconds.grit",
    "./scripts/lint/no-system-path.grit",
    // A long-running process that fails ends, so its service manager starts
    // it again (packages/core/src/listeners.ts).
    "./scripts/lint/no-exit-code.grit",
    "./scripts/lint/uncaught-handlers-exit.grit",
    "./scripts/lint/stored-json.grit",
    // An artifact's row goes through dropArtifacts alone, which ends its
    // preview origin (packages/hub/src/db/artifacts.ts).
    "./scripts/lint/artifact-rows-drop.grit",
    // A preview origin's upstream is the hub's preview-service.ts's alone,
    // and what serves an artifact is read off its row
    // (packages/core/src/preview/upstream.ts).
    "./scripts/lint/preview-upstream.grit",
    // An artifact's machine and source have one write, db/artifacts.ts
    // `resource`, which moves its preview with it.
    "./scripts/lint/preview-source-write.grit",
    // An exhaustive switch ends with unhandled() (packages/core/src/unhandled.ts).
    "./scripts/lint/no-hand-unhandled.grit",
    // A colour or a size in a stylesheet or a `<style>` is a token
    // (DESIGN.md); the markup half is Golar's (scripts/lint/design/raw-values.mjs).
    "./scripts/lint/no-raw-css-values.grit",
    // A duration or a curve there is a motion token, and CSS's own `ease` is
    // never one (DESIGN.md, Motion grammar); the markup and script half is
    // Golar's (scripts/lint/design/raw-motion.mjs).
    "./scripts/lint/no-raw-motion.grit",
    // A refused hub request's reason is a words entry (packages/core/src/words/**).
    "./scripts/lint/hub-refusal-words.grit",
    // A Bun spawn names its env: with none it gets the environment its
    // process started with (oven-sh/bun#40846).
    "./scripts/lint/spawn-names-env.grit",
    // A probe reads a tool's answer through scripts/tool-calls.ts, never off
    // a request's `last`: a call moved to the background answers later.
    "./scripts/lint/tool-answer-from-last.grit",
    // A value is quoted for a shell through shellQuote (packages/core/src/shell-quote.ts).
    "./scripts/lint/no-hand-shell-quote.grit",
    // core's frames.ts holds frame types alone (packages/core/src/frames.ts).
    "./scripts/lint/frames-types-only.grit",
    // A harness is a table and a facet, never a name
    // (packages/core/src/harness/traits.ts).
    "./scripts/lint/no-harness-compare.grit",
    // An artifact doc's meta map is reached through core doc-meta.ts.
    "./scripts/lint/doc-meta-door.grit",
  ],
  // Design mock-ups and their build scratch, not shipped code.
  // jsonl-parser is publishable and linted/formatted by oxlint/oxfmt instead.
  // drizzle/meta is drizzle-kit generate output, and CawCoAPI/openapi.json is
  // `bun run openapi`'s (packages/hub).
  // .design-foundations holds design artifacts; .mcp.json is local MCP config.
  "files": {
    // Biome skips a file past maxSize (1 MiB by default) as "ignored", so a
    // check passes without reading it: packages/hub/src/server.ts passed
    // 1 MiB on 2026-10-16 and went unlinted. Every file it lints is read.
    "maxSize": 2097152,
    "includes": [
      "!mocks",
      // Design previews served as plain folders for the owner to judge (design-previews/<page>/),
      // mock-ups as mocks/ are; their proof is a probe-kit spec, which is linted.
      "!design-previews",
      "!.design-foundations",
      "!.mcp.json",
      "!packages/jsonl-parser",
      "!packages/hub/drizzle/meta",
      // generated by packages/core/scripts/openui-views.ts (`bun run openui`).
      "!packages/core/src/views-spec.json",
      "!packages/core/src/decisions-spec.json",
      // the comment sizing preview's parts and stylesheet, captured from the dashboard's own components and CSS by its capture/capture.ts.
      "!design-previews/comment-sizing/parts.js",
      "!design-previews/comment-sizing/house.css",
      // the address design preview's build output (apps/dashboard/scripts/address-preview.vite.ts): minified, never edited.
      "!design-previews/address/assets",
      "!design-previews/address/index.html",
      // the decision-page template: {{KIT_CSS}}/{{KIT_JS}} slots src/decision-page.ts fills, not CSS or JS.
      "!packages/hub/skills/decision-page/kit/page.html",
      "!apps/apple/Packages/CawCoKit/Sources/CawCoAPI/openapi.json",
      // generated by apps/apple/scripts/targets-map.sh, held to it by its --check in the gate's build.
      "!apps/apple/targets.json",
      // generated by apps/apple/scripts/icons.ts from Iconify Solar and Logos.
      "!apps/apple/Packages/CawCoKit/Sources/CawCoDesign/Resources/Icons.xcassets",
      // generated by assets/mascot/scripts/trace.py (vtracer); input to scene.mjs, never rendered as SVG.
      "!assets/mascot/loops/*/body-*.svg",
      // the same drawings for the transition clips, by trace_clip.py.
      "!assets/mascot/clips/*/body-*.svg",
      // pages copied byte for byte from the owner's sessions: a spec reads them as he saw them.
      "!scripts/probe-kit/fixtures",
      // each Biome plugin's planted mistakes, linted plugin by plugin by
      // scripts/lint/biome-plugins.ts and held to their list there.
      "!scripts/lint/fixtures/biome",
      // generated by apps/dashboard/scripts/build-tokens.ts, held to it by its --check, and
      // compiled by Tailwind there and in vite build. Its `@theme inline reference` block is
      // Tailwind 4 syntax Biome 2.5.15's parser rejects ("expected `{` but instead found
      // `reference`"); `@theme reference` alone parses but adds self-fallbacks to every utility.
      "!apps/dashboard/src/lib/tokens/theme.css",
    ],
  },
  // The dashboard's Tailwind theme, utilities and variants, which the
  // Tailwind rules read ("Biome reads the `@theme`, `@utility`, and
  // `@custom-variant` rules in this file and in the files it imports",
  // biomejs.dev/reference/configuration/#tailwind), and the class helpers
  // and recipes the dashboard writes classes in.
  "tailwind": {
    "stylesheet": "./apps/dashboard/src/app.css",
    "mergeFunctions": ["cn", "cx", "clsx", "twMerge", "twJoin", "classNames"],
    "variantFunctions": ["tv", "cva"],
  },
  // Biome lints; `bun fmt` formats (scripts/fmt.ts, .prettierrc). Each
  // language's formatter is off too: ultracite's preset turns them on one by one.
  "formatter": { "enabled": false },
  "javascript": {
    // Bun and HTMLRewriter: Bun's runtime globals (typed by @types/bun).
    // __CAWCO_COMMIT__: the dashboard's build commit, a `define` in
    // apps/dashboard/vite.config.ts.
    "globals": ["Bun", "HTMLRewriter", "__CAWCO_COMMIT__"],
    "formatter": { "enabled": false },
  },
  "json": { "formatter": { "enabled": false } },
  "css": { "formatter": { "enabled": false } },
  // Svelte markup is linted, not only its scripts ("Since full support is
  // still experimental, it must be enabled explicitly",
  // biomejs.dev/internals/language-support).
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": { "enabled": false },
  },
  // Both sorters can change what the code does: JS object key order is
  // observable through Object.keys/entries and JSON output, and a CSS
  // longhand moved after its logical shorthand (margin-left after
  // margin-inline) wins where it used to lose. Left off so a fix pass is
  // formatting and safe lint fixes, never a reorder.
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedProperties": "off",
      },
    },
  },
  // Every state is handled by the type-aware switch check instead
  // (scripts/lint/switch-exhaustiveness.ts, in Golar): a switch over a
  // union names each member, and a `default:` would hide the next member
  // added to it. A default stays only where the value can really be outside
  // its union at runtime (a verb or type off the wire, a plain string).
  "linter": {
    "rules": {
      "style": {
        // Every import names the module that owns it (core has no index). An
        // override's options replace these, so each noRestrictedImports
        // override below restates this path.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@cawco/core": "Core has no index: import the module that owns the name, like @cawco/core/stage.",
            },
          },
        },
        "useDefaultSwitchClause": "off",
        // Ultracite 8.1's: a numbered group is read by its index at the call
        // site, and naming 1,873 of them changes no match. Style, no defect.
        "useNamedCaptureGroup": "off",
        // Ultracite 8.1's. A private helper that reads no `this` is a module
        // function; what the rule reports then (59) are public members
        // callers reach through a store, service or interface, and callback
        // slots with a no-op default. The rule has no option for those.
        "useThisInClassMethods": "off",
        // getElementById is the exact lookup; querySelector("#" + id)
        // throws on an id that starts with a digit, and querySelectorAll's
        // list is static where getElementsByTagName's is live.
        "useDomQuerySelector": "off",
        // Custom properties set inline are how a value reaches CSS here;
        // scripts/lint/design/shadcn.mjs (no-inline-styles) is the one
        // policy, and this rule's only fix deletes the attribute.
        "noInlineStyles": "off",
      },
      // Baseline, read against what the dashboard ships to: current Chromium
      // and WebKit (the phone app's WKWebView), never an older engine. The
      // tier is "newly"; the allow lists name the features it uses on purpose
      // that are not yet Baseline in every engine.
      "suspicious": {
        // With let and const each iteration has its own binding; the 31
        // findings are callbacks reading shared state on purpose.
        "noLoopFunc": "off",
        "useBaseline": {
          "level": "error",
          "options": {
            "available": "newly",
            // Progressive enhancements: an engine without them lays the page
            // out as before (ragged wrap, no head fade, no trim).
            "allowProperties": [
              "text-wrap",
              "text-box",
              "text-size-adjust",
              "line-clamp",
              "overflow-anchor",
              "overflow-clip-margin",
              "accent-color",
              "resize",
              // scroll-driven fades: without them the edge stays unfaded.
              "scroll-timeline",
              "timeline-scope",
              "animation-timeline",
              "animation-range",
              // written after its -webkit- twin, which WebKit reads.
              "user-select",
            ],
            "allowPropertyValues": {
              "text-wrap-style": ["pretty"],
              "background-clip": ["text"],
              // SvelteKit's app.html wrapper; every target engine has it.
              "display": ["contents"],
            },
            "allowMediaConditions": ["prefers-reduced-transparency"],
            "allowSelectors": ["selection"],
          },
        },
      },
      // Two of Biome's recommended rules whose only fix ("unsafe") changes
      // what correct code does, and which they report on 103 places that
      // mean it: Math.max/min over strings, which they cannot tell from
      // numbers ("ignores operands that are obviously not numeric", which a
      // string is not; PreviewPane.svelte, comment-rows.ts), and innerText,
      // which the probe specs read for the text a person sees ("`textContent`
      // and `innerText` are not equivalent",
      // biomejs.dev/linter/rules/use-dom-node-text-content). Off, so no fix
      // pass rewrites them.
      "complexity": { "useMathMinMax": "off" },
      "performance": {
        // `export *` hides what a module carries from its reader and from
        // knip; a module names what it re-exports. Ultracite 8.1 leaves it off.
        "noReExportAll": "error",
        "useDomNodeTextContent": "off",
        // CawCo's loops are sequential on purpose (ordered effects, one git
        // or process at a time); a parallel loop is written with Promise.all
        // where it is meant.
        "noAwaitInLoops": "off",
      },
      // A label wrapping a kit control wraps its input: each of these renders
      // one (ui/input, ui/textarea, ui/checkbox, ui/switch's button,
      // ui/native-select). The rule
      // reads no namespaced component, so a select is the barrel's plain
      // `NativeSelect` (biomejs.dev/linter/rules/no-label-without-control).
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "Input",
              "Textarea",
              "Checkbox",
              "Switch",
              "NativeSelect",
            ],
          },
        },
      },
    },
  },
  "overrides": [
    {
      // boundary/'s files call each other in one direction: what must call
      // round a loop (ensuring a boundary follows its host, whose exit
      // ensures it again) is one file, ensure.ts.
      "includes": ["packages/agent/src/boundary/**"],
      "linter": {
        "rules": {
          "suspicious": { "noImportCycles": "error" },
        },
      },
    },
    {
      // scripts/, assets/, design/ and the root's own files are no member's:
      // the checks and probes read the members' sources by design, and a
      // member reading a shared asset has no manifest to go through.
      "includes": ["apps/**", "packages/**", "site/**", "!**/*.jsonc"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    // A member imports another member's file through its
                    // manifest (@cawco/<name>/…), never by a path into its
                    // folder, whatever the path's depth: the named-member
                    // line reads `../../agent/src/x`, which never says packages/. The CLI's `dashboard` starts the dashboard's
                    // own entry, which no manifest exports (its binary builds it).
                    "group": [
                      "**/packages/*/src/**",
                      "**/{agent,auth,cli,core,design-tokens,hub,icons,jsonl-parser,sessiond,cawrier,dashboard,site}/{src,scripts}/**",
                      "@cawco/*/src/**",
                      "**/apps/*/**",
                      "!**/apps/dashboard/serve.js",
                    ],
                    "message": "A member imports another's file through that member's manifest (@cawco/<name>/…), never by a path into its folder.",
                  },
                ],
                "paths": {
                  "@cawco/core": "Core has no index: import the module that owns the name, like @cawco/core/stage.",
                },
              },
            },
          },
        },
      },
    },
    {
      // Core stands under every other package, so it imports none of them.
      // jsonl-parser is a published leaf that imports no workspace package,
      // and the transcript index's author words are its own: core's wire
      // type is an Extract of them (find.ts), so the two cannot drift.
      "includes": ["packages/core/**", "!**/*.jsonc"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    // A member imports another member's file through its
                    // manifest (@cawco/<name>/…), never by a path into its
                    // folder, whatever the path's depth: the named-member
                    // line reads `../../agent/src/x`, which never says packages/. The CLI's `dashboard` starts the dashboard's
                    // own entry, which no manifest exports (its binary builds it).
                    "group": [
                      "**/packages/*/src/**",
                      "**/{agent,auth,cli,core,design-tokens,hub,icons,jsonl-parser,sessiond,cawrier,dashboard,site}/{src,scripts}/**",
                      "@cawco/*/src/**",
                      "**/apps/*/**",
                      "!**/apps/dashboard/serve.js",
                    ],
                    "message": "A member imports another's file through that member's manifest (@cawco/<name>/…), never by a path into its folder.",
                  },
                  {
                    "group": [
                      "@cawco/**",
                      "!@cawco/core",
                      "!@cawco/core/**",
                      "!@cawco/jsonl-parser",
                    ],
                    "message": "@cawco/core imports no other package; what it needs moves into core.",
                  },
                ],
                "paths": {
                  "@cawco/core": "Core has no index: import the module that owns the name, like @cawco/core/stage.",
                },
              },
            },
          },
        },
      },
    },
    {
      // The kit imports no feature component and no route; what it needs of
      // them comes in as a prop or a snippet. A module that itself reaches
      // the kit is scripts/import-rules-check.ts's. The tool cards' output
      // block is a named exception until markdown takes it as a slot: the
      // kit's markdown draws a tool's output through it.
      "includes": ["apps/dashboard/src/lib/components/ui/**", "!**/*.jsonc"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    // A member imports another member's file through its
                    // manifest (@cawco/<name>/…), never by a path into its
                    // folder, whatever the path's depth: the named-member
                    // line reads `../../agent/src/x`, which never says packages/. The CLI's `dashboard` starts the dashboard's
                    // own entry, which no manifest exports (its binary builds it).
                    "group": [
                      "**/packages/*/src/**",
                      "**/{agent,auth,cli,core,design-tokens,hub,icons,jsonl-parser,sessiond,cawrier,dashboard,site}/{src,scripts}/**",
                      "@cawco/*/src/**",
                      "**/apps/*/**",
                      "!**/apps/dashboard/serve.js",
                    ],
                    "message": "A member imports another's file through that member's manifest (@cawco/<name>/…), never by a path into its folder.",
                  },
                  {
                    "group": [
                      "**/features/**",
                      "**/routes/**",
                      "!#lib/components/features/tool-cards/OutputBlock.svelte",
                    ],
                    "message": "lib/components/ui imports no feature component and no route; pass it in as a prop or a snippet.",
                  },
                ],
                "paths": {
                  "@cawco/core": "Core has no index: import the module that owns the name, like @cawco/core/stage.",
                },
              },
            },
          },
        },
      },
    },
    {
      // A test holds the type checker to what the code holds it to: Ultracite
      // turns noExplicitAny off for test files.
      "includes": [
        "**/*.{test,spec}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
        "**/__tests__/**/*",
      ],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "error" } } },
    },
    {
      // The shadcn-svelte kit's component groups are imported as a namespace
      // (`* as DropdownMenu`, read as `DropdownMenu.Root`, `.Item`) through
      // each group's index. A namespace import of anything but a kit group is
      // refused by scripts/lint/kit-namespace-only.grit.
      "includes": [
        "apps/dashboard/src/**/*.svelte",
        "apps/dashboard/src/lib/components/ui/**",
      ],
      "plugins": ["./scripts/lint/kit-namespace-only.grit"],
      "linter": {
        "rules": {
          "performance": { "noNamespaceImport": "off" },
        },
      },
    },
    {
      // A module that re-exports what another module holds (noBarrelFile),
      // where re-exporting is its job; everywhere else an import names the
      // module that owns the name:
      // - each kit group's index: the namespace a group is imported as,
      //   shadcn-svelte's own layout (`shadcn-svelte add` writes it);
      // - the icons, each a `~icons/…` module unplugin-icons makes, named
      //   for the product in @cawco/icons (index, and marks for the brand
      //   marks) and nowhere else (scripts/icon-imports-check.ts), and the
      //   dashboard's one icon module (DESIGN.md, The Solar Duotone Rule);
      // - core's signal.ts, the one door to signal-wall.ts, which imports
      //   nothing so the srt host can signal through it alone;
      // - cawrier's entry, Workers' `main`, where a Durable Object class is
      //   found among the entry's exports.
      "includes": [
        "apps/dashboard/src/lib/components/ui/**/index.ts",
        "apps/dashboard/src/lib/icons.ts",
        "packages/icons/src/index.ts",
        "packages/icons/src/marks.ts",
        "packages/core/src/signal.ts",
        "apps/cawrier/src/index.ts",
      ],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off" },
        },
      },
    },
    {
      // The dashboard's one icon module carries every icon @cawco/icons
      // names (`export *`): naming each again here would be a second list of
      // the same names to keep in step with the first.
      "includes": ["apps/dashboard/src/lib/icons.ts"],
      "linter": {
        "rules": {
          "performance": { "noReExportAll": "off" },
        },
      },
    },
    {
      // Ultracite's Svelte preset turns noInlineStyles back on for Svelte
      // and app.html; the house rule (shadcn.mjs no-inline-styles) holds.
      "includes": ["**/*.svelte", "**/app.html"],
      "linter": { "rules": { "style": { "noInlineStyles": "off" } } },
    },
    {
      // The design system's colour rule over the dashboard's markup and
      // scripts, moved from @shadcn/lint's no-raw-colors, which ran with no
      // options: Biome's takes the same ("Disallow Tailwind CSS utility
      // classes that use raw palette colors … It allows custom color names,
      // `black`, `white`, `transparent`, `current`, and `inherit`",
      // biomejs.dev/linter/rules/no-tailwind-raw-colors). The other design
      // rules run in Golar (golar.config.ts, scripts/lint/design): Biome's
      // nearest rules hold neither their options nor their reach.
      "includes": [
        "apps/dashboard/src/**/*.svelte",
        "apps/dashboard/src/**/*.ts",
      ],
      "linter": {
        "rules": {
          "nursery": { "noTailwindRawColors": "error" },
        },
      },
    },
    {
      // The browser may hand the dashboard no storage (null on a window
      // WebKit no longer displays, a SecurityError where it is blocked):
      // storage.ts is the one way to it, and keeps nothing then. app.html's
      // pre-paint scripts import nothing; each reads inside its own try.
      "includes": [
        "apps/dashboard/src/**",
        "!apps/dashboard/src/lib/cawco/storage.ts",
        "!apps/dashboard/src/app.html",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "Use $lib/cawco/storage: the browser may hand back no storage.",
                  "sessionStorage": "Use $lib/cawco/storage: the browser may hand back no storage.",
                  // An answer written inside a ResizeObserver's delivery that
                  // lays the page out again resizes boxes the delivery has
                  // passed ("ResizeObserver loop completed with undelivered
                  // notifications"). A site that must answer inside the
                  // delivery says why in its biome-ignore.
                  "ResizeObserver": "Use frameObserver ($lib/cawco/frame-observer): its answer comes in the next frame, so nothing it writes resizes a box inside the delivery.",
                },
              },
            },
          },
        },
      },
    },
    {
      // A rejection nobody handles ends the hub or sessiond (Bun's default),
      // so every promise there is awaited, returned, or handed to detach()
      // from @cawco/core/detach. `void` is not handling: noFloatingPromises
      // accepts it, so it is not used for promises in these packages.
      "includes": ["packages/hub/**", "packages/sessiond/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "error",
            "noMisusedPromises": "error",
          },
        },
      },
    },
    {
      // A sheet (live components) is named for the component it shows, beside
      // it: `Who.stories.ts` for `Who.svelte`, Component Story Format's own
      // convention. The name is checked before `.stories`, as the
      // component's is.
      "includes": ["**/*.stories.ts", "**/*.stories.js"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["PascalCase", "kebab-case"],
                "match": "(.+?)[.](stories)[.][jt]s",
              },
            },
          },
        },
      },
    },
    {
      // A comment card and its reply composer load no fleet store
      // (composer-weight's legs 1 and 2): the modules they draw from import
      // the store's types alone and draw a session through the host's
      // markdown fleet; what reads the store lives in modules only a
      // conversation imports (transcript/composer-fleet.ts,
      // follow-sends.svelte.ts). Refused by
      // scripts/lint/reply-composer-no-fleet.grit.
      "includes": [
        "apps/dashboard/src/lib/cawco/transcript/Composer.svelte",
        "apps/dashboard/src/lib/cawco/transcript/composer-draft.svelte.ts",
        "apps/dashboard/src/lib/cawco/transcript/rows.ts",
        "apps/dashboard/src/lib/cawco/preview/CommentComposer.svelte",
        "apps/dashboard/src/lib/cawco/preview/PinCard.svelte",
      ],
      "plugins": ["./scripts/lint/reply-composer-no-fleet.grit"],
    },
    {
      // A sheet mounts the piece, not the app around it (design-explore
      // skill): a story, a sheet's fixture folder (`<piece>/preview/`) and a
      // folder preview's source import none of the live shell. The
      // dashboard's own preview pane (lib/cawco/preview) is the shell, and
      // only its stories are held to this.
      "includes": [
        "apps/dashboard/src/**/preview/**",
        "!apps/dashboard/src/lib/cawco/preview/**",
        "apps/dashboard/src/**/*.stories.ts",
        "scripts/**/preview/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // The fleet store by any of its names: `#lib/cawco/client.svelte(.js)`, `../client.svelte.js`.
                "patterns": [
                  {
                    "group": [
                      "**/cawco/client.svelte",
                      "**/cawco/client.svelte.js",
                      "./client.svelte",
                      "./client.svelte.js",
                      "../client.svelte",
                      "../client.svelte.js",
                    ],
                    "message": "The fleet store is the live app; a sheet takes its state as fixtures in args.",
                  },
                  {
                    // A member imports another member's file through its
                    // manifest (@cawco/<name>/…), never by a path into its
                    // folder, whatever the path's depth: the named-member
                    // line reads `../../agent/src/x`, which never says packages/. The CLI's `dashboard` starts the dashboard's
                    // own entry, which no manifest exports (its binary builds it).
                    "group": [
                      "**/packages/*/src/**",
                      "**/{agent,auth,cli,core,design-tokens,hub,icons,jsonl-parser,sessiond,cawrier,dashboard,site}/{src,scripts}/**",
                      "@cawco/*/src/**",
                      "**/apps/*/**",
                      "!**/apps/dashboard/serve.js",
                    ],
                    "message": "A member imports another's file through that member's manifest (@cawco/<name>/…), never by a path into its folder.",
                  },
                ],
                "paths": {
                  "$app/navigation": "The stage stubs $app/navigation; a story never needs it.",
                  "$app/state": "The stage stubs $app/state; a story never needs it.",
                  "$app/stores": "The stage stubs $app/stores; a story never needs it.",
                  "@cawco/core": "Core has no index: import the module that owns the name, like @cawco/core/stage.",
                },
              },
            },
          },
        },
      },
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          // Class order in markup stays the author's: Biome 2.6 sorts it
          // once Svelte markup is read (html.experimentalFullSupportEnabled),
          // which no check did before.
          "nursery": { "useTailwindSortedClasses": "off" },
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["PascalCase", "kebab-case"],
              },
            },
          },
        },
      },
      // The formatter owns a Svelte component's layout: "Use Prettier for code
      // formatting concerns, and linters for code-quality concerns"
      // (prettier.io/docs/integrating-with-linters). bun fmt prints Svelte as
      // prettier-plugin-svelte does, which puts `this=` first on
      // <svelte:element>; sorting attributes there undoes it on every run.
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": "off",
          },
        },
      },
    },
    {
      // Secure-context APIs may not be reached raw from dashboard code. The
      // dashboard is routinely served over plain http from a tailnet/LAN
      // address, where these properties are simply absent and every raw reach
      // throws. Each banned API has one audited wrapper that works everywhere;
      // new secure-context APIs join this list with a wrapper of their own,
      // never as raw call sites. Matched by property name on any object, so
      // `globalThis.crypto.randomUUID()` and `window.navigator.clipboard` are
      // caught the same as the bare forms.
      "includes": [
        "apps/dashboard/src/**",
        "!apps/dashboard/src/lib/cawco/id.ts",
        "!apps/dashboard/src/lib/cawco/copy.ts",
        "!apps/dashboard/src/lib/hooks/use-clipboard.svelte.ts",
        "!apps/dashboard/src/**/*.test.ts",
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noJsRestrictedProperties": {
              "level": "error",
              "options": {
                "entries": [
                  {
                    "property": "randomUUID",
                    "message": "Secure-context only — absent over plain http off localhost. Use newId() from $lib/cawco/id.",
                  },
                  {
                    "property": "clipboard",
                    "message": "Secure-context only. Use copyToClipboard() from $lib/cawco/copy, or the use-clipboard hook.",
                  },
                ],
              },
            },
          },
        },
      },
    },
  ],
}
