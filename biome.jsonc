{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/svelte"],
  // Law A: a read with a deadline goes through packages/core/src/bounded.ts.
  "plugins": ["./scripts/lint/no-raw-deadline.grit"],
  // Design mock-ups and their build scratch, not shipped code.
  // jsonl-parser is publishable and linted/formatted by oxlint/oxfmt instead.
  // drizzle/meta is drizzle-kit generate output, and CawCoAPI/openapi.json is
  // `bun run openapi`'s (packages/hub).
  // .design-foundations holds design artifacts; .mcp.json is local MCP config.
  "files": {
    // Biome skips a file past maxSize (1 MiB by default) as "ignored", so a
    // check passes without reading it: packages/hub/src/server.ts passed
    // 1 MiB on 2026-10-16 and went unlinted. Every file it lints is read.
    "maxSize": 2097152,
    "includes": [
      "!mocks",
      "!.design-foundations",
      "!.mcp.json",
      "!packages/jsonl-parser",
      "!packages/hub/drizzle/meta",
      // generated by packages/core/scripts/openui-views.ts (`bun run openui`).
      "!packages/core/src/views-spec.json",
      "!packages/core/src/decisions-spec.json",
      // DialKit's browser build and stylesheet, vendored unchanged.
      "!packages/hub/skills/decision-page/kit/vendor",
      // the decision-page template: {{KIT_CSS}}/{{KIT_JS}} slots src/decision-page.ts fills, not CSS or JS.
      "!packages/hub/skills/decision-page/kit/page.html",
      "!apps/apple/Packages/CawCoKit/Sources/CawCoAPI/openapi.json",
      // generated by apps/apple/scripts/targets-map.sh, held to it by its --check in the gate's build.
      "!apps/apple/targets.json",
      // generated by apps/apple/scripts/icons.ts from Iconify Solar and Logos.
      "!apps/apple/Packages/CawCoKit/Sources/CawCoDesign/Resources/Icons.xcassets",
      // generated by assets/mascot/scripts/trace.py (vtracer); input to scene.mjs, never rendered as SVG.
      "!assets/mascot/loops/*/body-*.svg",
      // the same drawings for the transition clips, by trace_clip.py.
      "!assets/mascot/clips/*/body-*.svg",
      // pages copied byte for byte from the owner's sessions: a spec reads them as he saw them.
      "!scripts/probe-kit/fixtures",
      // generated by apps/dashboard/scripts/build-tokens.ts, held to it by its --check, and
      // compiled by Tailwind there and in vite build. Its `@theme inline reference` block is
      // Tailwind 4 syntax Biome 2.5.15's parser rejects ("expected `{` but instead found
      // `reference`"); `@theme reference` alone parses but adds self-fallbacks to every utility.
      "!apps/dashboard/src/lib/tokens/theme.css",
    ],
  },
  // The dashboard's Tailwind theme, utilities and variants, which the
  // Tailwind rules read ("Biome reads the `@theme`, `@utility`, and
  // `@custom-variant` rules in this file and in the files it imports",
  // biomejs.dev/reference/configuration/#tailwind), and the class helpers
  // and recipes the dashboard writes classes in.
  "tailwind": {
    "stylesheet": "./apps/dashboard/src/app.css",
    "mergeFunctions": ["cn", "cx", "clsx", "twMerge", "twJoin", "classNames"],
    "variantFunctions": ["tv", "cva"],
  },
  // Biome lints; `bun fmt` formats (scripts/fmt.ts, .prettierrc). Each
  // language's formatter is off too: ultracite's preset turns them on one by one.
  "formatter": { "enabled": false },
  "javascript": {
    // Bun and HTMLRewriter: Bun's runtime globals (typed by @types/bun).
    // __CAWCO_COMMIT__: the dashboard's build commit, a `define` in
    // apps/dashboard/vite.config.ts.
    "globals": ["Bun", "HTMLRewriter", "__CAWCO_COMMIT__"],
    "formatter": { "enabled": false },
  },
  "json": { "formatter": { "enabled": false } },
  "css": { "formatter": { "enabled": false } },
  // Svelte markup is linted, not only its scripts ("Since full support is
  // still experimental, it must be enabled explicitly",
  // biomejs.dev/internals/language-support).
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": { "enabled": false },
  },
  // Both sorters can change what the code does: JS object key order is
  // observable through Object.keys/entries and JSON output, and a CSS
  // longhand moved after its logical shorthand (margin-left after
  // margin-inline) wins where it used to lose. Left off so a fix pass is
  // formatting and safe lint fixes, never a reorder.
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedProperties": "off",
      },
    },
  },
  // Every state is handled by the type-aware switch check instead
  // (scripts/lint/switch-exhaustiveness.ts, in Golar): a switch over a
  // union names each member, and a `default:` would hide the next member
  // added to it. A default stays only where the value can really be outside
  // its union at runtime (a verb or type off the wire, a plain string).
  "linter": {
    "rules": {
      "style": { "useDefaultSwitchClause": "off" },
      // A label wrapping a kit control wraps its input: each of these renders
      // one (ui/input, ui/textarea, ui/checkbox, ui/switch's button,
      // ui/native-select). The rule
      // reads no namespaced component, so a select is the barrel's plain
      // `NativeSelect` (biomejs.dev/linter/rules/no-label-without-control).
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "Input",
              "Textarea",
              "Checkbox",
              "Switch",
              "NativeSelect",
            ],
          },
        },
      },
    },
  },
  "overrides": [
    {
      // The design system's colour rule over the dashboard's markup and
      // scripts, moved from @shadcn/lint's no-raw-colors, which ran with no
      // options: Biome's takes the same ("Disallow Tailwind CSS utility
      // classes that use raw palette colors … It allows custom color names,
      // `black`, `white`, `transparent`, `current`, and `inherit`",
      // biomejs.dev/linter/rules/no-tailwind-raw-colors). The other design
      // rules run in Golar (golar.config.ts, scripts/lint/design): Biome's
      // nearest rules hold neither their options nor their reach.
      "includes": [
        "apps/dashboard/src/**/*.svelte",
        "apps/dashboard/src/**/*.ts",
      ],
      "linter": {
        "rules": {
          "nursery": { "noTailwindRawColors": "error" },
        },
      },
    },
    {
      // Biome 2.6.2's Tailwind class parser stops at the variant `delta--1:`
      // (lib/tokens/variants.css, `data-delta="-1"`): "Expected a value but
      // instead found '-'", a parse error that fails the file. No Tailwind
      // rule reads these two until it parses them.
      "includes": [
        "apps/dashboard/src/lib/cawco/workspace/PaneDeck.svelte",
        "apps/dashboard/src/lib/cawco/workspace/PaneLeaf.svelte",
      ],
      "linter": {
        "rules": {
          "nursery": { "noTailwindRawColors": "off" },
        },
      },
    },
    {
      // The browser may hand the dashboard no storage (null on a window
      // WebKit no longer displays, a SecurityError where it is blocked):
      // storage.ts is the one way to it, and keeps nothing then. app.html's
      // pre-paint scripts import nothing; each reads inside its own try.
      "includes": [
        "apps/dashboard/src/**",
        "!apps/dashboard/src/lib/cawco/storage.ts",
        "!apps/dashboard/src/app.html",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "Use $lib/cawco/storage: the browser may hand back no storage.",
                  "sessionStorage": "Use $lib/cawco/storage: the browser may hand back no storage.",
                  // An answer written inside a ResizeObserver's delivery that
                  // lays the page out again resizes boxes the delivery has
                  // passed ("ResizeObserver loop completed with undelivered
                  // notifications"). A site that must answer inside the
                  // delivery says why in its biome-ignore.
                  "ResizeObserver": "Use frameObserver ($lib/cawco/frame-observer): its answer comes in the next frame, so nothing it writes resizes a box inside the delivery.",
                },
              },
            },
          },
        },
      },
    },
    {
      // A rejection nobody handles ends the hub or sessiond (Bun's default),
      // so every promise there is awaited, returned, or handed to detach()
      // from @cawco/core/detach. `void` is not handling: noFloatingPromises
      // accepts it, so it is not used for promises in these packages.
      "includes": ["packages/hub/**", "packages/sessiond/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "error",
            "noMisusedPromises": "error",
          },
        },
      },
    },
    {
      // A sheet (live components) is named for the component it shows, beside
      // it: `Who.stories.ts` for `Who.svelte`, Component Story Format's own
      // convention. The name is checked before `.stories`, as the
      // component's is.
      "includes": ["**/*.stories.ts", "**/*.stories.js"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["PascalCase", "kebab-case"],
                "match": "(.+?)[.](stories)[.][jt]s",
              },
            },
          },
        },
      },
    },
    {
      // A sheet mounts the piece, not the app around it (design-explore
      // skill): a story, a sheet's fixture folder (`<piece>/preview/`) and a
      // folder preview's source import none of the live shell. The
      // dashboard's own preview pane (lib/cawco/preview) is the shell, and
      // only its stories are held to this.
      "includes": [
        "apps/dashboard/src/**/preview/**",
        "!apps/dashboard/src/lib/cawco/preview/**",
        "apps/dashboard/src/**/*.stories.ts",
        "scripts/**/preview/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // The fleet store by any of its names: `#lib/cawco/client.svelte(.js)`, `../client.svelte.js`.
                "patterns": [
                  {
                    "group": [
                      "**/cawco/client.svelte",
                      "**/cawco/client.svelte.js",
                      "./client.svelte",
                      "./client.svelte.js",
                      "../client.svelte",
                      "../client.svelte.js",
                    ],
                    "message": "The fleet store is the live app; a sheet takes its state as fixtures in args.",
                  },
                ],
                "paths": {
                  "$app/navigation": "The stage stubs $app/navigation; a story never needs it.",
                  "$app/state": "The stage stubs $app/state; a story never needs it.",
                  "$app/stores": "The stage stubs $app/stores; a story never needs it.",
                  "@cawco/core": "@cawco/core is every module of core; import the subpath you need, like @cawco/core/stage.",
                },
              },
            },
          },
        },
      },
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          // Class order in markup stays the author's: Biome 2.6 sorts it
          // once Svelte markup is read (html.experimentalFullSupportEnabled),
          // which no check did before.
          "nursery": { "useTailwindSortedClasses": "off" },
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["PascalCase", "kebab-case"],
              },
            },
          },
        },
      },
      // The formatter owns a Svelte component's layout: "Use Prettier for code
      // formatting concerns, and linters for code-quality concerns"
      // (prettier.io/docs/integrating-with-linters). bun fmt prints Svelte as
      // prettier-plugin-svelte does, which puts `this=` first on
      // <svelte:element>; sorting attributes there undoes it on every run.
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": "off",
          },
        },
      },
    },
    {
      // Secure-context APIs may not be reached raw from dashboard code. The
      // dashboard is routinely served over plain http from a tailnet/LAN
      // address, where these properties are simply absent and every raw reach
      // throws. Each banned API has one audited wrapper that works everywhere;
      // new secure-context APIs join this list with a wrapper of their own,
      // never as raw call sites. Matched by property name on any object, so
      // `globalThis.crypto.randomUUID()` and `window.navigator.clipboard` are
      // caught the same as the bare forms.
      "includes": [
        "apps/dashboard/src/**",
        "!apps/dashboard/src/lib/cawco/id.ts",
        "!apps/dashboard/src/lib/cawco/copy.ts",
        "!apps/dashboard/src/lib/hooks/use-clipboard.svelte.ts",
        "!apps/dashboard/src/**/*.test.ts",
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noJsRestrictedProperties": {
              "level": "error",
              "options": {
                "entries": [
                  {
                    "property": "randomUUID",
                    "message": "Secure-context only — absent over plain http off localhost. Use newId() from $lib/cawco/id.",
                  },
                  {
                    "property": "clipboard",
                    "message": "Secure-context only. Use copyToClipboard() from $lib/cawco/copy, or the use-clipboard hook.",
                  },
                ],
              },
            },
          },
        },
      },
    },
  ],
}
