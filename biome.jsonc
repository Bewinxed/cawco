{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/svelte"],
  // Design mock-ups and their build scratch, not shipped code.
  // jsonl-parser is publishable and linted/formatted by oxlint/oxfmt instead.
  // drizzle/meta is drizzle-kit generate output, and CawCoAPI/openapi.json is
  // `bun run openapi`'s (packages/hub).
  // .design-foundations holds design artifacts; .mcp.json is local MCP config.
  "files": {
    "includes": [
      "!mocks",
      "!.design-foundations",
      "!.mcp.json",
      "!packages/jsonl-parser",
      "!packages/hub/drizzle/meta",
      "!apps/apple/Packages/CawCoKit/Sources/CawCoAPI/openapi.json",
      // generated by apps/apple/scripts/icons.ts from Iconify Solar and Logos.
      "!apps/apple/Packages/CawCoKit/Sources/CawCoDesign/Resources/Icons.xcassets",
      // generated by assets/mascot/scripts/trace.py (vtracer); input to scene.mjs, never rendered as SVG.
      "!assets/mascot/loops/*/body-*.svg",
      // the same drawings for the transition clips, by trace_clip.py.
      "!assets/mascot/clips/*/body-*.svg"
    ]
  },
  "javascript": {
    // __CAWCO_COMMIT__: the dashboard's build commit, a `define` in
    // apps/dashboard/vite.config.ts.
    "globals": ["Bun", "__CAWCO_COMMIT__"]
  },
  // Both sorters can change what the code does: JS object key order is
  // observable through Object.keys/entries and JSON output, and a CSS
  // longhand moved after its logical shorthand (margin-left after
  // margin-inline) wins where it used to lose. Left off so a fix pass is
  // formatting and safe lint fixes, never a reorder.
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["PascalCase", "kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      // Secure-context APIs may not be reached raw from dashboard code. The
      // dashboard is routinely served over plain http from a tailnet/LAN
      // address, where these properties are simply absent and every raw reach
      // throws. Each banned API has one audited wrapper that works everywhere;
      // new secure-context APIs join this list with a wrapper of their own,
      // never as raw call sites. Matched by property name on any object, so
      // `globalThis.crypto.randomUUID()` and `window.navigator.clipboard` are
      // caught the same as the bare forms.
      "includes": [
        "apps/dashboard/src/**",
        "!apps/dashboard/src/lib/cawco/id.ts",
        "!apps/dashboard/src/lib/cawco/copy.ts",
        "!apps/dashboard/src/lib/hooks/use-clipboard.svelte.ts",
        "!apps/dashboard/src/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noJsRestrictedProperties": {
              "level": "error",
              "options": {
                "entries": [
                  {
                    "property": "randomUUID",
                    "message": "Secure-context only — absent over plain http off localhost. Use newId() from $lib/cawco/id."
                  },
                  {
                    "property": "clipboard",
                    "message": "Secure-context only. Use copyToClipboard() from $lib/cawco/copy, or the use-clipboard hook."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
