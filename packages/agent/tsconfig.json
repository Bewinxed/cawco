{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../.tsbuild/packages/agent"
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/canvas-host",
    "src/file-viewer",
    "src/in-page",
    "src/stage-host/canvas"
  ],
  "references": [
    { "path": "../core" },
    { "path": "../jsonl-parser" },
    { "path": "../preview" },
    { "path": "../hub" },
    { "path": "./src/in-page" }
  ]
}
