{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../.tsbuild/packages/agent"
  },
  "include": ["**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/canvas-host",
    "src/preview-overlay",
    "src/stage-host/canvas"
  ],
  "references": [{ "path": "../core" }, { "path": "../jsonl-parser" }]
}
