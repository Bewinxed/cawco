{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../.tsbuild/packages/hub"
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../core" },
    { "path": "../auth" },
    { "path": "../design-tokens" }
  ]
}
