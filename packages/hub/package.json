{
  "name": "@cawco/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "NODE_PATH=$PWD/node_modules bun node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "NODE_PATH=$PWD/node_modules CAWCO_DB_PATH=${CAWCO_DB_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/cawco-dev/cawco.db} bun node_modules/drizzle-kit/bin.cjs push",
    "dev": "CAWCO_NO_MDNS=1 CAWCO_DB_PATH=${CAWCO_DB_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/cawco-dev/cawco.db} bun --watch src/index.ts",
    "fixture-db": "bun scripts/fixture-db.ts",
    "fmt": "bun ../../scripts/fmt.ts .",
    "migrations:check": "bun scripts/migrations-check.ts",
    "openapi": "bun scripts/openapi.ts",
    "openapi:check": "bun scripts/openapi.ts --check",
    "roles:check": "bun scripts/role-budgets.ts",
    "route-types": "bun scripts/route-types.ts",
    "route-types:check": "bun scripts/route-types.ts --check",
    "skills:check": "bun scripts/skills-check.ts",
    "start": "CAWCO_NO_MDNS=1 CAWCO_DB_PATH=${CAWCO_DB_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/cawco-dev/cawco.db} bun src/index.ts",
    "stored-shapes": "bun scripts/stored-shapes.ts && bun scripts/stored-shapes.ts --dashboard",
    "stored-shapes:check": "bun scripts/stored-shapes.ts --check && bun scripts/stored-shapes.ts --check --dashboard",
    "stored-writes:check": "bun scripts/stored-writes-check.ts"
  },
  "dependencies": {
    "@cawco/auth": "workspace:*",
    "@cawco/core": "workspace:*",
    "@homebridge/ciao": "1.3.12",
    "@iconify-json/iconoir": "1.2.12",
    "@iconify-json/solar": "1.2.13",
    "@linear/sdk": "98.0.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@openuidev/lang-core": "1.0.1",
    "@secretlint/core": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/postcss": "4.3.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "browserslist": "4.29.3",
    "bun-plugin-svelte": "0.0.6",
    "colorjs.io": "^0.7.1",
    "cronstrue": "3.32.0",
    "drizzle-orm": "^0.45.3",
    "effect": "^4.0.0",
    "elysia": "2.0.0-rc.3",
    "exact-mirror": "^1.2.7",
    "image-size": "2.0.4",
    "lib0": "0.2.119",
    "lightningcss": "1.33.0",
    "postcss": "8.5.30",
    "re2js": "2.8.6",
    "rfc6902": "5.3.0",
    "style-dictionary": "^5.5.5",
    "svelte": "5.57.2",
    "tldts": "7.4.18",
    "turn-server": "0.8.0",
    "typebox": "^1.4.3",
    "unplugin-icons": "24.0.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@elysia/openapi": "2.0.0-rc.1",
    "@types/bun": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "7.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-json-schema": "0.68.0"
  }
}
