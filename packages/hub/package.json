{
  "name": "@cawco/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "dev": "CAWCO_NO_MDNS=1 bun --watch src/index.ts",
    "openapi": "bun scripts/openapi.ts",
    "openapi:check": "bun scripts/openapi.ts --check",
    "roles:check": "bun scripts/role-budgets.ts",
    "start": "CAWCO_NO_MDNS=1 bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cawco/auth": "workspace:*",
    "@cawco/core": "workspace:*",
    "@effect/sql-sqlite-bun": "4.0.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@openuidev/lang-core": "1.0.0",
    "ajv": "^8.20.0",
    "bonjour-service": "^1.4.4",
    "cronstrue": "3.32.0",
    "drizzle-orm": "^0.45.3",
    "effect": "^4.0.0",
    "elysia": "2.0.0-beta.23",
    "exact-mirror": "^1.2.6",
    "lib0": "0.2.119",
    "re2js": "2.8.6",
    "rfc6902": "5.3.0",
    "typebox": "^1.3.34",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@elysia/openapi": "2.0.0-beta.4",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-json-schema": "0.68.0"
  }
