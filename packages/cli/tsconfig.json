{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../../.tsbuild/packages/cli"
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../agent" },
    { "path": "../auth" },
    { "path": "../core" },
    { "path": "../hub" },
    { "path": "../jsonl-parser" },
    { "path": "../sessiond" }
  ]
}
