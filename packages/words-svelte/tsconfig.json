{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  // A leaf: the dashboard reads this package's source as its own, and
  // `bun run build` writes the published declarations (svelte-package).
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "incremental": true,
    "tsBuildInfoFile": "../../.tsbuild/packages/words-svelte/tsbuildinfo"
  },
  "include": ["src"]
}
