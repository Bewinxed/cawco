{
  "name": "@cawco/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./decisions-spec": "./src/decisions-spec.json",
    "./views-spec": "./src/views-spec.json",
    "./blocks-spec": "./src/blocks-spec.json",
    "./words/*": "./src/words/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "fmt": "bun ../../scripts/fmt.ts .",
    "openui": "OPENUI_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun scripts/openui-views.ts",
    "openui:check": "OPENUI_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 bun scripts/openui-views.ts --check",
    "pricing": "bun scripts/pricing-snapshot.ts",
    "tools": "bun scripts/tool-presentation.ts",
    "tools:check": "bun scripts/tool-presentation.ts --check"
  },
  "dependencies": {
    "@cawco/jsonl-parser": "workspace:*",
    "@octokit/rest": "22.0.1",
    "@openuidev/lang-core": "1.0.1",
    "fontkit": "2.0.4",
    "marked": "18.2.0",
    "pdfjs-dist": "6.5.438",
    "postcss": "8.5.30",
    "subset-font": "2.9.0",
    "tldts": "7.4.18",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "woff2-encoder": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/fontkit": "2.0.9",
    "@types/subset-font": "2.3.0"
  }
}
