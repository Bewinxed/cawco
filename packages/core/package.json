{
  "name": "@cawco/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./preview-proxy": "./src/preview-proxy.ts",
    "./paths": "./src/paths.ts",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./usage/limits": {
      "types": "./src/usage/limits.ts",
      "default": "./src/usage/limits.ts"
    },
    "./usage/opencode-go": {
      "types": "./src/usage/opencode-go.ts",
      "default": "./src/usage/opencode-go.ts"
    },
    "./usage/observed": {
      "types": "./src/usage/observed.ts",
      "default": "./src/usage/observed.ts"
    },
    "./sessiond": {
      "types": "./src/sessiond.ts",
      "default": "./src/sessiond.ts"
    },
    "./workflow-program": {
      "types": "./src/workflow-program.ts",
      "default": "./src/workflow-program.ts"
    },
    "./workflow-sandbox": {
      "types": "./src/workflow-sandbox.ts",
      "default": "./src/workflow-sandbox.ts"
    },
    "./workflow-worker": {
      "types": "./src/workflow-worker.ts",
      "default": "./src/workflow-worker.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
