language js

// The dashboard, the agent and the scripts take the hub's types alone (its
// routes, for their Eden clients: packages/hub/src/app.ts), never its code by
// package name: a value imported from the hub would put the server in a
// browser's bundle or the agent's binary. `import type` is erased in the
// build. A probe that runs a hub in process imports the hub's source by its
// path, which this rule does not read.
`import $clause from $source` as $hit where {
  $source <: r"[\"']@cawco/hub(?:/.*)?[\"']",
  not $hit <: `import type $_ from $_`,
  $filename <: or { includes "apps/dashboard/", includes "packages/agent/", r"(^|/)scripts/(probe-kit|binary|lib|decisions-preview)/.*", r"(^|/)scripts/[^/]+\.ts$" },
  register_diagnostic(span=$hit, message="Import the hub's types alone here (`import type`): its code never goes in the dashboard's bundle, the agent or a script.")
}
