language js

// An artifact's row goes one way: db/artifacts.ts `dropArtifactRows`,
// through db/artifacts.ts `artifactEvents`, which reads each id first (a held
// next version's too, which its foreign key cascades unseen) and tells
// `onArtifactsGone` once the write is done. That is what ends the
// artifact's preview origin (hub server.ts `endArtifactOrigin`); a delete
// of its own leaves the origin serving a row that is gone.
`$db.delete(artifacts)` as $hit where {
  $filename <: includes "packages/",
  $filename <: not includes "packages/hub/src/db/artifacts.ts",
  register_diagnostic(span=$hit, message="Delete artifacts with dropArtifacts (db/artifacts.ts), never delete(artifacts): it tells onArtifactsGone, which ends each one's preview origin.")
}
