language js

// A probe never takes a request's `last` for a tool's answer. When a message
// reaches the session while a call runs, Claude Code moves the call to the
// background: the request after it says so ("MCP tool … was moved to the
// background as task …"), and the call's result comes in a later turn's task
// notification. scripts/tool-calls.ts reads both (`ToolCalls`, the shared
// mock, and `ToolAnswer`), and is the one place that reads `last` for it.
// What lands in a binding, property, map or list named for an answer is the
// tool's answer.
or {
  JsAssignmentExpression(left=$target, right=$value) as $hit where {
    $target <: r"(?s).*[Aa]nswer.*"
  },
  JsVariableDeclarator(id=$target, initializer=JsInitializerClause(expression=$value)) as $hit where {
    $target <: r"(?s).*[Aa]nswer.*"
  },
  `$store.set($_, $value)` as $hit where {
    $store <: r"(?s).*[Aa]nswer.*"
  },
  `$store.push($value)` as $hit where {
    $store <: r"(?s).*[Aa]nswer.*"
  }
} where {
  $filename <: includes "scripts/",
  $filename <: not includes "scripts/tool-calls.ts",
  $value <: or { `$_.last`, `$_?.last`, `$_.last ?? $_`, `$_?.last ?? $_` },
  register_diagnostic(span=$hit, message="A request's `last` is no tool's answer: a call Claude Code moved to the background answers in a later turn. Read it through scripts/tool-calls.ts (ToolCalls, or ToolAnswer for a call of the spec's own).")
}
