language js

// What a workspace is (a clone, a folder overlay, a host-scope folder, a
// gate clone or a stage clone) is read off its row by workspaces.ts
// `workspaceOf`, the discriminated `Workspace`: its columns `host`,
// `checksFor` and `stageFor` are read there and in the db layer alone.
or {
  `$row.checksFor`,
  `$row.stageFor`,
  `$row.host` where { $row <: r"(?i).*workspace.*" }
} as $hit where {
  $hit <: not within or { `$_.stageFor($_)`, `$_.checksFor($_)` },
  $filename <: includes "packages/hub/src/",
  $filename <: not includes "packages/hub/src/workspaces.ts",
  $filename <: not includes "packages/hub/src/db/",
  register_diagnostic(span=$hit, message="Read what a workspace is through workspaceOf (workspaces.ts): its member, not its host, checksFor or stageFor column.")
}
