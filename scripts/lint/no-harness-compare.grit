language js

// A harness is a plugin, never a name: `=== "claude"`, `case "pi"`,
// `kinds.includes("opencode")` and `harness("claude")` are refused outside the
// plugin folders. What a harness is, the hub, core and the dashboard read from
// its descriptor (packages/core/src/harness/, registered in kinds.ts
// `HARNESS_PLUGINS`); what it does, the agent asks its adapter
// (packages/agent/src/harness.ts, registered in harnesses/index.ts). A new
// harness is one descriptor and one adapter, and the type-checker names
// whatever either one is missing (docs/harnesses.md). The two plugin folders
// are a harness naming itself.

pattern harness_name() {
  or { `"claude"`, `"opencode"`, `"pi"`, `'claude'`, `'opencode'`, `'pi'` }
}

pattern a_named_file() {
  or {
    includes "packages/agent/src/harnesses/",
    includes "packages/core/src/harness/"
  }
}

or {
  or { `$l === $r`, `$l !== $r`, `$l == $r`, `$l != $r` } as $hit where {
    $filename <: not a_named_file(),
    or { $l <: harness_name(), $r <: harness_name() },
    // The one compare that stays, with why: the binary tests' stand-in
    // adapters, which play Claude Code's part by name.
    not and { $filename <: includes "scripts/binary/test-harnesses.ts", or { $l <: `kind`, $r <: `kind` } },
    register_diagnostic(span=$hit, message="A harness name compared: read its descriptor (descriptorOf or traitsOf, packages/core/src/harness/) or ask its adapter (packages/agent/src/harness.ts). A compare that must stay is named in scripts/lint/no-harness-compare.grit, with why.")
  },
  JsCaseClause(test=$lit) as $hit where {
    $filename <: not a_named_file(),
    $lit <: harness_name(),
    register_diagnostic(span=$hit, message="A case on a harness name: read its descriptor or ask its adapter, so a new harness is one descriptor and one adapter.")
  },
  `$x.includes($lit)` as $hit where {
    $filename <: not a_named_file(),
    $lit <: harness_name(),
    register_diagnostic(span=$hit, message="A harness name looked for: read its descriptor or ask its adapter.")
  },
  `[$items].includes($v)` as $hit where {
    $filename <: not a_named_file(),
    $items <: contains harness_name(),
    register_diagnostic(span=$hit, message="A harness name in a list compared: read its descriptor or ask its adapter.")
  },
  // A lookup by name reads the name too. The daemon's left per harness are
  // its own beats (OpenCode's file watch and providers, pi's credential
  // check, Claude's re-read on a version answer and a keychain unlock), each
  // of which still needs a facet.
  or { `harness($lit)`, `harnessOf($lit)`, `traitsOf($lit)`, `descriptorOf($lit)` } as $hit where {
    $filename <: not a_named_file(),
    $lit <: harness_name(),
    $filename <: not includes "packages/agent/src/daemon.ts",
    register_diagnostic(span=$hit, message="A harness looked up by name: walk harnesses() or HARNESS_PLUGINS and read a facet, so a new harness is one descriptor and one adapter.")
  }
}
