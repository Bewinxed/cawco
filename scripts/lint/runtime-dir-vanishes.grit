language js

// The runtime dir ($XDG_RUNTIME_DIR, a tmpfs) and the session credentials'
// dir in it (core paths/cawco.ts `sessionIdentityDir`) are emptied by every
// reboot. On 2026-11-11 one took 32 OpenCode sessions: each account's
// OpenCode server kept its database in a data home there. Only what may
// vanish goes in them: a socket, or a credential that is short-lived. A store
// that must last (a harness's data home, a database, a conversation, settings,
// a session index) goes under the harness stores' root on disk (core
// paths/harnesses.ts `harnessStoresDir`).
//
// A tool cannot tell a store from a socket by its name, so the modules that
// put something there are named here, each with what it keeps:
//  - sessionIdentityDir(): the boundary's deny of it (paths/host-policy.ts),
//    OpenCode's session credentials (opencode-credentials.ts), Claude's MCP
//    configs with their bearers (claude-mcp-config.ts), the host key
//    (mcp-host.ts), the folder made before a boundary starts
//    (boundary/package-managers.ts), the 1.x plugin's account files removed
//    (provider-accounts.ts), and the OpenCode account homes and redaction
//    stores moved out of it (runtime-dir-move.ts);
//  - process.env.XDG_RUNTIME_DIR: sockets and the dirs around them (sessiond,
//    workspace doors, the hub's git credential, previews, container doors,
//    BlueZ proxies, ssh control sockets, srt's sandbox temp), the folder modes
//    (folders.ts), the runtime's own sockets looked for (activity.ts,
//    browser/runtime.ts), and the env handed to systemctl (service-manager/).
// A new one is added here only for something that may vanish.
or {
  `sessionIdentityDir()` as $hit where {
    $filename <: r".*packages/[^/]+/src/.*",
    $filename <: not r".*packages/(?:core/src/paths/(?:cawco|host-policy)|agent/src/(?:harnesses/opencode-credentials|runtime-dir-move|claude-mcp-config|mcp-host|boundary/package-managers|provider-accounts))\.ts$",
    register_diagnostic(span=$hit, message="sessionIdentityDir() is in the runtime dir, a tmpfs every reboot empties: only a credential that is short-lived goes there, from the modules scripts/lint/runtime-dir-vanishes.grit names. A store that must last goes under harnessStoresDir() (core paths/harnesses.ts).")
  },
  `process.env.XDG_RUNTIME_DIR` as $hit where {
    $filename <: r".*packages/[^/]+/src/.*",
    $filename <: not r".*packages/(?:core/src/(?:folders|sessiond|paths/(?:hub|workspace))|hub/src/ssh-tunnels|agent/src/(?:session-containers|activity|preview-bridge|service-manager/(?:install|keeper-job)|browser/(?:bluez-bus|runtime)|boundary/(?:stop|runner)))\.ts$",
    register_diagnostic(span=$hit, message="$XDG_RUNTIME_DIR is a tmpfs every reboot empties: only a socket or a credential that is short-lived goes there, from the modules scripts/lint/runtime-dir-vanishes.grit names. A store that must last goes under harnessStoresDir() (core paths/harnesses.ts).")
  }
}
