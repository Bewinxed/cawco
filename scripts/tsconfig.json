{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../.tsbuild/scripts/scripts.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"]
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": ["probe-kit", "lint/fixtures/biome"],
  "references": [
    { "path": "../packages/agent" },
    { "path": "../packages/agent/src/canvas-host" },
    { "path": "../packages/agent/src/preview-overlay" },
    { "path": "../packages/auth" },
    { "path": "../packages/cli" },
    { "path": "../packages/core" },
    { "path": "../packages/hub" },
    { "path": "../packages/jsonl-parser" },
    { "path": "../packages/sessiond" }
  ]
}
