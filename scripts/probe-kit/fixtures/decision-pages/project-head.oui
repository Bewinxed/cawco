root = Decisions("The project page's head and view strip", [seat, hue, glyph, count, capsule])
seat = Decision("seat", "Where does Caw sit at the top of a project page?", [row, inbar], "Both tops measure 152px tall at 1440, so moving the head into the bar saves no room, and the one-row head keeps the 48px seat you picked in the project-options round.", [], [], false)
row = Option("row", "One-row head", "Under the bar: the name, the place as a Linux mark, then Caw's 48px seat and one glass capsule of Ask Caw, Spin off and More. Nothing coral.", true, [rowDesk], "The head keeps a row of its own, 83px tall, under the bar.", false, "Nothing new: it is being built now on the project head branch.")
inbar = Option("inbar", "Head in the top bar", "No head: the name leads the bar before the views, Spin off and More end the strip after New task, and Caw stands alone on the page's axis.", false, [barDesk], "It moves the seat you picked, saves no height, and the name takes bar room the view tabs need before they fold into More.", false, "The bar's slot takes the name and two actions; the head being built is dropped; Caw's seat moves onto the page's axis.")
rowDesk = Preview("0df559ee-02d2-44e7-a671-8a3f85325ed7", "Desk", ["Desk"], 1212)
barDesk = Preview("3e119ce1-32b9-4145-a73a-7eb1eaf6ddd5", "Desk", ["Desk"], 1212)
hue = Decision("hue", "Which colour replaces the red identity mark?", [teal, crimson, darkred], "Start's coral runs down to oklch 0.525 at hue 33 by day and today's red mark is 0.51 at hue 27.9, so it reads as the action; teal at hue 160 sits 127 degrees from the coral at the same 51% and 70% every mark keeps.", [], [], false)
teal = Option("teal", "Teal", "Day oklch(0.51 0.11 160), night oklch(0.70 0.11 160), on your three running sessions that land on it.", true, [tealTiles], "It sits 27 degrees from the teal mark (186.7) and 20 degrees from the done green (140), so those tiles read as cousins.", false, "The first mark's token moves to hue 160 in both schemes.")
crimson = Option("crimson", "Crimson", "Day oklch(0.51 0.168 12), night oklch(0.70 0.17 12): still a red, 16 degrees further from the coral.", false, [crimsonTiles], "Beside Start it still reads red, and it is the error colour's own hue (15) at its lightness (50%), so a running session can look failed.", false, "The first mark's token moves to hue 12 in both schemes.")
darkred = Option("darkred", "Darker red", "Flexoki red-700 by day, oklch(0.447 0.145 27.8); night stays today's oklch(0.70 0.17 27.9).", false, [darkredTiles], "By day it reads as the coral button pressed, and it breaks the rule that every mark shares 51% lightness by day.", false, "The first mark's day value drops to 44.7%, an exception to the one-lightness rule.")
tealTiles = Preview("c46c8204-6257-4565-9b90-cbef08b149c9", "By day, then by night", ["Tiles"], 720)
crimsonTiles = Preview("ef5daf7a-dcde-40c7-80ca-a1e9344c0ba8", "By day, then by night", ["Tiles"], 720)
darkredTiles = Preview("f5d0e54b-3fa4-4291-912b-14565e5c4c69", "By day, then by night", ["Tiles"], 720)
glyph = Decision("glyph", "With the one-row head, which glyph is Ask Caw everywhere?", [chatadd, sparkles], "Plus already means New task in the same strip, and the icon set holds no mark of Caw's own; a speech bubble says what the press opens, a new thread with him.", [], ["seat"], false)
chatadd = Option("chatadd", "Chat-add", "A speech bubble, in the strip, the head's capsule and the phone's foot bar.", true, [chatBoth], "It is a plain chat glyph, the family Comments draws from, so it says less about Caw himself.", false, "The strip's and the foot bar's glyph become chat-add; the head's already is.")
chatBoth = Preview("f934164c-703b-499f-8030-5831841d8d20", "Desk, then Phone", ["Desk", "Phone"], 1212)
sparkles = Option("sparkles", "Sparkles", "The magic wand the strip uses today, in all three places.", false, [sparkBoth], "It is also one of the twelve session pictures, so a session's tile and Ask Caw can wear the same one.", false, "The head's capsule and the foot bar's glyph become sparkles.")
sparkBoth = Preview("820f59cb-9a92-4b1b-bc8f-5b8c645514ca", "Desk, then Phone", ["Desk", "Phone"], 1212)
count = Decision("count", "Should the Decisions tab's count wear the Needs you dot?", [dot, plain], "Where Decisions folds into More, More says the four waiting pages with the dot; a bare 4 on the tab makes the same four pages look like something else.", [], [], false)
dot = Option("dot", "Yes, the dot", "The tab's 4 takes the spark dot and the needs-you ink, as More's count does.", true, [dotBoth], "A second Needs you mark stands in the strip beside the Needs you filter on projects where tasks wait on you.", false, "The Decisions tab's count in the view tabs takes the Status dot and the attention ink.")
dotBoth = Preview("b6499294-d34a-4dd7-8114-ed2158c9275d", "Desk, then a narrow desk where Decisions folds into More", ["Wide", "Narrow"], 1212)
plain = Option("plain", "Keep the muted figure", "The tab keeps today's muted 4; only More wears the dot.", false, [plainBoth], "The same four pages read as a plain count on the tab and as waiting on you in More.", true, "Nothing: today's tab.")
plainBoth = Preview("19890354-e7a4-480f-8e64-094f48e69e6e", "Desk, then a narrow desk where Decisions folds into More", ["Wide", "Narrow"], 1212)
capsule = Decision("capsule", "With the one-row head, do the view strip's actions sit in a glass capsule?", [glass, loose], "The loose strip needs a hairline rule to part its actions from the tabs; a capsule parts them by its glass, as the bar's own group does with no dividers.", [], ["seat"], false)
glass = Option("glass", "In a capsule", "Filter, New task and Ask Caw sit in one capsule of the bar's glass at the strip's end.", true, [glassDesk], "Three capsules stand on one screen: the strip's, the bar's and the head's.", false, "The strip's actions wrap in the bar's glass recipe; the hairline rule goes.")
loose = Option("loose", "Loose bare symbols", "Filter, New task and Ask Caw stay bare symbols after a hairline rule.", false, [looseDesk], "The rule is a divider the bar's own group has none of, and the symbols read as more of the strip.", true, "Nothing: today's strip.")
glassDesk = Preview("42669c34-e632-4a8e-b387-a1150e40f67e", "Desk", ["Desk"], 1212)
looseDesk = Preview("598abc8b-352f-4c8e-9da2-299c4e1199d0", "Desk", ["Desk"], 1212)
