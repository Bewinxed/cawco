root = Decisions("The project page's head and view strip", [seat, hue, glyph, count, capsule])
seat = Decision("seat", "Where does Caw sit at the top of a project page?", [row, inbar], "Both desk tops measure 152px tall at 1440, so moving the head into the bar saves no room there, and the one-row head keeps the 48px seat you picked in the project-options round.", [seatShots], [], false)
row = Option("row", "One-row head", "Under the bar: the name, the place as a Linux mark, then Caw's 48px seat and one glass capsule of Ask Caw, Spin off and More. Nothing coral.", true, [], "On a phone the name is said twice, in the bar's title and in the head right under it; the head keeps a row of its own.", false, "Nothing new: it is being built now on the project head branch.")
inbar = Option("inbar", "Head in the top bar", "No head: on a desk the name leads the bar and Caw stands alone on the page's axis; on a phone the Linux mark follows the bar's title and More joins Caw in the bar's glass.", false, [], "It moves the seat you picked, saves no desk height, and on a phone the foot bar's Ask Caw becomes a second way to Caw beside his head in the bar.", false, "The bar takes the name, the place, Spin off and More; the head being built is dropped; Caw moves onto the page's axis.")
seatShots = Preview("45110313-7d24-4ea8-b4b6-d7a425767964", "One-row head on a desk, at 1037 with a task open, and on a phone; then the head in the bar, the same three", ["RowDesk", "Row1037", "RowPhone", "BarDesk", "Bar1037", "BarPhone"], 1212)
hue = Decision("hue", "Which colour replaces the red identity mark?", [teal, crimson, darkred], "Start's coral runs down to oklch 0.525 at hue 33 by day and today's red mark is 0.51 at hue 27.9, so it reads as the action; teal at hue 160 sits 127 degrees from the coral at the same 51% and 70% every mark keeps.", [hueShots], [], false)
teal = Option("teal", "Teal", "Day oklch(0.51 0.11 160), night oklch(0.70 0.11 160), on your three running sessions that land on it.", true, [], "It sits 27 degrees from the teal mark (186.7) and 20 degrees from the done green (140), so those tiles read as cousins.", false, "The first mark's token moves to hue 160 in both schemes.")
crimson = Option("crimson", "Crimson", "Day oklch(0.51 0.168 12), night oklch(0.70 0.17 12): still a red, 16 degrees further from the coral.", false, [], "Beside Start it still reads red, and it is the error colour's own hue (15) at its lightness (50%), so a running session can look failed.", false, "The first mark's token moves to hue 12 in both schemes.")
darkred = Option("darkred", "Darker red", "Flexoki red-700 by day, oklch(0.447 0.145 27.8); night stays today's oklch(0.70 0.17 27.9).", false, [], "By day it reads as the coral button pressed, and it breaks the rule that every mark shares 51% lightness by day.", false, "The first mark's day value drops to 44.7%, an exception to the one-lightness rule.")
hueShots = Preview("f07ec57c-61a8-4e97-be2b-8ab0d9adfd1c", "Teal, then crimson, then the darker red: each by day, then by night", ["Teal", "Crimson", "DarkRed"], 720)
glyph = Decision("glyph", "With the one-row head, which glyph is Ask Caw everywhere?", [chatadd, sparkles], "Plus already means New task in the same strip, and the icon set holds no mark of Caw's own; a speech bubble says what the press opens, a new thread with him.", [glyphShots], ["seat"], false)
chatadd = Option("chatadd", "Chat-add", "A speech bubble, in the strip, the head's capsule and the phone's foot bar.", true, [], "It is a plain chat glyph, the family Comments draws from, so it says less about Caw himself.", false, "The strip's and the foot bar's glyph become chat-add; the head's already is.")
sparkles = Option("sparkles", "Sparkles", "The magic wand the strip uses today, in all three places.", false, [], "It is also one of the twelve session pictures, so a session's tile and Ask Caw can wear the same one.", false, "The head's capsule and the foot bar's glyph become sparkles.")
glyphShots = Preview("60840189-b596-40dc-91b3-2326d67e94d6", "Chat-add on a desk and a phone, then sparkles on a desk and a phone", ["ChatDesk", "ChatPhone", "SparklesDesk", "SparklesPhone"], 1212)
count = Decision("count", "Should the Decisions tab's count wear the Needs you dot?", [dot, plain], "Where Decisions folds into More, More says the four waiting pages with the dot; a bare 4 on the tab makes the same four pages look like something else.", [countShots], [], false)
dot = Option("dot", "Yes, the dot", "The tab's 4 takes the spark dot and the needs-you ink, as More's count does.", true, [], "A second Needs you mark stands in the strip beside the Needs you filter on projects where tasks wait on you.", false, "The Decisions tab's count in the view tabs takes the Status dot and the attention ink.")
plain = Option("plain", "Keep the muted figure", "The tab keeps today's muted 4; only More wears the dot.", false, [], "The same four pages read as a plain count on the tab and as waiting on you in More.", true, "Nothing: today's tab.")
countShots = Preview("3a71c4b0-aca8-4f45-bfe6-8307edffc99d", "The dot, every view a tab, then a narrow desk where Decisions folds into More; then the muted figure, the same two", ["DotWide", "DotNarrow", "PlainWide", "PlainNarrow"], 1212)
capsule = Decision("capsule", "With the one-row head, do the view strip's actions sit in a glass capsule?", [glass, loose], "The loose strip needs a hairline rule to part its actions from the tabs; a capsule parts them by its glass, as the bar's own group does with no dividers.", [stripShots], ["seat"], false)
glass = Option("glass", "In a capsule", "Filter, New task and Ask Caw sit in one capsule of the bar's glass at the strip's end.", true, [], "Three capsules stand on one screen: the strip's, the bar's and the head's.", false, "The strip's actions wrap in the bar's glass recipe; the hairline rule goes.")
loose = Option("loose", "Loose bare symbols", "Filter, New task and Ask Caw stay bare symbols after a hairline rule.", false, [], "The rule is a divider the bar's own group has none of, and the symbols read as more of the strip.", true, "Nothing: today's strip.")
stripShots = Preview("a86c8c49-99ec-45b4-99e8-80bc484dc7ed", "In a capsule, then loose", ["Capsule", "Loose"], 1212)
