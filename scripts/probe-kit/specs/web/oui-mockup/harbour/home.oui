root = Stack([phone], false, "large")
phone = Device("phone", [screen], "Harbour")
screen = Stack([mark, title, photo, price, buy], false, "medium", "start", "start", "large")
mark = Image("wave", 48, "contain")
title = Text("Fresh catch", "title")
photo = Image("catch", 96, "cover")
price = PriceTag("$12.00", "sale", [Text("per kilo, landed this morning", "meta")])
buy = Button("Add to basket", "primary")
