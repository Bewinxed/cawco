{
  "css": ["tokens.css"],
  "roles": {
    "canvas": "var(--harbour-sand)",
    "surface": "light-dark(oklch(99% 0.01 85), oklch(28% 0.03 230))",
    "ink": "var(--harbour-ink)",
    "accent": "var(--harbour-sea)",
    "onAccent": "oklch(99% 0.01 85)",
    "fontBody": "var(--harbour-type)",
    "fontDisplay": "var(--harbour-type)",
    "radius": "1rem"
  },
  "assets": [
    { "name": "wave", "file": "assets/wave.svg", "alt": "Harbour's wave mark" },
    {
      "name": "catch",
      "file": "assets/catch.png",
      "alt": "The morning's catch"
    }
  ],
  "specimens": [
    {
      "name": "PriceTag",
      "description": "A price as Harbour's shop shows it, a note beside the amount.",
      "template": "specimens/price-tag.html",
      "props": {
        "amount": { "type": "string", "description": "Like \"$12.00\"." },
        "tone": { "type": "enum", "values": ["sale", "full"], "optional": true }
      }
    }
  ],
  "sources": {
    "--harbour-sea": "the shop's site, styles.css:12",
    "--harbour-type": "the brand guide, page 4"
  }
}
