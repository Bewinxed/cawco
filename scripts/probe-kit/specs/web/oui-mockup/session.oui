root = Stack([desk], false, "large")
desk = Device("desk", [page], "CawCo")
page = Stack([head, transcript, composer], false, "large", "stretch", "start", "large")
head = SessionRow("Fix tray chip overflow", "working", "cockpit · editing Tray.svelte", "4m", false, true)
transcript = Stack([ask, tools, answer], false, "medium")
ask = Message("you", "The tray chips overflow on a phone. Make them wrap under 400px.")
tools = ToolCalls([{tool: "Read", input: "apps/dashboard/src/lib/cawco/Tray.svelte"}, {tool: "Edit", input: "apps/dashboard/src/lib/cawco/Tray.svelte"}, {tool: "Bash", input: "bun run typecheck", result: "svelte-check: 0 errors"}])
answer = Message("agent", "The chips now wrap onto a second line under 400px, and the tray keeps its height.")
composer = Composer("", "Reply to Claude…", "Claude", true)
