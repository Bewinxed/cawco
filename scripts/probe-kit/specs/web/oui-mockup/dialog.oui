root = Stack([desk], false, "large")
desk = Device("desk", [states], "CawCo")
states = States(["Closed", "Open"], [screen, open])
screen = Stack([head, machine, notice, stop], false, "medium", "stretch", "start", "large")
head = SessionRow("Rebuild the token sheet", "working", "cockpit · bun run tokens", "12m", false, true)
machine = MachineRow("studio", "linux · 2 sessions", "online")
notice = Alert("Stopping ends the turn now; the session keeps its transcript.", "A turn is running")
stop = Button("Stop session", "danger")
open = Dialog("Stop this session?", [Text("Claude is in the middle of a turn. Stopping ends it now; the transcript stays.")], [Button("Keep working", "secondary"), Button("Stop", "danger")], screen)
