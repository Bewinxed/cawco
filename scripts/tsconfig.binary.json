{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "build-binary.ts",
    "release.ts",
    "binary/**/*.ts",
    "../packages/agent/src/binary-modules.d.ts"
  ]
}
