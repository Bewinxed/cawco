{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.paths.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../.tsbuild/apps/cawrier.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/core" }
  ]
}
