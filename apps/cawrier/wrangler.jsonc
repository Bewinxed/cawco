{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cawrier",
  // bewinxed@gmail.com's account, which holds the cawco.dev zone.
  "account_id": "7119532fe266e2a0493f558807a85bab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "cawrier.cawco.dev", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING", "class_name": "Pairing" },
      { "name": "SEATS", "class_name": "Seats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pairing"] },
    { "tag": "v2", "new_sqlite_classes": ["Seats"] },
    { "tag": "v3", "new_sqlite_classes": ["Experiment"] },
    // The paywall's A/B test is gone (owner: "No test: one paywall"): its counts go with it.
    { "tag": "v4", "deleted_classes": ["Experiment"] }
  ],
  "ratelimits": [
    {
      "name": "ENROLL_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "APNS_TOPIC": "dev.cawco.app",
    "PRO_PRODUCT_IDS": "dev.cawco.app.pro",
    // The free week: valid until its purchase date plus TRIAL_DAYS.
    "TRIAL_PRODUCT_ID": "dev.cawco.app.trial7",
    "TRIAL_DAYS": "7",
    // The App Store app record; Apple's verifier requires it for Production.
    "APP_APPLE_ID": "6819139448",
    // Apple allows one notification URL per app: every verified notification's
    // exact body goes on to Yield, the owner's revenue dashboard.
    "ASSN_FORWARD_URL": "https://yield.petralab.ai/api/asc/webhook"
  },
  // Secrets, set by hand: APNS_TEAM_ID, APNS_KEY_ID, APNS_P8.
  // No request logs: only the status codes and APNs reasons the code logs.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
