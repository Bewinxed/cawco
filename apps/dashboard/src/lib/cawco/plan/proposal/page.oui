root = Decisions("How a plan shows its steps", [plan, pins])
plan = Decision("plan", "How should a plan show its steps?", [oneList, lanes, crewFirst], "Recommended: Crew first, because it is the stack you asked for: which delegate is working on which step, and how far each has got, shows before you read a single step.")
oneList = Option("one-list", "One list", "Every step in order; a step opens in place to its description, and a step that waits says what it waits for.", false, [oneListShow], "With several delegates at work it is the longest list, and you read who works on what row by row.")
lanes = Option("lanes", "Lanes", "Steps that run at the same time stand side by side in columns, with a line from each step to the steps that wait for it; the line to a working delegate pulses.", false, [lanesShow], "Two columns squeeze each step to a few words a line, and on a phone a step opens on a page of its own.")
crewFirst = Option("crew-first", "Crew first", "Who needs you and who is working come first, each with a progress line that pulses while it moves; the to-dos below show who is on each.", true, [crewFirstShow], "A working delegate shows twice, at the top and on its to-do, and you change its step from the to-do, not from the top.")
oneListShow = Preview("0d0429d6-606f-48fa-89cf-dfbb05968c65", null, ["Device"])
lanesShow = Preview("02d5597b-58da-4157-be36-8806f1278d1d", null, ["Device"])
crewFirstShow = Preview("b8f93d08-75a2-4323-8ca8-11f50c8f662c", null, ["Device"])
pins = Decision("pins", "Fixed from your pins: does it look right now?", [looksRight, notYet], "You asked \"am i not able to click on these to expand and drill down and see the description of each ?\", \"glpyhs for task ids or?\", to \"make the lines pulse while they're progressing\" and for \"better animations\". A step now opens in place to its description; a to-do that became a task wears the task's glyph and its id; and a working delegate's line pulses, shown here at the start, middle and end of one run.", [pinsShow])
looksRight = Option("looks-right", "Looks right", "These stay as they are in whichever way you pick.", true, [], "Anything still off waits for the next round.")
notYet = Option("not-yet", "Not yet", "Say in the note what is still off, and it is fixed before the plan is built.", false, [], "The build waits a round.")
pinsShow = Preview("b8f93d08-75a2-4323-8ca8-11f50c8f662c", "A to-do opened to its description, one that became a task, with the task's glyph and id; then a working delegate's line at the start, middle and end of its pulse", ["Opened", "SweepStart", "SweepMiddle", "SweepEnd"])
