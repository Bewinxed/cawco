root = Decisions("How a plan shows its steps", [plan])
plan = Decision("plan", "How should a plan show its steps?", [oneList, lanes, crewFirst], "It is the stack you asked for: who works on what comes first, its line pulses only while it moves, and below it a line is drawn only for a dependency still open.")
oneList = Option("one-list", "One list", "Every step in order; a step opens in place to its description and says what it waits on.", false, [oneListShow], "The longest list once several delegates work, and who works on what is read row by row.")
lanes = Option("lanes", "Lanes", "A lane for steps that run side by side, a line to each step that waits, and a working delegate's line pulses.", false, [lanesShow], "On a phone two lanes squeeze the words while most plans need one, and a step opens on a page of its own.")
crewFirst = Option("crew-first", "Crew first", "Who needs you and who is working come first, each with a pulsing progress line; the to-dos below show who is on each.", true, [crewFirstShow], "A working delegate shows twice, and its step is changed from its to-do, not from the stack.")
oneListShow = Preview("0d0429d6-606f-48fa-89cf-dfbb05968c65", "Desk and phone")
lanesShow = Preview("02d5597b-58da-4157-be36-8806f1278d1d", "Desk and phone")
crewFirstShow = Preview("b8f93d08-75a2-4323-8ca8-11f50c8f662c", "Desk and phone")
