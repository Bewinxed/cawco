root = Decisions("How a plan shows its steps", [plan, pins])
plan = Decision("plan", "How should a plan show its steps?", [oneList, lanes, crewFirst], "Recommended: Crew first, because it is the stack you asked for: which delegate is working on which step, and how far each has got, shows before you read a single step.", [oneListShow, lanesShow, crewFirstShow])
oneList = Option("one-list", "One list", "Every step in order; a step opens in place to its description, and a step that waits says what it waits for.", false, [], "With several delegates at work it is the longest list, and you read who works on what row by row.")
lanes = Option("lanes", "Lanes", "Steps that run at the same time stand side by side in columns, with a line from each step to the steps that wait for it; the line to a working delegate pulses.", false, [], "Two columns squeeze each step to a few words a line, and on a phone a step opens on a page of its own.")
crewFirst = Option("crew-first", "Crew first", "Who needs you and who is working come first, each with a progress line that pulses while it moves; the to-dos below show who is on each.", true, [], "A working delegate shows twice, at the top and on its to-do, and you change its step from the to-do, not from the top.")
oneListShow = Preview("0d0429d6-606f-48fa-89cf-dfbb05968c65", "1 · One list", ["Device"])
lanesShow = Preview("02d5597b-58da-4157-be36-8806f1278d1d", "2 · Lanes", ["Device"])
crewFirstShow = Preview("b8f93d08-75a2-4323-8ca8-11f50c8f662c", "3 · Crew first", ["Device"])
pins = Section("Fixed from your pins", [pinsLead, pinOpen, pinTask, pinPulse, pinLook])
pinsLead = Text("If one still looks wrong, pin it.", "body")
pinOpen = Column([Text("“am i not able to click on these to expand and drill down and see the description of each ?”", "label"), Text("A step now opens in place to its description, its sub-steps and the delegate on it.", "body"), Preview("b8f93d08-75a2-4323-8ca8-11f50c8f662c", null, ["Opened"])])
pinTask = Column([Text("“glpyhs for task ids or?”", "label"), Text("A to-do that became a task now wears the task's glyph, its id and its stage.", "body"), Preview("b8f93d08-75a2-4323-8ca8-11f50c8f662c", null, ["Badge"])])
pinPulse = Column([Text("“make the lines pulse while they're progressing”", "label"), Text("A working delegate's line now pulses while it moves: a band of light runs along it, shown here at the start, middle and end of one run.", "body"), Preview("b8f93d08-75a2-4323-8ca8-11f50c8f662c", null, ["Pulse"])])
pinLook = Column([Text("“I'm sure you can do this design better, with better animations, lines, icons, and typography and layout”", "label"), Text("Each of these is redrawn, and shows in the drawings above:", "body"), Text("Tiles: every step leads with a bordered tile whose glyph says where it stands, in each drawing's first column.", "body"), Text("Lines: in Lanes, drawing 2, a line runs from each step to the steps that wait for it, and the line to a working delegate pulses.", "body"), Text("Icons: a to-do that became a task wears the task's glyph and its id, as tsk-14 does in the second fix above.", "body"), Text("Type: every row in one label size, its time in a column of figures at the row's end.", "body"), Text("Animation: a working delegate's line carries a band of light, the pulse above; a step opens in place.", "body")])
