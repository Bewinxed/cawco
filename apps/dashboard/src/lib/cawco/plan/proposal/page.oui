root = Decisions("How a plan shows its steps", [plan])
plan = Decision("plan", "How should a plan show its steps?", [oneList, lanes, crewFirst], "Crew first is the stack you asked for: who is working on which step shows first, without reading down the list, and it draws a line only to a step still waiting on another, where Lanes draws every one.", [oneListShow, lanesShow, crewFirstShow])
oneList = Option("one-list", "One list", "Every step in order; click a step to open its description, and a step that waits says what it waits for.", false, [], "With several delegates at work it is the longest list, and you read who works on what row by row.")
lanes = Option("lanes", "Lanes", "Steps that run at the same time sit side by side, with a line to each step that waits for them; the line to a working delegate pulses.", false, [], "On a phone two columns squeeze the words while most plans need one, and a step opens on a page of its own.")
crewFirst = Option("crew-first", "Crew first", "Who needs you and who is working come first, each with a progress line that pulses while it moves; the to-dos below show who is on each.", true, [], "A working delegate shows twice, at the top and on its to-do, and you change its step from the to-do, not from the top.")
oneListShow = Preview("0d0429d6-606f-48fa-89cf-dfbb05968c65", "One list, on the desk while it runs and on the phone", ["Live", "Phone"])
lanesShow = Preview("02d5597b-58da-4157-be36-8806f1278d1d", "Lanes, on the desk while it runs and on the phone", ["Live", "Phone"])
crewFirstShow = Preview("b8f93d08-75a2-4323-8ca8-11f50c8f662c", "Crew first, on the desk while it runs and on the phone", ["Live", "Phone"])
