root = Decisions("How the pairing screen behaves", [desk, phone, fixed])
desk = Section("Desk: the pairing screen", [wait, approved, expired])
phone = Section("Phone: the scanner", [scan])
wait = Decision("wait", "While the code waits to be scanned, what does it do?", [ping, ripple, sweep], "It's what you asked for: \"ping the qr code container itself while it's pending\". The spinner then belongs to the scan alone, so you can see the moment your phone reads it.")
ping = Option("ping", "The card pings", "Every two seconds a ring leaves the card's edge and fades; once a phone scans it, a spinner runs that edge instead.", true, [pingShow], "The quietest of the three: from across the room it can pass for still.")
ripple = Option("ripple", "Rings ripple from Caw", "Caw's head breathes and a ring spreads out over the dots, so Caw is the one waiting.", false, [rippleShow], "The ring crosses the code itself, brightening dots while a phone is trying to read them.")
sweep = Option("sweep", "A light rides the edge", "A lit segment circles the card and the dots glint as it passes.", false, [sweepShow], "It's the same spinner a scan shows, so the moment your phone reads the code looks like nothing happened.")
approved = Decision("approved", "When you approve, how does the code leave?", [swallow, fly], "The key goes to the one who minds the door, and its dots never cross the words above the card.")
swallow = Option("swallow", "Caw swallows the code", "The dots pour into Caw's head, inner ones first, the head gulps, Caw cheers and the dashboard opens.", true, [swallowShow], "Every dot moves at once, so a slow machine may skip a frame or two.")
fly = Option("fly", "The code flies up to Caw", "The whole card rises toward Caw at the top and shrinks away, then Caw cheers.", false, [flyShow], "On its way up the card passes over the title and the words under Caw.")
expired = Decision("expired", "When the code runs out, what comes next?", [park, refresh], "It's what you asked: the dead code falls apart, \"then prompt for another code\". A new one appears only when someone is there to scan it.")
park = Option("park", "A New code button", "The code drains away, the letters fall, and New code is the one thing on the screen.", true, [parkShow], "One more click before you can scan again.")
refresh = Option("refresh", "A new code by itself", "The code drains away and a fresh one shuffles straight back in while the page is on screen.", false, [refreshShow], "A screen left open keeps making codes nobody asked for, one every ten minutes.")
scan = Decision("scan", "When your phone scans a code, does that approve it?", [ask, instant], "Pairing gives a device the run of your fleet, so your phone shows the code it read and which device asked before it lets it in. One tap is cheap for that.")
ask = Option("ask", "Show the code, then ask", "The boxes fill with the code the phone read, then Deny or Approve.", true, [askShow], "One more tap every time you pair.")
instant = Option("instant", "A scan approves at once", "The boxes fill, turn the done colour, and the sheet closes.", false, [instantShow], "A code someone else puts in front of you is approved by one scan, with no chance to check it.")
fixed = Decision("pins", "Fixed from your pins: does it look right now?", [right, notyet], "You said: \"make the code line up with the qr code\", \"Green fill? Really?\", \"Layout shift bonanza\", \"These don't even line up\", \"Where's the background of the buttons?\", \"animate the actual qr code incoming\", \"why isn't caw reacting here?\", \"let them fall apart\", \"this screen doesn't tell at all that there's an error\". Each is on the screens below. On Denied the head in the middle still has today's face: its >< face is picked on your Caw takes page.", [deskShow, phoneShow, deniedShow])
right = Option("right", "Looks right", "These screens are done; only the picks above change them.", true, [], "Anything you spot later comes back as a new pin.")
notyet = Option("notyet", "Not yet", "Pin what's still wrong on the screens below.", false, [], "The open picks wait until the pins are fixed.")
pingShow = Preview("CANVAS", "Desk", ["Waiting", "Checking"])
rippleShow = Preview("CANVAS", "Desk", ["WaitingRipple", "Checking"])
sweepShow = Preview("CANVAS", "Desk", ["WaitingSweep", "Checking"])
swallowShow = Preview("CANVAS", "Desk", ["Approved"])
flyShow = Preview("CANVAS", "Desk", ["ApprovedFly"])
parkShow = Preview("CANVAS", "Desk", ["ExpiredParked"])
refreshShow = Preview("CANVAS", "Desk", ["Expired"])
askShow = Preview("CANVAS", "Phone", ["ScanMatchedAsk"])
instantShow = Preview("CANVAS", "Phone", ["ScanMatched"])
deskShow = Preview("CANVAS", "Desk", ["Asking", "Waiting", "LastMinute", "Checking", "Failed"])
phoneShow = Preview("CANVAS", "Phone", ["NeedsYou", "Scanner", "ScanNoMatch"])
deniedShow = Preview("CANVAS", "Desk", ["Denied"])
