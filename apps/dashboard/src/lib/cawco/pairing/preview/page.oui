root = Decisions("How the pairing screen behaves", [fixed, desk, phone])
fixed = Text("Fixed from your pins: the six boxes line up with the QR's edges, here and on the phone's scanner; the QR has round dots with Caw in the middle, and its dots shuffle into place as a code arrives; the boxes are grey with a thin edge, never filled green or red; a dead code falls apart while Caw and the words stay put; while the hub makes a code its dots drift in the card instead of a blank square; and when pairing can't start you see why and Try again, with no empty card.", "body")
desk = Section("Desk: the pairing screen", [wait, approved, expired, face])
phone = Section("Phone: the scanner", [scan])
wait = Decision("wait", "While the code waits to be scanned, what does it do?", [ping, ripple, sweep], "Recommended: The card pings, because it keeps waiting and scanning apart, as you asked: a ring while it waits (\"ping the qr code container itself while it's pending\"), and the light on the edge only once your phone has read it (\"a spinner … while it's scanning\").", [pingShow, rippleShow, sweepShow])
ping = Option("ping", "The card pings", "Once a breath, a ring leaves the card's edge and fades.", true, [], "Between rings the card stands still, so a glance at the wrong moment shows nothing moving.")
ripple = Option("ripple", "Rings ripple from Caw", "Caw's head breathes and a ring spreads out over the code.", false, [], "The ring crosses the dots while a phone is reading them.")
sweep = Option("sweep", "A light circles the edge", "A bright segment runs round the card's edge, and the dots glint as it passes.", false, [], "It's the light a scan shows, so your phone reading the code looks like nothing changed.")
approved = Decision("approved", "When you approve, how does the code leave?", [swallow, fly], "Recommended: Caw swallows the code, because its dots stay inside the card the whole way, so nothing passes over the words; the flying card crosses the title on its way up. Both end the same: Caw cheers and your dashboard opens.", [approvedShow])
swallow = Option("swallow", "Caw swallows the code", "The dots pour into Caw's head in the middle, the head gulps, and Caw at the top cheers.", true, [], "Every dot moves at once, so an old laptop may drop a frame.")
fly = Option("fly", "The code flies up to Caw", "The whole card rises toward Caw and shrinks away as he cheers.", false, [], "On its way up the card slides over the title.")
expired = Decision("expired", "When the code runs out, what comes next?", [park, refresh], "Recommended: A New code button, because a new code then appears only when someone is there to scan it, as you asked: \"why are you still showing the qr code if it's expired then? then prompt for another code\".", [parkShow, refreshShow])
park = Option("park", "A New code button", "The code drains away and New code is the one button left.", true, [], "One more click before you can scan again.")
refresh = Option("refresh", "A new code by itself", "The code drains away and a fresh one shuffles straight back in.", false, [], "A tab left open keeps making codes nobody asked for, one every ten minutes.")
face = Decision("face", "When your phone says no, what face does Caw's head in the code make?", [squeeze, wince], "Recommended: Squeezed shut, because its thick marks still read as a no at the size the head has in the code, where the wince's thin ones blur. Both now have their two marks level, on one line and one size, as your pin on the faces asked: \"these still don't line up!\"", [squeezeShow, winceShow])
squeeze = Option("squeeze", "Squeezed shut", "Thick, nearly flat > < pinched toward the middle.", true, [], "It reads as upset more than sorry.")
wince = Option("wince", "Wince", "Small, open, tilted > <.", false, [], "Its fine lines blur at the head's size in the code.")
scan = Decision("scan", "When your phone scans a code, does that approve it?", [ask, instant], "Recommended: Show the code, then ask, because pairing lets that device run your whole fleet, and seeing the code and the device's name first is your one chance to catch a code someone else put in front of you.", [askShow, instantShow])
ask = Option("ask", "Show the code, then ask", "The boxes fill with the code your phone read and the device asking, then you tap Deny or Approve.", true, [], "One more tap each time you pair.")
instant = Option("instant", "A scan approves at once", "The boxes fill with the code, and it's approved and the scanner closes with no tap.", false, [], "A code someone else shows you is approved the moment you scan it.")
approvedShow = Column([swallowShow, flyShow])
pingShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "The card pings, frozen three times in one breath", ["PingFrames"])
rippleShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Rings ripple from Caw, at the same three moments", ["RippleFrames"])
sweepShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "A light circles the edge, at the same three moments", ["SweepFrames"])
swallowShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Caw swallows the code, frozen three times in its first third of a second", ["SwallowFrames"])
flyShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "The code flies up to Caw, at the same three moments", ["FlyFrames"])
parkShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "A New code button, where it comes to rest", ["ExpiredParked"])
refreshShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "A new code by itself, where it comes to rest", ["Expired"])
squeezeShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Squeezed shut, in the code and enlarged", ["FaceSqueeze"])
winceShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Wince, in the code and enlarged", ["FaceWince"])
askShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Show the code, then ask", ["ScanMatchedAsk"])
instantShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "A scan approves at once", ["ScanMatched"])
