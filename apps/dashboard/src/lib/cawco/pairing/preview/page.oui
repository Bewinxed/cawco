root = Decisions("How the pairing screen behaves", [desk, phone, fixed])
desk = Section("Desk: the pairing screen", [wait, approved, expired])
phone = Section("Phone: the scanner", [scan])
wait = Decision("wait", "While the code waits to be scanned, what does it do?", [ping, ripple, sweep], "Your words: \"ping the qr code container itself while it's pending\", then a spinner on the edge \"while it's scanning\". The ping keeps those two apart: a ring while it waits, the spinner only once your phone has read the code.", [pingShow, rippleShow, sweepShow])
ping = Option("ping", "The card pings", "Every two seconds a ring leaves the card's edge and fades out.", true, [], "The quietest of the three: from across a room it can look still.")
ripple = Option("ripple", "Rings ripple from Caw", "Caw's head in the middle breathes and a ring spreads out across the code.", false, [], "The ring passes over the code's dots while a phone is trying to read them.")
sweep = Option("sweep", "A light circles the edge", "A bright segment runs round the card's edge and the dots glint as it passes.", false, [], "It's the same light a scan shows, so the moment your phone reads the code looks like nothing changed.")
approved = Decision("approved", "When you approve, how does the code leave?", [swallow, fly], "The dots move inward and stay inside the card the whole way, so nothing crosses the title above it. The flying card passes over the title on its way up to Caw.", [swallowShow, flyShow])
swallow = Option("swallow", "Caw swallows the code", "The dots pour into Caw's head in the middle, the head gulps, Caw at the top cheers and your dashboard opens.", true, [], "About 1,250 dots move at once, so an old laptop can drop a frame or two.")
fly = Option("fly", "The code flies up to Caw", "The whole card rises toward Caw at the top and shrinks away, then Caw cheers and your dashboard opens.", false, [], "On its way up the card slides over the title.")
expired = Decision("expired", "When the code runs out, what comes next?", [park, refresh], "Your words: \"why are you still showing the qr code if it's expired then? then prompt for another code\". With a button, a new code only appears when someone is there to scan it.", [parkShow, refreshShow])
park = Option("park", "A New code button", "The code drains away, the letters drop out, and New code is the one button left.", true, [], "One more click before you can scan again.")
refresh = Option("refresh", "A new code by itself", "The code drains away and a fresh one shuffles straight back in while the tab is on screen.", false, [], "A tab left open keeps making codes nobody asked for, a new one every ten minutes.")
scan = Decision("scan", "When your phone scans a code, does that approve it?", [ask, instant], "Pairing lets that device run your whole fleet. Showing the code and the device's name first is your one chance to catch a code someone else put in front of you, and it costs one tap.", [askShow, instantShow])
ask = Option("ask", "Show the code, then ask", "The boxes fill with the code your phone read and the device that asked, then you tap Deny or Approve.", true, [], "One more tap each time you pair.")
instant = Option("instant", "A scan approves at once", "The boxes fill, the letters turn green and the scanner closes.", false, [], "A code someone else shows you is approved the moment you scan it, with no chance to check.")
fixed = Decision("pins", "Your pins on these screens: are they fixed?", [done, off], "Read from the screens themselves: the six boxes line up with the card's edges to 0px at every width; every box has a grey fill and a thin edge, with no green fill anywhere; when a code dies, Caw and the words move 0px while the card folds from 304px to nothing; the dots start scattered and land on the code; and when pairing can't start there's no card or boxes, just why and Try again. On Denied the head in the middle still has today's face: its >< face is your pick on the Caw takes page.", [deskShow, phoneShow, deniedShow])
done = Option("fixed", "Fixed", "These screens are done; only the picks above still change them.", true, [], "Something you spot later comes back as a new pin.")
off = Option("off", "Still off", "Pin what's still wrong on the screens above.", false, [], "The picks above wait until your pins are fixed.")
pingShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk · The card pings", ["Waiting", "Checking"])
rippleShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk · Rings ripple from Caw", ["WaitingRipple", "Checking"])
sweepShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk · A light circles the edge", ["WaitingSweep", "Checking"])
swallowShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk · Caw swallows the code", ["Approved"])
flyShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk · The code flies up to Caw", ["ApprovedFly"])
parkShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk · A New code button", ["ExpiredParked"])
refreshShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk · A new code by itself", ["Expired"])
askShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Phone · Show the code, then ask", ["ScanMatchedAsk"])
instantShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Phone · A scan approves at once", ["ScanMatched"])
deskShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk", ["Asking", "Waiting", "LastMinute", "Checking", "Failed"])
phoneShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Phone", ["Scanner", "ScanNoMatch", "NeedsYou"])
deniedShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Desk · Denied", ["Denied"])
