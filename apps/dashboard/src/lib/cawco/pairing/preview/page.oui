root = Decisions("How the pairing screen behaves", [fixed, desk, phone])
fixed = Section("Fixed from your pins", [fixAsk, fixArrive, fixBreak, fixDenied, fixFailed, fixEnd])
fixAsk = Column([fixAskTitle, fixAskPin, fixAskNow, fixAskShow])
fixAskTitle = Text("No blank square while the hub makes a code", "title")
fixAskPin = Text("“why are you showing a blank square while nothing is going on?” · “make the code line up with the qr code” · “Green fill? Really?”", "label")
fixAskNow = Text("While the hub makes a code, its dots drift in the card instead of a blank square, over six grey boxes with a thin edge that share the card's edges.", "body")
fixAskShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "While the hub makes a code", ["Asking"])
fixArrive = Column([fixArriveTitle, fixArrivePin, fixArriveNow, fixArriveShow])
fixArriveTitle = Text("The code shuffles into place as it arrives", "title")
fixArrivePin = Text("“can't u creatively animate the actual qr code incoming? like the dots shuffling before arranging into place?”", "label")
fixArriveNow = Text("A code arrives as scattered dots that shuffle and lock into place: round dots with Caw in the middle, readable the moment they settle.", "body")
fixArriveShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Start: the dots appear scattered. Middle: they shuffle. End: they lock into the code.", ["ArriveFrames"])
fixBreak = Column([fixBreakTitle, fixBreakPin, fixBreakNow, fixBreakShow])
fixBreakTitle = Text("A dead code falls apart", "title")
fixBreakPin = Text("“here the qr code bits should animate and like fall apart”", "label")
fixBreakNow = Text("A dead code's dots burst out from the head and fall away, and Caw above it stays where he is.", "body")
fixBreakShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Start: the dots burst out from the head. Middle: they fall. End: the last of them drop away.", ["BreakFrames"])
fixDenied = Column([fixDeniedTitle, fixDeniedPin, fixDeniedNow, fixDeniedShow])
fixDeniedTitle = Text("When your phone says no, Caw reacts and nothing jumps", "title")
fixDeniedPin = Text("“caw should react accordingly … this says nothing about a denied state” · “Layout shift bonanza”", "label")
fixDeniedNow = Text("When your phone says no, the code is gone, Caw pleads, the screen says so and Start again is the one button. Caw and the words never move while the code leaves.", "body")
fixDeniedShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "When your phone says no, once the code has gone", ["Denied"])
fixFailed = Column([fixFailedTitle, fixFailedPin, fixFailedNow, fixFailedShow])
fixFailedTitle = Text("When pairing can't start, the screen says why", "title")
fixFailedPin = Text("“this screen doesn't tell at all that there's an error”", "label")
fixFailedNow = Text("When pairing can't start there's no card and no boxes: Caw, why it didn't start in one line, Try again, and the hub's own words under Show details.", "body")
fixFailedShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "When pairing can't start", ["Failed"])
fixEnd = Text("If one still looks wrong, pin it.", "body")
desk = Section("Desk: the pairing screen", [wait, approved, expired, face])
phone = Section("Phone: the scanner", [scan])
wait = Decision("wait", "While the code waits to be scanned, what does it do?", [ping, ripple, sweep], "Recommended: The card pings, because it keeps waiting and scanning apart, as you asked: a ring while it waits (\"ping the qr code container itself while it's pending\"), and the light on the edge only once your phone has read it (\"a spinner … while it's scanning\").", [pingShow, rippleShow, sweepShow])
ping = Option("ping", "The card pings", "Once a breath, a ring leaves the card's edge and fades.", true, [], "Between rings the card stands still, so a glance at the wrong moment shows nothing moving.")
ripple = Option("ripple", "Rings ripple from Caw", "Caw's head breathes and a ring spreads out over the code.", false, [], "The ring crosses the dots while a phone is reading them.")
sweep = Option("sweep", "A light circles the edge", "A bright segment runs round the card's edge, and the dots glint as it passes.", false, [], "It's the light a scan shows, so your phone reading the code looks like nothing changed.")
approved = Decision("approved", "When you approve, how does the code leave?", [swallow, fly], "Recommended: Caw swallows the code, because its dots stay inside the card the whole way, so nothing passes over the words; the flying card crosses the title on its way up. Both end the same: Caw cheers and your dashboard opens.", [approvedShow])
swallow = Option("swallow", "Caw swallows the code", "The dots pour into Caw's head in the middle, the head gulps, and Caw at the top cheers.", true, [], "Every dot moves at once, so an old laptop may drop a frame.")
fly = Option("fly", "The code flies up to Caw", "The whole card rises toward Caw and shrinks away as he cheers.", false, [], "On its way up the card slides over the title.")
expired = Decision("expired", "When the code runs out, what comes next?", [park, refresh], "Recommended: A New code button, because a new code then appears only when someone is there to scan it, as you asked: \"why are you still showing the qr code if it's expired then? then prompt for another code\".", [parkShow, refreshShow])
park = Option("park", "A New code button", "The code drains away and New code is the one button left.", true, [], "One more click before you can scan again.")
refresh = Option("refresh", "A new code by itself", "The code drains away and a fresh one shuffles straight back in.", false, [], "A tab left open keeps making codes nobody asked for, one every ten minutes.")
face = Decision("face", "When your phone says no, what face does Caw's head in the code make?", [squeeze, wince], "Recommended: Squeezed shut, because its thick marks still read as a no at the size the head has in the code, where the wince's thin ones blur. Both now have their two marks level, on one line and one size, as your pin on the faces asked: \"these still don't line up!\"", [faceShow])
squeeze = Option("squeeze", "Squeezed shut", "Thick, nearly flat > < pinched toward the middle.", true, [], "It reads as upset more than sorry.")
wince = Option("wince", "Wince", "Small, open, tilted > <.", false, [], "Its fine lines blur at the head's size in the code.")
scan = Decision("scan", "When your phone scans a code, does that approve it?", [ask, instant], "Recommended: Show the code, then ask, because pairing lets that device run your whole fleet, and seeing the code and the device's name first is your one chance to catch a code someone else put in front of you.", [askShow, instantShow])
ask = Option("ask", "Show the code, then ask", "The boxes fill with the code your phone read and the device asking, then you tap Deny or Approve.", true, [], "One more tap each time you pair.")
instant = Option("instant", "A scan approves at once", "The boxes fill with the code, and it's approved and the scanner closes with no tap.", false, [], "A code someone else shows you is approved the moment you scan it.")
approvedShow = Column([swallowShow, flyShow])
faceShow = Column([squeezeShow, winceShow])
pingShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "The card pings. Start: a ring leaves the card's edge. Middle: it grows. End: it fades out.", ["PingFrames"])
rippleShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Rings ripple from Caw, at the same moments. Start: a ring leaves the head. Middle: it crosses the dots. End: it nears the edge, fading.", ["RippleFrames"])
sweepShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "A light circles the edge, at the same moments: start, middle and end of its way round.", ["SweepFrames"])
swallowShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Caw swallows the code. Start: the middle dots pour into the head. Middle: half the code is in and Caw cheers. End: the last outer dots follow.", ["SwallowFrames"])
flyShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "The code flies up to Caw. Start: the card lifts off. Middle: it rises and shrinks. End: it fades as it nears Caw.", ["FlyFrames"])
parkShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "A New code button, a few seconds after the code ran out", ["ExpiredParked"])
refreshShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "A new code by itself, a few seconds after the code ran out", ["Expired"])
squeezeShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Squeezed shut, in the code and enlarged", ["FaceSqueeze"])
winceShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Wince, in the code and enlarged", ["FaceWince"])
askShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "Show the code, then ask", ["ScanMatchedAsk"])
instantShow = Preview("ca06ae75-f82b-4bd7-9ade-9ae17ffb60d5", "A scan approves at once", ["ScanMatched"])
