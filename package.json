{
  "name": "cawco",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "site"
  ],
  "scripts": {
    "agent": "bun run --filter '@cawco/agent' start",
    "apple-ops:check": "bun scripts/apple-ops-check.ts",
    "build": "bun run --filter '*' --filter '!cawco-site' build",
    "cawco": "bun packages/cli/src/cli.ts",
    "check": "bun scripts/check.ts",
    "claude-paths:check": "bun scripts/claude-paths-check.ts",
    "css-scope:check": "bun scripts/css-scope-check.ts",
    "db:push": "bun run --filter '@cawco/hub' db:push",
    "dev": "bun run dev:dashboard",
    "dev:agent": "bun run --filter '@cawco/agent' dev",
    "dev:all": "bun run --filter '*' --filter '!cawco-site' dev",
    "dev:dashboard": "bun run --filter '@cawco/dashboard' dev",
    "dev:hub": "bun run --filter '@cawco/hub' dev",
    "dupes": "jscpd",
    "duplicate-lists:check": "bun scripts/duplicate-lists-check.ts",
    "fmt": "bun scripts/fmt.ts",
    "hub": "bun run --filter '@cawco/hub' dev",
    "knip": "knip",
    "lint:fix": "bun scripts/real-modules.ts ultracite fix && bun scripts/fmt.ts",
    "machine-paths:check": "bun scripts/machine-paths-check.ts",
    "mark-line:check": "bun apps/dashboard/scripts/mark-line-check.ts",
    "outro-reads:check": "bun apps/dashboard/scripts/outro-reads-check.ts",
    "prepare": "bun scripts/git-hooks/install.ts",
    "protocol:sweep": "bun scripts/protocol-sweep.ts",
    "signal:check": "bun scripts/signal-check.ts",
    "token-alias:check": "bun scripts/token-alias-check.ts",
    "token-contrast:check": "bun scripts/token-contrast-check.ts",
    "typecheck:coverage": "bun scripts/typecheck-coverage.ts",
    "words": "bun scripts/words-swift.ts",
    "words:check": "bun scripts/words-swift.ts --check"
  },
  "overrides": {
    "@golar/darwin-arm64": "https://github.com/Bewinxed/golar/releases/download/v0.1.11-cawco.6/golar-darwin-arm64-0.1.11-cawco.6.tgz",
    "@golar/linux-x64": "https://github.com/Bewinxed/golar/releases/download/v0.1.11-cawco.6/golar-linux-x64-0.1.11-cawco.6.tgz",
    "@golar/svelte": "https://github.com/Bewinxed/golar/releases/download/v0.1.11-cawco.6/golar-svelte-0.1.11-cawco.6.tgz",
    "@types/bun": "^1.4.3",
    "golar": "https://github.com/Bewinxed/golar/releases/download/v0.1.11-cawco.6/golar-0.1.11-cawco.6.tgz",
    "oniguruma-to-es": "^4.3.6",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@biomejs/biome": "2.6.5",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@golar/svelte": "https://github.com/Bewinxed/golar/releases/download/v0.1.11-cawco.6/golar-svelte-0.1.11-cawco.6.tgz",
    "@terrazzo/parser": "^2.10.0",
    "@types/bun": "^1.4.3",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/ssh2": "^1.15.6",
    "bits-ui": "^2.20.6",
    "buffer": "^6.0.3",
    "colorjs.io": "^0.7.1",
    "events": "^3.3.0",
    "golar": "https://github.com/Bewinxed/golar/releases/download/v0.1.11-cawco.6/golar-0.1.11-cawco.6.tgz",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "multicast-dns": "7.2.5",
    "oxc-parser": "0.155.0",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "process": "^0.11.10",
    "punycode": "^2.3.1",
    "ssh2": "^1.17.0",
    "string_decoder": "^1.3.0",
    "svelte": "5.57.2",
    "type-fest": "^5.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.1.0",
    "undici-types": "^8.9.0",
    "vfile": "^6.0.3",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "patchedDependencies": {
    "vaul-svelte@1.0.0-next.7": "patches/vaul-svelte@1.0.0-next.7.patch",
    "bits-ui@2.20.6": "patches/bits-ui@2.20.6.patch",
    "openai@7.19.0": "patches/openai@7.19.0.patch",
    "@anthropic-ai/sdk@0.129.0": "patches/@anthropic-ai%2Fsdk@0.129.0.patch",
    "postcss-selector-parser@7.1.6": "patches/postcss-selector-parser@7.1.6.patch",
    "virtua@0.54.1": "patches/virtua@0.54.1.patch",
    "@excalidraw/excalidraw@0.18.1": "patches/@excalidraw%2Fexcalidraw@0.18.1.patch",
    "torph@0.1.3": "patches/torph@0.1.3.patch"
  },
  "trustedDependencies": [
    "socket-activation"
  ]
}
