{
  "name": "cawco",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent": "bun run --filter '@cawco/agent' start",
    "build": "bun run --filter '*' build",
    "cawco": "bun packages/cli/src/cli.ts",
    "db:push": "bun run --filter '@cawco/hub' db:push",
    "dev": "bun run dev:dashboard",
    "dev:agent": "bun run --filter '@cawco/agent' dev",
    "dev:all": "bun run --filter '*' dev",
    "dev:dashboard": "bun run --filter '@cawco/dashboard' dev",
    "dev:hub": "bun run --filter '@cawco/hub' dev",
    "hub": "bun run --filter '@cawco/hub' dev",
    "lint": "ultracite check",
    "lint:changed": "git diff --name-only --diff-filter=ACMR HEAD | xargs -r bunx biome check",
    "lint:fix": "ultracite fix",
    "release:build": "bun scripts/build-release.mjs",
    "release:pack": "bun scripts/build-release.mjs && cd release && npm pack",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "overrides": {
    "@types/bun": "latest",
    "oniguruma-to-es": "^4.3.6",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "torph": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.2"
  },
  "trustedDependencies": [
    "socket-activation"
  ]
}
