{
  "name": "cawco",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "site"
  ],
  "scripts": {
    "agent": "bun run --filter '@cawco/agent' start",
    "apple-ops:check": "bun scripts/apple-ops-check.ts",
    "build": "bun run --filter '*' --filter '!cawco-site' build",
    "cawco": "bun packages/cli/src/cli.ts",
    "claude-paths:check": "bun scripts/claude-paths-check.ts",
    "css-scope:check": "bun scripts/css-scope-check.ts",
    "db:push": "bun run --filter '@cawco/hub' db:push",
    "dev": "bun run dev:dashboard",
    "dev:agent": "bun run --filter '@cawco/agent' dev",
    "dev:all": "bun run --filter '*' --filter '!cawco-site' dev",
    "dev:dashboard": "bun run --filter '@cawco/dashboard' dev",
    "dev:hub": "bun run --filter '@cawco/hub' dev",
    "hub": "bun run --filter '@cawco/hub' dev",
    "lint": "bun scripts/case-clash-check.ts && bun scripts/css-scope-check.ts && bun apps/dashboard/scripts/mark-line-check.ts && bun apps/dashboard/scripts/lib-import-check.ts && bun scripts/fmt.ts --check && ultracite check",
    "lint:changed": "bun scripts/case-clash-check.ts && bun scripts/css-scope-check.ts && bun apps/dashboard/scripts/mark-line-check.ts && bun apps/dashboard/scripts/lib-import-check.ts && bun scripts/fmt.ts --check --changed && { git diff --name-only --diff-filter=ACMR \"$(git merge-base HEAD origin/main)\"; git ls-files --others --exclude-standard; } | sort -u | xargs -r biome check --no-errors-on-unmatched",
    "lint:fix": "ultracite fix && bun scripts/fmt.ts",
    "machine-paths:check": "bun scripts/machine-paths-check.ts",
    "mark-line:check": "bun apps/dashboard/scripts/mark-line-check.ts",
    "prepare": "bun scripts/git-hooks/install.ts",
    "protocol:sweep": "bun scripts/protocol-sweep.ts",
    "signal:check": "bun scripts/signal-check.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "typecheck:coverage": "bun scripts/typecheck-coverage.ts",
    "words": "bun scripts/words-swift.ts",
    "words:check": "bun scripts/words-swift.ts --check"
  },
  "overrides": {
    "@types/bun": "^1.4.3",
    "oniguruma-to-es": "^4.3.6",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "19.3.0",
    "torph": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/ssh2": "^1.15.6",
    "@typescript/native": "npm:typescript@~7.0.2",
    "axe-core": "^4.14.0",
    "bits-ui": "^2.19.5",
    "drizzle-orm": "^0.45.3",
    "multicast-dns": "7.2.5",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "react": "19.3.0",
    "ssh2": "^1.17.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.2"
  },
  "trustedDependencies": [
    "socket-activation"
  ]
}
