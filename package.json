{
  "name": "whiffle",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent": "bun run --filter '@whiffle/agent' start",
    "build": "bun run --filter '*' build",
    "db:push": "bun run --filter '@whiffle/hub' db:push",
    "dev": "bun run dev:dashboard",
    "dev:agent": "bun run --filter '@whiffle/agent' dev",
    "dev:all": "bun run --filter '*' dev",
    "dev:dashboard": "bun run --filter '@whiffle/dashboard' dev",
    "dev:hub": "bun run --filter '@whiffle/hub' dev",
    "hub": "bun run --filter '@whiffle/hub' dev",
    "lint": "ultracite check",
    "lint:changed": "git diff --name-only --diff-filter=ACMR HEAD | xargs -r bunx biome check",
    "lint:fix": "ultracite fix",
    "release:build": "bun scripts/build-release.mjs",
    "release:pack": "bun scripts/build-release.mjs && cd release && npm pack",
    "typecheck": "bun run --filter '*' typecheck",
    "whiffle": "bun packages/cli/src/cli.ts"
  },
  "overrides": {
    "@types/bun": "latest",
    "oniguruma-to-es": "^4.3.6",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "torph": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "latest",
    "@types/node": "^22.19.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "ultracite": "7.10.7"
  },
  "patchedDependencies": {
    "svelte-streamdown@3.1.2": "patches/svelte-streamdown@3.1.2.patch",
    "virtua@0.50.0": "patches/virtua@0.50.0.patch",
    "dialkit@2.0.0": "patches/dialkit@2.0.0.patch"
  },
  "trustedDependencies": [
    "socket-activation"
  ]
}
