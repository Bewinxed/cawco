{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", ".cutover/*.ts"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.svelte-kit",
    "apps/cawrier",
    "apps/dashboard",
    "packages",
    "scripts",
    "site"
  ]
}
