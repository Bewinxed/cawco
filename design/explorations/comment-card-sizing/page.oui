root = Decisions("How a comment opens", [size, tablet])
size = Decision("thread-size", "How big should a comment be when it opens, on each screen?", [reading, short, panel], "On your screen with Comments open, the first answer reads a long reply at the width Google Docs lets its comments grow to, and keeps it next to what it is about.")
reading = Option("reading", "Beside the comment", "The comment opens next to what you commented on, as wide as a Google Docs comment at its widest, and runs down the page as far as there is room. Its title and the reply box stay put while a long reply scrolls between them. From Google Docs and tldraw.", true, [readingMedia], "A long reply makes the card almost as tall as the page and covers the page beside it. On a tablet with Comments open there is no room beside it, so it opens as a drawer at the bottom (the next question).")
short = Option("short", "Small card, long ones in Comments", "A short exchange stays in a small card next to what you commented on, showing its first and last message, with one press for the rest. A long one opens in the Comments list, which widens to hold it. On your screen that looks like the panel; it differs on short exchanges and on a phone, where the list opens the comment in place. From Notion and Mattermost.", false, [shortMedia], "A long reply leaves what it is about for the list, and the wider list takes more of the page. On a phone the reply gets a small part of the drawer.")
panel = Option("panel", "A panel on the right", "Every comment opens in one panel on the right, as tall as the page, and you drag its edge to make it wider or narrower. The card next to the page is only for writing a new comment. On your screen it looks like the Comments list holding the comment; it differs in its draggable edge and on a phone, where the comment has the drawer to itself. From Crit and Glance.", false, [panelMedia], "No comment ever opens next to what it is about: posting one sends you to the panel, which replaces the Comments list. On a tablet the panel covers the right side of the page, the comment's spot included.")
readingMedia = Preview("b9b09f77-c5ec-416b-b79c-8cc9c7e21744", null, ["DeskListOpen", "Phone"], 1320)
shortMedia = Preview("9a5d35f3-751a-4902-8f8e-9250979d2489", null, ["DeskListOpen", "Phone"], 1320)
panelMedia = Preview("cd60e3e8-a370-48f2-b3c1-f62105666dab", null, ["DeskListOpen", "Phone"], 1320)
tablet = Decision("tablet-list", "With the Comments list open on a tablet, where does a comment open?", [sheet, closeList], "This matters only with the first answer above; the other two already put a tablet's comment in the list or a panel. On an iPad or any touch tablet the comment is always a drawer at the bottom whatever the width, so this decides only a narrow window used with a mouse. The drawer is wider than the card would be, and the list you opened stays where you left it.", [], ["thread-size"])
sheet = Option("sheet", "A drawer at the bottom", "The comment opens across the bottom of the page, wider than a card, with the spot you commented on still in view above it. The list stays open beside it.", true, [sheetMedia], "The drawer covers most of the page while it is open.")
closeList = Option("close-list", "Close the list while it is open", "The list closes so the comment can open next to its spot, and comes back when you close the comment. Resolve and Delete move into the More menu to fit.", false, [closedMedia], "The list you opened goes away without you closing it, and the card is narrower than the drawer.")
sheetMedia = Preview("b9b09f77-c5ec-416b-b79c-8cc9c7e21744", null, ["TabletListOpen"], 820)
closedMedia = Preview("b9b09f77-c5ec-416b-b79c-8cc9c7e21744", null, ["TabletListClosed"], 820)
