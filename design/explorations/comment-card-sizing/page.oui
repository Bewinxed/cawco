root = Decisions("How big a comment's thread is", [size, tablet])
size = Decision("thread-size", "How should a comment's thread size on each screen?", [reading, short, panel], "At your 1357px screen with Comments open the reading card measures 414px, about 50 characters a line, the width Google Docs lets its comments grow to, and it stays beside the comment it answers.")
reading = Option("reading", "Reading card", "The thread stays beside its comment at two fifths of the page's width: 414px on your screen, 480px with Comments shut. It runs as tall as the room below the pill, and the head and reply stay put while the answer scrolls. From Google Docs and tldraw.", true, [readingMedia], "A long answer makes the card nearly as tall as the page (909px here), covering the page beside the pin. On a tablet with Comments open it can't fit beside the pin, so it needs the second question below.")
short = Option("short", "Short card, long threads in Comments", "A short thread stays a 320px card showing its first and last messages, with one press for the rest. A long one opens in the Comments list, which widens to 400px and shows 1002px of the answer at once. From Notion and Mattermost.", false, [shortMedia], "A long thread leaves its comment and moves to the list, and the wider list takes 80px more from the page. On a phone the opened thread gets 236px for the answer.")
panel = Option("panel", "Thread panel", "Every thread reads in one panel at the screen's end, 400px wide and full height, and you can drag it from 300px to half the screen. The card by the pill is only for writing a new comment, at 280px. From Crit and Glance.", false, [panelMedia], "No thread ever stands beside its comment: posting sends you to the panel, which replaces the Comments list. On a tablet the panel is a sheet that covers the spot you commented on.")
readingMedia = Preview("b9b09f77-c5ec-416b-b79c-8cc9c7e21744", null, ["DeskListOpen", "DeskListClosed", "TabletListOpen", "Phone"], 1357)
shortMedia = Preview("9a5d35f3-751a-4902-8f8e-9250979d2489", null, ["DeskShortThread", "DeskListOpen", "DeskListClosed", "TabletListOpen", "Phone"], 1357)
panelMedia = Preview("cd60e3e8-a370-48f2-b3c1-f62105666dab", null, ["DeskComposing", "DeskListOpen", "DeskListClosed", "TabletListOpen", "Phone"], 1357)
tablet = Decision("tablet-list", "With the Comments list open on a tablet, where does a thread open?", [sheet, closeList], "This only matters with the reading card: the other two already send a tablet's thread to the list or a side sheet. The sheet is 499px wide against the card's 328px, and the list you opened stays where you left it.", [], ["thread-size"])
sheet = Option("sheet", "A sheet at the page's foot", "The thread opens across the bottom of the page, 499px wide and 826px tall, with the pill still in view above it. The list stays open beside it.", true, [sheetMedia], "The sheet covers about 70% of the page, from below the pill down, while it is open.")
closeList = Option("close-list", "Close the list while a card is open", "The list closes so the card can stand beside its pill, 328px wide, and comes back when the card closes. Resolve and Delete move into the card's More menu at that width.", false, [closedMedia], "The list you opened goes away without you closing it, and the card is 171px narrower than the sheet.")
sheetMedia = Preview("b9b09f77-c5ec-416b-b79c-8cc9c7e21744", null, ["TabletListOpen"], 820)
closedMedia = Preview("b9b09f77-c5ec-416b-b79c-8cc9c7e21744", null, ["TabletListClosed"], 820)
