root = Decisions("The project page, redrawn", [pane, card, pipeline, placement, look, fixed], "Five choices, in the order the rest depend on them. Each option is the real component; switch its states, phone and dark mode inside it.")
pane = Decision("pane", "How is the task pane built?", [paneunit, panetoday], "Recommended: one unit, because it answers your pins in one move: the stage said once, the session readable in place, every move from the foot.", [])
paneunit = Option("one-unit", "One unit with tabs", "Title, one row of chips, one session row, then Review, Session, Details and Activity; the decision pinned at the foot with More.", true, [paneunitcost, paneunitview])
paneunitcost = Text("Costs: the Created and Updated dates leave the head for Activity, and the session opens in a tab rather than beside the pane.", "meta")
paneunitview = Preview("@pane-one-unit")
panetoday = Option("keep", "Keep today's pane", "The facts line, a Review and Details switch, the session opened beside it.", false, [panetodaycost, panetodayview])
panetodaycost = Text("Costs: the stage is still said twice while a session works, and the session needs a second pane.", "meta")
panetodayview = Preview("@pane-today")
card = Decision("card", "How does a board card say its status?", [cardline, cardtoday], "Recommended: one line, because the column already says the stage, so a quiet card can mean a healthy card.", [], ["pane"])
cardline = Option("state-line", "One state line", "The title first and larger, then one line led by the session's mark or one glyph, then the facts; no badges.", true, [cardlinecost, cardlineview])
cardlinecost = Text("Costs: labels become words instead of chips, and a card in Review or Done carries no line at all.", "meta")
cardlineview = Preview("@card-state-line")
cardtoday = Option("keep", "Keep today's card", "The id first, badges at the head for Failed and Can't start, small marks in the foot.", false, [cardtodaycost, cardtodayview])
cardtodaycost = Text("Costs: the marks stay too small to read, and six kinds of mark share one card.", "meta")
cardtodayview = Preview("@card-today")
pipeline = Decision("pipeline", "What is the Pipeline tab for?", [runorder, removed], "Recommended: the run order, because the board cannot show what a task waits on past a lock and one id, and this can.", [], ["card"])
runorder = Option("run-order", "The run order", "What runs now, what is stuck, what comes next and what it waits on; done tasks folded away.", true, [runordercost, runorderview])
runordercost = Text("Costs: one more view to keep true as tasks gain and lose their waits.", "meta")
runorderview = Preview("@pipeline-run-order")
removed = Option("remove", "Remove the tab", "Board, Table, Routines and Decisions; the board's column heads already count each stage.", false, [removedcost, removedview])
removedcost = Text("Costs: nowhere shows the order tasks will run in, or what holds each one.", "meta")
removedview = Preview("@pipeline-removed")
placement = Decision("placement", "Where does empty and starter content stand?", [column, startedge], "Recommended: the work column, because it is neither centred lines nor a block pushed against the edge: it stands where the composer and the first message will.", [])
column = Option("work-column", "On the work column", "Caw, the title, the line and the starters on one start edge, in the composer's column centred in the page; every starter card one size.", true, [columncost, columnview])
columncost = Text("Costs: on a wide screen there is paper either side of the column, as there is around the composer.", "meta")
columnview = Preview("@empty-work-column")
startedge = Option("keep", "Keep today's placement", "Each surface's own box against the page's start edge; Caw's panel lists starters as wide as their words.", false, [startedgecost, startedgeview])
startedgecost = Text("Costs: three different widths for one kind of content, and starters of three different sizes.", "meta")
startedgeview = Preview("@empty-today")
look = Decision("new-session", "How does New session look beside Ask Caw?", [outlined, coral], "Recommended: outlined, so Ask Caw stays the one coral action in the head, as coral marks where you act.", [lookview])
lookview = Preview("@project-head")
outlined = Option("outline", "Outlined", "Ask Caw stays the one coral button.", true)
coral = Option("coral", "Coral too", "Both buttons in coral; two equal calls to act.")
fixed = Section("Fixed from your pins", [fixedwhy, fix1, fix2, fix3, fix4, fix5, fix6, fix7, fix8])
fixedwhy = Text("These land whichever options you pick; each is drawn in the options above.", "meta")
fix1 = Text("“what the fuck is this button supposed to be?” Spin off is gone from the head; New session opens the kit's dialog, where a spin-off is its lifetime chip.", "body")
fix2 = Text("“plain popover input… handrolling components” New session is the kit's New-session dialog, nothing hand-made.", "body")
fix3 = Text("“why are you mentioning working twice” The stage is said once, on its chip.", "body")
fix4 = Text("“why is the → not lined up?” The arrow is a mark, centred on the words.", "body")
fix5 = Text("“what is this line above and below?” Both lines around the review are gone.", "body")
fix6 = Text("“ICONS IN SECTIONS MATE” Every Details heading has its glyph.", "body")
fix7 = Text("“Can't start … ugly” It is a sentence with the hub's reason, and Try again at the foot.", "body")
fix8 = Text("“ur repeating icons and titles again” The Routines block says Routines once, and its borrowed composer is gone.", "body")
