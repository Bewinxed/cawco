root = Decisions("Connect a machine, reworked", [flow, taste])
flow = Decision("flow", "Does the reworked flow read right?", [looksright, notyet], "You asked for this with “10 thousand steps and 10 thousand layout shifts and it's been stuck on this for a while” and “family benji guidelines for the rework of this machine onboarding flow”: the tray now holds one card from signing in to the join, five phases drawn instead of ten rows written, and the card keeps its box through all ten step lines at 512 and at 390.", [flowmedia])
flowmedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["SigningIn", "SigningInPhone", "Installing", "InstallingPhone", "Joined", "JoinedPhone", "Failed", "FailedPhone"])
looksright = Option("looks-right", "Looks right", "The build lands as drawn: one card, five phases, nothing moving while it runs.", true, [], "The ten step rows and the log move behind Show steps and Show output, closed by default; a failure's way back is Change target.")
notyet = Option("not-yet", "Not yet", "Say what reads wrong in a note and the next round answers it.", false, [], "The rework waits on another round before it lands.")
taste = Section("Three taste choices", [password, done, names])
password = Decision("password", "Where does the password live on the form?", [behindline, alwaysshown, whenrefused], "The designer's pick: a person whose machine already trusts the hub's key never sees a field they must decide to leave empty, and nobody needs a failed attempt to find it.", [], ["flow"])
behindline = Option("behind-a-line", "Behind one line", "The form is the target and its port; Sign in with a password opens today's field and hint.", true, [behindlinemedia], "A password user presses one line before typing.")
behindlinemedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["BehindALine", "BehindALineOpen", "BehindALinePhone"])
alwaysshown = Option("always-shown", "Always shown", "Simplest: the field stands on the form, as today.", false, [alwaysshownmedia], "The form's one focus is split three ways before anyone has typed.", true)
alwaysshownmedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["AlwaysShown", "AlwaysShownPhone"])
whenrefused = Option("when-refused", "Asked when refused", "Purest Family: the form never mentions a password; the card asks once sign-in is refused.", false, [whenrefusedmedia], "Every password user waits 2 to 5 seconds for a failed attempt first.")
whenrefusedmedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["WhenRefused", "WhenRefusedAsked", "WhenRefusedPhone"])
done = Decision("done-moment", "How does the join land?", [barcaw, baralone, intolist], "The designer's pick: one drawn result plus the product's own character, nothing new invented, the whole moment under one second (the bar at 260ms, the check at 420ms, Caw and the ways on at 520ms).", [], ["flow"])
barcaw = Option("bar-and-caw", "One bar and Caw", "The rail closes into one done bar and Caw's done loop plays once beside the name.", true, [barcawmedia], "Caw's done file loads with the result, once per join.")
barcawmedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["BarAndCaw", "BarAndCawPhone"])
baralone = Option("bar-alone", "The bar alone", "Quieter: the rail closes into one done bar, no Caw.", false, [baralonemedia], "The moment reads as a status change, not an occasion.")
baralonemedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["BarAlone", "BarAlonePhone"])
intolist = Option("into-the-list", "Into the machines list", "The strongest sense of where it went: the joined row flies out of the closing tray into the list.", false, [intolistmedia], "It only works when the list is on screen, and it moves the emphasis to Close rather than to the join.")
intolistmedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["IntoTheList", "IntoTheListPhone"])
names = Decision("phase-names", "Do the five phase names stand under the rail on the desk?", [named, railalone], "The designer's pick: five words place “Checking for systemd” in the add without opening Show steps; the phone keeps the rail alone either way, its sentence naming the phase.", [], ["flow"])
named = Option("named", "Named", "Sign in, Fetch, Install, Join, Service under their segments, the current one in strong ink.", true, [namedmedia], "One more meta line under the rail while it runs.")
namedmedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["Named", "NamedFetching"])
railalone = Option("rail-alone", "The rail alone", "Cleaner: the five segments stand alone, as on the phone.", false, [railalonemedia], "A 4px bar with no names asks the person to trust it.")
railalonemedia = Preview("632cffbe-48fe-4120-9cda-ef2b37c2e7da", null, ["RailAlone", "RailAloneFetching"])
