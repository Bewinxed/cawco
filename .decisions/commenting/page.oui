root = Decisions("Commenting: seven picks before the build", [settled, picks])
settled = Section("Pick 1: what's settled", [decided])
picks = Section("Picks 2 to 7", [threadplace, marker, delivery, composer, attachalone, rowmark])
decided = Decision("decided", "Pick 1: everything around the other six picks is settled. Does it read right?", [reads, change], "Comments opens a rail beside the page, newest first, with search and Open and Resolved; a comment can stand on the whole page; a click writes nothing until you type, so Esc or a click outside leaves no pin and sends nothing; and a comment carries pictures and files. Attach, paste or drop them in the composer, each uploads as it's attached, and the thread shows them under the words.", [decidedmedia], [], false, "what to change")
decidedmedia = Column([railshot, wholeshot, emptyshot, attachshot, attachthreadshot])
railshot = Image("decided-rail.png", "The Comments rail beside the routine form: search, Open 3 and Resolved 12, three comments newest first, each in three lines: the element's name with its age, the words, then what came back, the unread reply in the strong ink.", "The rail: search, newest first, Open and Resolved")
wholeshot = Image("decided-whole-page.png", "The routine form in Comment mode with the page's root outlined dashed and tagged Whole page, and comment 13's marker in the well's top-right corner.", "A comment on the whole page")
emptyshot = Image("decided-empty.png", "Two frames of the page: pressed on What each run does with a hollow pin and an empty composer whose Comment is off, then the same page after Esc or a click outside, with no pin left.", "Nothing typed, nothing saved")
attachshot = Image("decided-attach.png", "Three composers, each the chat composer with its target chip and Comment: a picture and a file attached as chips, the file showing its size; a file still uploading, its ring filling; and a file that couldn't upload, saying so, with the line over the composer that blocks Comment until you try again or remove it.", "Attach, uploading, and a failed upload")
attachthreadshot = Image("decided-attach-thread.png", "A comment's thread in the rail: your words with the picture as a 48px thumb and the file beside it, then the agent's reply, each with its age; at the foot the chat composer as the reply.", "A thread shows what a comment carries")
reads = Option("reads", "Reads right", "These parts are built as drawn.", true, [], "Changing them later reopens the build.")
change = Option("change", "Change something", "Say what in the note, before the build starts.", false, [], "The build waits for your note.")
threadplace = Decision("threadplace", "Where does a comment's thread open?", [threadrail, threadcard], "In the rail the whole page stays in view and the thread has one way to close; beside its pin near an edge, the card flips over the page it's about, as drawn here.", [], [], false, "what you'd change")
threadrail = Option("rail", "In the rail", "The list swaps to the thread and the page stays uncovered; the pin is ringed and its element outlined.", true, [threadrailmedia], "The thread isn't next to its pin.")
threadrailmedia = Column([threadrailpanel, threadrailclose])
threadrailpanel = Image("p1-rail-panel.png", "The panel with the rail showing comment 14's thread beside the page; pin 14 on Create routine is ringed and Create routine is outlined.")
threadrailclose = Image("p1-rail-thread.png", "The rail's thread up close: Back, the 14 marker and Create routine, Resolve and more; the chain with 3 of 12; your turn with its picture and file, and the agent's reply, each with its age; the reply composer.")
threadcard = Option("card", "Beside its pin", "A card stands next to the pin, closed only by Close or Esc.", false, [threadcardmedia], "It covers the page, it's 280px wide, and it's a second surface to keep clear.")
threadcardmedia = Column([threadcardpanel, threadcardclose])
threadcardpanel = Image("p1-card-panel.png", "The panel with comment 14's thread as a card beside its pin on Create routine; near the edge it has flipped left, over the page under the form.")
threadcardclose = Image("p1-card-thread.png", "The card up close: the 14 marker and Create routine, Resolve, more and Close; the chain; your turn with its picture and file, and the agent's reply, each with its age; the reply composer.")
marker = Decision("marker", "What shape is a comment's marker on the page?", [markertail, markerstem], "The tail-corner pill points at the exact spot and holds three digits at 20px tall; the stem version stands 28px tall and its stems cross the page in a stack.", [], [], false, "what you'd change")
markertail = Option("tail", "Tail-corner pill", "Reads as a comment, its square corner on the spot, and 7, 42 and 108 all fit 20px tall.", true, [markertailmedia], "Near an edge the tail moves to another corner.")
markertailmedia = Column([markertailpanel, markertailclose])
markertailpanel = Image("p2-tail-panel.png", "The routine form with tail-corner pills: 103 on Name, turned to the left at the form's edge, 98 on What each run does, three stacked on When, 7 on At and 108 on Create routine.")
markertailclose = Image("p2-tail-close.png", "Tail-corner pills up close at one, two and three digits, three on one spot, and one at the well's edge with its tail on the right corner.")
markerstem = Option("stem", "Round pill on a stem", "The same shape everywhere, with a dot on the spot.", false, [markerstemmedia], "It stands 28px tall, the stem crosses the words under it, and a stack is busy.")
markerstemmedia = Column([markerstempanel, markerstemclose])
markerstempanel = Image("p2-stem-panel.png", "The routine form with round pills on stems: 103 on Name, slid in at the form's edge, 98 on What each run does, three stacked on When, 7 on At and 108 on Create routine.")
markerstemclose = Image("p2-stem-close.png", "Round pills on stems up close at one, two and three digits, three on one spot with their stems crossed, and one slid in at the well's edge.")
delivery = Decision("delivery", "When does the agent hear a comment?", [deliverysend, deliveryquiet], "Sent together, six comments are one turn with your note; sent one by one, the agent starts changing the page while you're still reviewing it.", [], [], false, "what you'd change")
deliverysend = Option("send", "When you press Send", "Comments wait hollow and marked Unsent, Send counts them, and one press sends them all with a note.", true, [deliverysendmedia], "One more press, and a comment you forget waits.")
deliverysendmedia = Column([deliverysendbefore, deliverysendafter])
deliverysendbefore = Image("p3-send-unsent.png", "Before Send: hollow pins 13 and 14, each row marked Unsent, Send 3 in the head and at the rail's foot with a note field.", "Before Send")
deliverysendafter = Image("p3-send-sent.png", "After Send: the pins filled, no Unsent rows, and no Send in the head or the rail.", "After Send")
deliveryquiet = Option("quiet", "As you write, after a pause", "Each comment goes on its own a moment after you stop typing, and its pin fills once it's sent.", false, [deliveryquietmedia], "The agent edits mid-review, six comments make six turns, and there's no place for a note.", true)
deliveryquietmedia = Column([deliveryquietbefore, deliveryquietafter])
deliveryquietbefore = Image("p3-quiet-unsent.png", "Just written: comment 14 hollow and marked Unsent, the others filled; no Send anywhere.", "Just written")
deliveryquietafter = Image("p3-quiet-sent.png", "A moment later: comment 14 filled, the agent's live dot on it.", "A moment later")
composer = Decision("composer", "Where do you type a new comment?", [composerelement, composerrail], "At the element your eye stays where you clicked and the rail can stay shut; every reference we looked at opens it there.", [], [], false, "what you'd change")
composerelement = Option("element", "At the element", "A small card opens beside the hollow pin, and Comment stays off until you type.", true, [composerelementmedia], "It sits over the page next to the element.")
composerelementmedia = Column([composerelementempty, composerelementtyped])
composerelementempty = Image("p4-element-empty.png", "The What each run does field outlined with a hollow pin on it, and beside the pin the composer: the field's chip, an empty field, Attach, and Comment off.", "Nothing typed")
composerelementtyped = Image("p4-element-typed.png", "The same composer with a comment typed and Comment on.", "Typed")
composerrail = Option("rail", "In the rail's foot", "Nothing floats over the page.", false, [composerrailmedia], "Your eye travels from the element to the rail, and the rail has to be open to comment.")
composerrailmedia = Column([composerrailempty, composerrailtyped])
composerrailempty = Image("p4-rail-empty.png", "The What each run does field outlined with a hollow pin, and the composer at the foot of the Comments rail: the field's chip, an empty field, Attach, and Comment off.", "Nothing typed")
composerrailtyped = Image("p4-rail-typed.png", "The rail's composer with a comment typed and Comment on.", "Typed")
attachalone = Decision("attachalone", "Can a comment be just a picture?", [attachwords, attachonly], "A screenshot is often the whole comment. With no words, the agent hears \"I attached: ref.png\" and no \"I wrote\".", [], [], false, "what you'd change")
attachwords = Option("words", "Words required", "Comment stays off until there's a sentence, so the agent always gets one with the picture.", false, [attachwordsmedia], "A screenshot that says it all still needs a sentence typed.")
attachwordsmedia = Image("p6-words.png", "Two composers: a picture attached and no words, Comment off; then a sentence typed beside the same picture, Comment on.", "A sentence before it sends")
attachonly = Option("alone", "Attachments alone send", "A picture or file can go with no words, as the chat composer allows; its row says the picture's name.", true, [attachonlymedia], "The agent gets a picture with no sentence of what to change.")
attachonlymedia = Image("p6-alone.png", "A composer with a picture attached and no words, Comment on; beside it the rail, where the newest row's words are the picture's name, ref.png.", "A picture on its own sends")
rowmark = Decision("rowmark", "How does a row show attachments?", [markcount, markstrip], "How a row says its comment carries something, before you open the thread.", [], [], false, "what you'd change")
markcount = Option("count", "A count beside the age", "\"⎘ 2\" stands before the row's age, at the end of its first line, only when there's something attached.", true, [markcountmedia], "You don't see what's attached until you open the thread.")
markcountmedia = Image("p7-count.png", "The rail with three rows: comment 14's first line ends with a paperclip, 2 and its age, comment 13's with a paperclip, 5 and its age, comment 12's with its age alone.", "A paperclip and a count")
markstrip = Option("strip", "A thumb strip", "Up to four 20px thumbs under the words, then +N.", false, [markstripmedia], "Each row with attachments grows a line, so fewer rows fit.")
markstripmedia = Image("p7-strip.png", "The rail with rows growing a line of 20px thumbs under the words: comment 14's picture and file, comment 13's four pictures and +1.", "Thumbs under the words")
